[
  {
    "label": "调试 uix-demo (GUI)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/demo/target/debug/uix-demo",
    "build": {
      "command": "cargo",
      "args": ["build", "--manifest-path", "demo/Cargo.toml", "--bin", "uix-demo"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "info"
    },
    "sourceLanguages": ["rust"]
  },
