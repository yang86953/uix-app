<Module name="PortableWorkbench" version="2" schema="1">
  <Data name="Document" fields="content: String, version: Int" />
  <Data name="Receipt" fields="accepted: Bool, version: Int, status: String" />
  <State name="draft" type="String" value={''} />
  <State name="base" type="Int" value={0} />
  <State name="edits" type="Int" value={0} />
  <State name="status" type="String" value={'尚未读取合成文档'} />
  <Port name="documents_read" returns="Document" effect="query" async="true" />
  <Port name="documents_commit" params="expected: Int, content: String" returns="Receipt" effect="command" />
  <Function name="transform" params="text: String" returns="String" body="text.toUpperCase().words().join(' | ')" export="true" />
  <AsyncCommand name="read" returns="String" body="do {
    setState(status: '异步读取中');
    let document = await documents_read();
    setState(draft: document.content, base: document.version, status: '已读取 v' + document.version.toString());
    return draft;
  }" />
  <Command name="edit" params="text: String" returns="Unit" body="do { setState(draft: text, status: '草稿未提交'); }" />
  <Command name="process" returns="String" body="do {
    setState(draft: transform(draft), edits: edits + 1, status: '已大写并分隔');
    return draft;
  }" />
  <Command name="commit" returns="Bool" body="do {
    let receipt = documents_commit(base, draft);
    if receipt.accepted { setState(base: receipt.version, status: receipt.status); }
    else { setState(status: receipt.status); }
    return receipt.accepted;
  }" />
  <View>
    <Column key="workbench" padding={16} gap={12}>
      <Text key="title" text="外部模块 v2 · 大写分隔" />
      <Input key="editor" value={draft} placeholder="仅合成文本，不读取真实文档" onChange={edit($event.value)} />
      <Row key="actions" gap={8}>
        <Button key="read" text="异步读取" onClick={read()} />
        <Button key="process" text="大写并分隔" onClick={process()} />
        <Button key="commit" text="按版本提交" onClick={commit()} disabled={base == 0} />
      </Row>
      <Text key="preview" text={draft} />
      <Text key="version" text={'草稿基于 v' + base.toString() + ' · 已处理 ' + edits.toString() + ' 次'} />
      <Text key="status" text={status} />
    </Column>
  </View>
</Module>
