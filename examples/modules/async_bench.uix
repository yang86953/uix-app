<Module name="AsyncBench" version="1" schema="1">
  <State name="phase" type="String" value={'idle'} />
  <State name="draft" type="String" value={'initial'} />
  <Port name="read" params="text: String" returns="String" effect="query" async="true" />
  <Port name="commit" params="text: String" returns="Result<Bool,String>" effect="command" async="true" />
  <Query name="current" returns="String" body="draft" />
  <Command name="edit" params="text: String" returns="Unit" body="do { setState(draft: text); }" />
  <AsyncCommand name="process" params="text: String" returns="String"
    body="do {
      setState(phase: 'reading');
      let normalized = await read(text);
      if normalized.len() > 0 {
        setState(draft: normalized);
        let saved = await commit(normalized);
        if saved.isOk() { setState(phase: 'done'); return draft; }
        else { setState(phase: 'declined'); return 'declined'; }
      } else { setState(phase: 'empty'); return ''; }
    }" />
  <AsyncCommand name="early" params="skip: Bool" returns="String"
    body="do { if skip { return 'skipped'; } let result = await read('early'); return result; }" />
  <AsyncCommand name="waitOnly" returns="Unit" body="do { let ignored = await read('unit'); }" />
  <AsyncCommand name="failAfterRead" returns="Int"
    body="do { setState(phase: 'reading'); let value = await read('failure'); setState(draft: value, phase: 'tentative'); return 1 / 0; }" />
  <View><Column key="root">
    <Input key="input" value={draft} onChange={edit($event.value)} />
    <Button key="process" text="异步处理" onClick={process(draft)} />
    <Text key="phase" text={phase} />
  </Column></View>
</Module>
