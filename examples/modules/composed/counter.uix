<Module name="CounterLibrary" version="1" schema="1">
  <Import from="./text.uix" as="text" version="1" />
  <Data name="Stats" fields="text: String, count: Int" export="true" />
  <State name="count" type="Int" value={0} />
  <State name="saved" type="String" value="" />
  <Port name="audit" params="message: String" returns="Unit" effect="command" />
  <Port name="read" returns="String" effect="query" async="true" />
  <Command name="step" params="input: String" returns="Stats" body="do { setState(count: count + 1); return text.analyze(input); }" />
  <Query name="current" returns="Int" body="count" />
  <Function name="divide" params="divisor: Int" returns="Int" export="true" body="100 / divisor" />
  <Command name="record" returns="Unit" body="audit(count.toString())" />
  <AsyncCommand name="fetch" returns="String" body="do { let loaded = await read(); setState(saved: loaded); return saved; }" />
</Module>
