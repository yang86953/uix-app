<Module name="TextBench" version="1.0.0" schema="1">
  <Data name="Statistics" fields="characters: Int, words: Int, normalized: String" />
  <State name="draft" type="String" value={''} />
  <State name="edits" type="Int" value={0} />
  <Port name="documents_read" params="id: String" returns="String" effect="query" />
  <Port name="documents_commit" params="id: String, content: String" returns="Bool" effect="command" />
  <Function name="normalize" params="text: String" returns="String"
    body="text.words().join(' ')" />
  <Function name="statistics" params="text: String" returns="Statistics" export="true"
    body="{characters: text.len(), words: text.words().len(), normalized: normalize(text)}" />
  <Command name="read" params="id: String" returns="String"
    body="do { let text = documents_read(id); setState(draft: text); return text; }" />
  <Command name="process" params="text: String" returns="Statistics"
    body="do { let result = statistics(text); setState(draft: result.normalized, edits: edits + 1); return result; }" />
  <Command name="commit" params="id: String" returns="Bool"
    body="documents_commit(id, draft)" />
  <Query name="current" returns="String" body="draft" />
  <Command name="edit" params="text: String" returns="Unit" body="do { setState(draft: text); }" />
  <View>
    <Column key="bench" padding={16} gap={12}>
      <Text key="title" text="UIX 文本工作台" />
      <Input key="editor" value={draft} placeholder="输入待处理文本" onChange={edit($event.value)} />
      <Row key="actions">
        <Button key="read" text="读取文档" onClick={read('doc-1')} />
        <Button key="process" text="规范空白" onClick={process(draft)} />
        <Button key="commit" text="提交文档" onClick={commit('doc-1')} disabled={draft.len() == 0} />
      </Row>
      <Text key="preview" text={draft} />
      <Text key="statistics" text={'字符 ' + draft.len().toString() + ' · 词数 ' + draft.words().len().toString()} />
    </Column>
  </View>
</Module>
