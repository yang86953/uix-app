// 声明验收页面使用的面板样式。
acceptancePanel {
  // 为折叠内容动画与焦点环保留观察空间。
  padding: 32px;
  // 使用白色背景核对边框和内容区域。
  backgroundColor: #FFFFFF;
  // 使用浅色边框标记页面边界。
  borderWidth: 1px;
  // 使用中性边框颜色。
  borderColor: #D9D9D9;
  // 使用统一圆角。
  borderRadius: 10px;
}

// 声明稳定 key 受控的 Collapse 验收面板。
<Widget name="CollapseAcceptance" state="active_keys: Vec<String> = []">
  // 纵向排列说明、受控折叠组与核对清单。
  <Column gap="20px">
    // 展示验收标题。
    <Text fontSize="heading2">Collapse 真窗视觉验收</Text>
    // 说明同名标题通过显式 key 分离身份。
    <Text>三个面板由稳定 key 受控；手风琴模式下用户每次操作最多展开一个面板。</Text>
    // 使用完整 UIX 映射构造受控折叠组。
    <Collapse panels={[CollapsePanel('基础设置', '配置项目名称、主题与默认页面。').key('basic'), CollapsePanel('高级设置', '配置缓存、并发与调试选项。').key('advanced'), CollapsePanel('高级设置', '同名标题使用独立 key，核对身份不会串联。').key('advanced-secondary')]} accordion activeKeys={active_keys} @change="record_panel($event)" width="420px" height="260px" automationId="collapse" />
    // 展示人工或自动截图核对清单。
    <Text>核对：初始全部折叠；点击任一标题只展开对应内容；同名高级面板互不串联；Up/Down/Home/End 移动焦点，Enter/Space 切换且旧内容无残影。</Text>
  // 结束验收内容。
  </Column>
// 结束验收面板组件。
</Widget>

// 声明独立真窗应用入口。
<App title="UIX Collapse 视觉验收" size="820x560" theme="light">
  // 使用固定验收面板承载全部样例。
  <Container class="acceptancePanel">
    // 挂载带稳定 key 集合状态的验收组件。
    <CollapseAcceptance />
  // 结束页面面板。
  </Container>
// 结束应用入口。
</App>
