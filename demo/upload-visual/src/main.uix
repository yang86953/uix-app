// 声明验收页面使用的面板样式。
acceptancePanel {
  // 为拖放边界、列表与焦点环保留观察空间。
  padding: 32px;
  // 使用白色背景核对边框和状态颜色。
  backgroundColor: #FFFFFF;
  // 使用浅色边框标记页面边界。
  borderWidth: 1px;
  // 使用中性边框颜色。
  borderColor: #D9D9D9;
  // 使用统一圆角。
  borderRadius: 10px;
}

// 声明独立真窗应用入口。
<App title="UIX Upload 视觉验收" size="860x680" theme="light">
  // 使用固定验收面板承载全部样例。
  <Container class="acceptancePanel">
    // 纵向排列说明、受控上传队列与核对清单。
    <Column gap="20px">
      // 展示验收标题。
      <Text fontSize="heading2">Upload 真窗视觉验收</Text>
      // 说明受控队列与传输所有权。
      <Text>队列由调用方 State 唯一持有；组件只处理拖放、删除和类型化队列变化，不启动网络传输。</Text>
      // 使用完整 UIX 映射展示四种文件状态。
      <Upload files={upload_files()} accept=".png,*.jpg" multiple maxCount="8" maxSize="10485760" drag @change="record_upload($event)" width="480px" height="300px" automationId="upload" />
      // 展示人工或自动截图核对清单。
      <Text>核对：拖放区边框、图标和说明完整；Pending / Uploading / Done / Error 状态图标可区分；58% 进度条不溢出；逗号文件名不影响删除；点击删除后列表收缩且无残影。</Text>
    // 结束验收内容。
    </Column>
  // 结束页面面板。
  </Container>
// 结束应用入口。
</App>
