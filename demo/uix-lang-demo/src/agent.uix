// 后台演示单独声明 UI 状态，不导入主窗口终端、AppHandle 或原生标题栏。
<Widget name="AgentWorkspaceDemo" state="page: 0, draft: 'AI private draft', saved: ''">
  // 本操作面的导航和草稿完全属于后台组件树。
  <Column padding="24px" gap="16px" flexGrow={1} style="backgroundColor: #F5F7FA;">
    <Text fontSize="heading2" automationId="agent-title">UIX · Independent agent workspace</Text>
    <Text>Private navigation, draft, selection and clipboard. No desktop window.</Text>
    <Container direction="row" gap="12px">
      <Button @click="setState(page: 0)" automationId="agent-nav-editor">Editor</Button>
      <Button @click="setState(page: 1)" automationId="agent-nav-result">Result</Button>
    </Container>
    // 输入页保留私有草稿；显式提交只写本演示的领域结果。
    <If {page == 0}>
      <Input value={draft} width="480px" automationId="agent-draft" />
      <Button type="primary" @click="setState(saved: draft)" automationId="agent-save">Submit draft</Button>
    </If>
    // 切换页面不影响用户的主演示导航或输入。
    <If {page == 1}>
      <Text automationId="agent-result">Submitted: {saved}</Text>
    </If>
    // 原主演示的确认策略在后台仍生效，宿主默认拒绝，不弹前台确认框。
    <Button @click="setState(saved: 'confirmed')" automationId="demo-popconfirm-trigger">Request protected operation</Button>
  </Column>
</Widget>

<AgentWorkspaceDemo />
