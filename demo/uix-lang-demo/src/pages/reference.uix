// 显式公开本文件的主演示页面组件。
@export('FrameworkPage', 'GalleryPage')

<Widget name="FrameworkPage">
  // 组织框架能力内容。
  <Column gap="16px">
    // 展示框架能力标题。
    <Text fontSize="heading2">框架能力</Text>
    // 展示窗口框架面板。
    <Container class="pagePanel">
      // 组织窗口框架内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">窗口框架 / 拖拽区域</Text>
        // 排列窗口控件。
        <Container direction="row" gap="12px" align="center">
          // 展示窗口最小化、最大化与关闭控件。
          <WindowControl showMinimize showMaximize showClose />
          // 展示主题切换控件。
          <ThemeToggle />
        // 结束窗口控件行。
        </Container>
        // 展示可拖拽区域。
        <WindowDragRegion height="40px" backgroundColor="#F0F0F0">
          // 展示拖拽区域说明。
          <Container height="40px" align="center" justify="center"><Text>WindowDragRegion — 可拖拽区域</Text></Container>
        // 结束可拖拽区域。
        </WindowDragRegion>
      // 结束窗口框架内容。
      </Column>
    // 结束窗口框架面板。
    </Container>
    // 展示样式系统面板。
    <Container class="accentPanel">
      // 组织样式系统内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">样式类继承与内联覆盖</Text>
        // 说明当前面板样式来源。
        <Text>本面板使用 accentPanel（extends pagePanel + 左侧强调线）。</Text>
        // 展示内联样式覆盖样式类。
        <Container class="pagePanel" style="padding: 24px; borderColor: #1677FF; borderWidth: 2px;">
          // 说明内联样式优先级。
          <Text>内联 style 优先于样式类：padding 24px + 蓝色边框。</Text>
        // 结束内联覆盖容器。
        </Container>
      // 结束样式系统内容。
      </Column>
    // 结束样式系统面板。
    </Container>
    // 展示编译期生成面板。
    <Container class="pagePanel">
      // 组织编译期内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">编译期生成</Text>
        // 展示编译期生成说明。
        <Alert message="uix! 在编译期生成公开 ViewNode，不引入运行时解释器。" type="success" />
        // 展示语言能力标签行。
        <Container direction="row" gap="8px">
          // 标记自动化标识能力。
          <Tag color="success">automationId</Tag>
          // 标记稳定身份能力。
          <Tag color="success">key</Tag>
          // 标记受控状态能力。
          <Tag color="info">受控状态</Tag>
          // 标记状态更新能力。
          <Tag color="info">setState</Tag>
          // 标记主题切换能力。
          <Tag color="warning">setTheme</Tag>
        // 结束语言能力标签行。
        </Container>
        // 说明生命周期所有权。
        <Text>窗口创建、主题跟随、诊断与事件循环仍由 src/main.rs 的 App 组合根持有。</Text>
      // 结束编译期内容。
      </Column>
    // 结束编译期生成面板。
    </Container>
    // 说明 Provider 边界。
    <Alert message="LocaleProvider、ConfigProvider、WidgetOverrides 保留 Rust API 边界。" type="info" />
  // 结束框架能力内容。
  </Column>
// 结束框架能力页组件。
</Widget>

// 声明覆盖清单页组件。
<Widget name="GalleryPage">
  // 组织覆盖清单内容。
  <Column gap="16px">
    // 展示覆盖清单标题。
    <Text fontSize="heading2">覆盖清单</Text>
    // 展示覆盖清单面板。
    <Container class="pagePanel">
      // 组织覆盖清单内容。
      <Column gap="8px">
        // 展示已对齐结构小节。
        <Text fontSize="heading5">已对齐结构</Text>
        // 说明结构对齐范围。
        <Text>窗口尺寸 1200×800、自定义标题栏、分组侧栏、页头、滚动内容区、状态栏与 12 个公开入口。</Text>
        // 展示已覆盖标签小节。
        <Text fontSize="heading5">已覆盖标签</Text>
        // 说明通用标签覆盖。
        <Text>通用：Button / ButtonGroup / FloatButton / FloatButtonBackTop / Icon / Divider / Space / Typography / Tag / Text / Label</Text>
        // 说明布局标签覆盖。
        <Text>布局：Container / Row / Col / Grid / ScrollView / VirtualScroll / Splitter / Affix / BackTop / FloatButtonBackTop / Layout / Sider / Header / Content / Footer</Text>
        // 说明输入标签覆盖。
        <Text>输入：Input / InputNumber / InputGroup / Slider / RangeSlider / Rate / Checkbox / Switch / Radio / Segmented / Select / Cascader / TreeSelect / AutoComplete / Mentions / DatePicker / DateRangePicker / TimePicker / ColorPicker / Upload / Form 全字段</Text>
        // 说明数据展示标签覆盖。
        <Text>数据展示：Card / List / SelectableList / Collapse / Badge / Skeleton / Empty / ResultView / Descriptions / Timeline / Calendar / Carousel / Tree / Terminal / Table / Avatar / Image / ImageGroup / RichText</Text>
        // 说明反馈标签覆盖。
        <Text>反馈：Message / Notification / Alert / Modal / Drawer / Tooltip / Popover / Popconfirm / FocusTrap / ProgressBar / Spin</Text>
        // 说明导航与框架标签覆盖。
        <Text>导航与框架：Menu / MenuBar / Dropdown / Navigation / Steps / Pagination / Breadcrumb / Anchor / Tabs / ThemeToggle / WindowControl / WindowDragRegion / QRCode / Watermark</Text>
        // 说明 Rust 图表文档列出的十二类标签均已覆盖。
        <Text>图表：十二类 Rust 图表标签均已登记类型化静态数据与基础视觉配置。</Text>
        // 展示语言能力小节。
        <Text fontSize="heading5">语言能力</Text>
        // 说明组件与状态能力。
        <Text>组件：props / 私有 state / 类型化 state（u32、usize、f32、i32、Date、Time、Color、Point、CascaderValue、HashSet、Option、Vec、UploadFile）/ setState / 句柄位绑定 / If / For / 样式类继承 / setTheme。</Text>
        // 说明数据声明能力。
        <Text>数据：数组字面量 / 数据类型构造链（含 SelectableItem、CollapsePanel、SelectOption、TreeNode、TerminalLine、TimelineItem、Step、MenuItem、DropdownItem、BarData、LineData、PieData、Date、Time、Color、Point）/ Record 类型化业务模型。</Text>
        // 展示保留边界小节。
        <Text fontSize="heading5">保留边界</Text>
        // 说明保留在 Rust API 的边界。
        <Text>气泡、多系列、高级图表配置、其余图表标签，以及 Agent 控制与 test-harness 专用入口。</Text>
        // 展示验收状态标签。
        <Container direction="row" gap="8px">
          // 标记结构对齐状态。
          <Tag color="success">结构已对齐</Tag>
          // 标记编译边界状态。
          <Tag color="success">编译期生成</Tag>
          // 标记待验收状态。
          <Tag color="warning">待视觉验收</Tag>
        // 结束验收状态行。
        </Container>
      // 结束覆盖清单内容。
      </Column>
    // 结束覆盖清单面板。
    </Container>
  // 结束覆盖清单内容。
  </Column>
// 结束覆盖清单页组件。
</Widget>

// 提供页面文档独立解析所需的唯一根。
<Text>主演示页面组件库</Text>
