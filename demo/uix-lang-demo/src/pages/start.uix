// 显式公开本文件的主演示页面组件。
@export('HomePage', 'RuntimePage')

<Widget name="HomePage" props="page: State<number>, count: State<number>" state="likes: 0">
  // 组织首页内容。
  <Column gap="16px">
    // 展示首页主卡片与统一演示标题。
    <Container class="accentPanel" direction="row" gap="10px" align="center">
      // 展示全景图标。
      <Icon name="star" size="18px" />
      // 展示首页主标题。
      <Text fontSize="heading2">UIX 组件全景</Text>
      // 标记演示版本。
      <Tag color="info">Demo</Tag>
    // 结束首页主卡片。
    </Container>
    // 说明声明式版本的对齐目标。
    <Text>此界面由 src/main.uix 在编译期生成，页面结构与 API GUI Demo 对齐。</Text>
    // 展示窗口级共享状态卡片。
    <Card title="响应式 State（窗口级共享）">
      // 组织计数器内容。
      <Column gap="10px">
        // 显示窗口级共享计数。
        <Text>计数: {count}</Text>
        // 使用横向容器排列计数器操作。
        <Container direction="row" gap="8px">
          // 通过声明式事件递增共享状态。
          <Button type="primary" @click="setState(count: count + 1)" automationId="home-count-increment">+1</Button>
          // 通过三元表达式实现不减到负数。
          <Button @click="setState(count: count > 0 ? count - 1 : 0)" automationId="home-count-decrement">-1</Button>
          // 重置共享计数。
          <Button type="ghost" @click="setState(count: 0)" automationId="home-count-reset">重置</Button>
        // 结束计数器操作行。
        </Container>
      // 结束计数器内容。
      </Column>
    // 结束共享状态卡片。
    </Card>
    // 展示组件私有状态卡片。
    <Card title="组件私有状态（state 声明）">
      // 组织点赞内容。
      <Column gap="10px">
        // 显示组件私有点赞数。
        <Text>点赞数: {likes}</Text>
        // 通过 setState 更新私有状态。
        <Button @click="setState(likes: likes + 1)">点赞 +1</Button>
      // 结束点赞内容。
      </Column>
    // 结束私有状态卡片。
    </Card>
    // 展示覆盖与快捷导航卡片。
    <Container direction="row" gap="12px">
      // 展示覆盖范围卡片。
      <Card title="覆盖范围" width="220px">
        // 组织覆盖统计内容。
        <Column gap="8px">
          // 展示演示页总数。
          <Text fontSize="heading1">12</Text>
          // 说明页面数量单位。
          <Text>个演示页</Text>
          // 展示能力标签行。
          <Container direction="row" gap="6px">
            // 标记组件能力。
            <Tag color="success">组件</Tag>
            // 标记运行时能力。
            <Tag color="info">运行时</Tag>
            // 标记主题能力。
            <Tag color="warning">主题</Tag>
          // 结束能力标签行。
          </Container>
        // 结束覆盖统计内容。
        </Column>
      // 结束覆盖范围卡片。
      </Card>
      // 展示快捷导航卡片。
      <Card title="快捷导航" width="220px">
        // 组织导航按钮。
        <Column gap="6px">
          // 跳转语言能力页。
          <Button @click="setState(page: 1)">语言能力</Button>
          // 跳转通用组件页。
          <Button @click="setState(page: 2)">通用组件</Button>
          // 跳转覆盖清单页。
          <Button @click="setState(page: 11)">覆盖清单</Button>
        // 结束导航按钮。
        </Column>
      // 结束快捷导航卡片。
      </Card>
    // 结束首页卡片行。
    </Container>
    // 展示可用性提示。
    <Alert message="左侧导航可切换 12 个公开演示页面。" type="success" />
  // 结束首页内容。
  </Column>
// 结束首页组件。
</Widget>

// 声明脚本化计数组件：使用块级成员声明与多语句 action 的等价新语法。
<Widget name="ScriptedCounter">
  // 块级 props：递进步长带默认值。
  @props {
    step: number = 1,
  }
  // 块级 state：计数值与上限。
  @state {
    value: 0,
    limit: 5,
  }
  // 块级 computed：按声明顺序派生剩余余量。
  @computed {
    remaining: limit - value,
  }
  // 块级 actions：单表达式与 do 多语句主体并存。
  @actions {
    reset: setState(value: 0),
    stepUp: do {
      let next = value + step;
      if next > limit {
        setState(value: limit);
        return;
      }
      setState(value: next);
    },
  }
  // 组织脚本化计数内容。
  <Column gap="8px">
    // 显示当前值、上限与 computed 余量。
    <Text automationId="script-counter-status">步进值 {value} / 上限 {limit} · 剩余 {remaining}</Text>
    // 排列脚本操作按钮。
    <Container direction="row" gap="8px">
      // 触发 do 块 action：局部计算、上限短路返回与状态提交。
      <Button type="primary" automationId="script-counter-step-up" @click="stepUp()">do 块步进 {step}</Button>
      // 触发单表达式 action 重置。
      <Button automationId="script-counter-reset" @click="reset()">重置</Button>
    // 结束脚本操作行。
    </Container>
  // 结束脚本化计数内容。
  </Column>
// 结束脚本化计数组件。
</Widget>

// 声明语言能力组件：全部状态、操作与主题切换都由 uix-lang 表达。
<Widget name="RuntimePage" state="count: 0">
  // 组织语言能力内容。
  <Column gap="16px">
    // 展示语言能力标题。
    <Text fontSize="heading2">uix-lang 语言能力</Text>
    // 展示编译期应用入口卡片。
    <Card title="AOT App — uix_app!">
      // 组织编译入口说明。
      <Column gap="8px">
        // 显示当前文档的真实生成入口。
        <Text>src/main.uix 在编译期生成完整 App 与 View 树。</Text>
        // 说明 Rust 组合根只持有语言边界之外的生命周期。
        <Text fontSize="small">Rust 薄入口只负责进程参数、字体、平台线程和最终 run()。</Text>
      // 结束编译入口说明。
      </Column>
    // 结束编译期应用入口卡片。
    </Card>
    // 展示响应式 State 卡片。
    <Card title="响应式 State / setState">
      // 组织计数内容。
      <Column gap="10px">
        // 显示窗口级计数。
        <Text>本地计数: {count}</Text>
        // 排列计数操作。
        <Container direction="row" gap="8px">
          // 递增计数。
          <Button type="primary" @click="setState(count: count + 1)">+1</Button>
          // 递减计数。
          <Button @click="setState(count: count > 0 ? count - 1 : 0)">-1</Button>
        // 结束计数操作。
        </Container>
      // 结束计数内容。
      </Column>
    // 结束响应式 State 卡片。
    </Card>
    // 展示主题卡片。
    <Card title="Theme">
      // 组织主题内容。
      <Column gap="8px">
        // 排列主题操作。
        <Container direction="row" gap="12px" align="center">
          // 通过语言内置操作切换暗色主题。
          <Button automationId="theme-dark" @click="setTheme('dark')">暗色主题</Button>
          // 通过语言内置操作切换亮色主题。
          <Button automationId="theme-light" @click="setTheme('light')">亮色主题</Button>
          // 复用标题栏主题切换组件。
          <ThemeToggle />
        // 结束主题操作。
        </Container>
        // 显示语言内置主题操作状态说明。
        <Text automationId="runtime-theme-state">setTheme 与 ThemeToggle 均由 uix-lang 生成。</Text>
        // 说明主题所有权的真实调用路径。
        <Text fontSize="small">语言事件只请求主题切换，Application System 继续拥有实际主题生命周期。</Text>
        // 直接演示组件私有动态 class、布局更新与离开恢复。
        <StyleAction />
        // 说明 setStyle 不依赖调用方同名函数或运行时字符串注册表。
        <Text fontSize="small">setStyle 由编译器生成闭合 Style 分支；悬停替换当前 View 的动态 class，离开时恢复原始 class，内联 style 始终保持作者覆盖优先级。</Text>
        // 演示状态伪类自动选择与差异字段叠加。
        <PseudoStateAction />
        // 说明伪类与 setStyle 的职责边界。
        <Text fontSize="small">:hover 自动维护指针事实，:disabled / :checked 复用元素同名状态；变体只叠加声明字段。setStyle 继续用于自定义动态 class 切换。</Text>
        // 省略 label 调用参数，真实覆盖默认 prop、条件链、事件字段与扩展状态类型。
        <PhaseFiveAction />
        // 说明阶段五能力全部由编译期转换器验证。
        <Text fontSize="small">阶段 5 演示同时覆盖 If/ElseIf/Else 短路链、keyDown code 载荷、prop 默认值、非空 Vec 与 Some 初始值。</Text>
      // 结束主题内容。
      </Column>
    // 结束主题卡片。
    </Card>
    // 展示同步 action 与内置操作边界。
    <Card title="同步 Action — 语言面局部交互">
      // 组织语言事件与可观察状态。
      <Column gap="10px">
        // 用语言事件更新当前 Widget 的私有状态。
        <Button type="primary" automationId="runtime-language-action" @click="setState(count: count + 1)">执行语言 Action</Button>
        // 显示语言状态更新结果。
        <Text automationId="runtime-language-status">Action 已执行 {count} 次</Text>
        // 说明语言只拥有局部界面交互。
        <Text fontSize="small">setState 只更新当前组件的界面状态，不取得服务、窗口或平台资源。</Text>
        // 实例化块级成员与 do 多语句 action 演示组件。
        <ScriptedCounter />
        // 说明块级成员与 do 块能力均由编译期转换器静态内联。
        <Text fontSize="small">@props/@state/@computed/@actions 块级声明与字符串属性形式解析等价；do 块支持 let、赋值、条件与 return，事件位置仍为纯 AOT 内联。</Text>
        // 展示正负 spread 与多段阴影的内联样式。
        <Container direction="row" gap="16px" align="center">
          // 正向 spread 向外扩张的柔和投影。
          <Container width="72px" height="40px" backgroundColor="#FFFFFF" style="boxShadow: 2px 2px 6px 1px rgba(0,0,0,0.15);" />
          // 负向 spread 与负偏移组合的细边环效果。
          <Container width="72px" height="40px" backgroundColor="#FFFFFF" style="boxShadow: -4px 4px 8px -1px rgba(22,119,255,0.35);" />
          // 说明阴影语法扩展范围。
          <Text fontSize="small">boxShadow 支持可选第五段 spread：正值向外扩张、负值向内收缩，可多段叠加。</Text>
        // 结束阴影演示行。
        </Container>
      // 结束同步 action 内容。
      </Column>
    // 结束同步 action 卡片。
    </Card>
    // 展示 PicturePolicy 与自定义组件边界。
    <Alert message="业务规则、I/O 与应用生命周期保留 Rust API 边界；演示界面完全由 uix-lang 声明。" type="info" />
    // 展示编译期生成说明。
    <Alert message="uix! 在编译期生成公开 ViewNode，不引入运行时解释器。" type="success" />
  // 结束应用能力内容。
  </Column>
// 结束应用能力组件。
</Widget>

// 提供页面文档独立解析所需的唯一根。
<Text>主演示页面组件库</Text>
