// 显式公开本文件的主演示页面组件。
@export('HomePage', 'RuntimePage')

<Component name="HomePage" props="page: State<number>, count: State<number>" state="likes: 0">
  // 组织首页内容。
  <Column gap="16px">
    // 展示首页主卡片与统一演示标题。
    <Container class="accentPanel" direction="row" gap="10px" align="center">
      // 展示全景图标。
      <Icon name="star" size="18px" />
      // 展示首页主标题。
      <Text fontSize="heading2">UIX 组件全景</Text>
      // 标记演示版本。
      <Tag color="info">Demo</Tag>
    // 结束首页主卡片。
    </Container>
    // 说明声明式版本的对齐目标。
    <Text>此界面由 src/main.uix 在编译期生成，页面结构与 API GUI Demo 对齐。</Text>
    // 展示窗口级共享状态卡片。
    <Card title="响应式 State（窗口级共享）">
      // 组织计数器内容。
      <Column gap="10px">
        // 显示窗口级共享计数。
        <Text>计数: {count}</Text>
        // 使用横向容器排列计数器操作。
        <Container direction="row" gap="8px">
          // 通过声明式事件递增共享状态。
          <Button type="primary" @click="setState(count: count + 1)" automationId="home-count-increment">+1</Button>
          // 通过三元表达式实现不减到负数。
          <Button @click="setState(count: count > 0 ? count - 1 : 0)" automationId="home-count-decrement">-1</Button>
          // 重置共享计数。
          <Button type="ghost" @click="setState(count: 0)" automationId="home-count-reset">重置</Button>
        // 结束计数器操作行。
        </Container>
      // 结束计数器内容。
      </Column>
    // 结束共享状态卡片。
    </Card>
    // 展示组件私有状态卡片。
    <Card title="组件私有状态（state 声明）">
      // 组织点赞内容。
      <Column gap="10px">
        // 显示组件私有点赞数。
        <Text>点赞数: {likes}</Text>
        // 通过 setState 更新私有状态。
        <Button @click="setState(likes: likes + 1)">点赞 +1</Button>
      // 结束点赞内容。
      </Column>
    // 结束私有状态卡片。
    </Card>
    // 展示覆盖与快捷导航卡片。
    <Container direction="row" gap="12px">
      // 展示覆盖范围卡片。
      <Card title="覆盖范围" width="220px">
        // 组织覆盖统计内容。
        <Column gap="8px">
          // 展示演示页总数。
          <Text fontSize="heading1">12</Text>
          // 说明页面数量单位。
          <Text>个演示页</Text>
          // 展示能力标签行。
          <Container direction="row" gap="6px">
            // 标记组件能力。
            <Tag color="success">组件</Tag>
            // 标记运行时能力。
            <Tag color="info">运行时</Tag>
            // 标记主题能力。
            <Tag color="warning">主题</Tag>
          // 结束能力标签行。
          </Container>
        // 结束覆盖统计内容。
        </Column>
      // 结束覆盖范围卡片。
      </Card>
      // 展示快捷导航卡片。
      <Card title="快捷导航" width="220px">
        // 组织导航按钮。
        <Column gap="6px">
          // 跳转应用能力页。
          <Button @click="setState(page: 1)">应用能力</Button>
          // 跳转通用组件页。
          <Button @click="setState(page: 2)">通用组件</Button>
          // 跳转覆盖清单页。
          <Button @click="setState(page: 11)">覆盖清单</Button>
        // 结束导航按钮。
        </Column>
      // 结束快捷导航卡片。
      </Card>
    // 结束首页卡片行。
    </Container>
    // 展示可用性提示。
    <Alert message="左侧导航可切换 12 个公开演示页面。" type="success" />
  // 结束首页内容。
  </Column>
// 结束首页组件。
</Component>

// 声明应用能力组件：展示 App Timer、响应式状态、多窗口与应用主题。
<Component name="RuntimePage" props="tick: State<number>, count: State<number>, theme_status: State<String>, multi_window_status: State<String>, set_dark_theme: (), set_light_theme: (), open_theme_window: ()">
  // 组织应用能力内容。
  <Column gap="16px">
    // 展示应用能力标题。
    <Text fontSize="heading2">应用能力</Text>
    // 展示 App Timer 卡片。
    <Card title="App Timer — run_interval">
      // 组织计时器内容。
      <Column gap="8px">
        // 显示每秒递增的全局 tick。
        <Text>全局 tick: {tick}（每秒 +1）</Text>
        // 说明计时器由 Rust 组合根注册。
        <Text fontSize="small">src/main.rs 的 App.on_start 注册 1s run_interval 更新共享 tick 状态。</Text>
      // 结束计时器内容。
      </Column>
    // 结束 App Timer 卡片。
    </Card>
    // 展示响应式 State 卡片。
    <Card title="响应式 State / setState">
      // 组织计数内容。
      <Column gap="10px">
        // 显示窗口级计数。
        <Text>本地计数: {count}</Text>
        // 排列计数操作。
        <Container direction="row" gap="8px">
          // 递增计数。
          <Button type="primary" @click="setState(count: count + 1)">+1</Button>
          // 递减计数。
          <Button @click="setState(count: count > 0 ? count - 1 : 0)">-1</Button>
        // 结束计数操作。
        </Container>
      // 结束计数内容。
      </Column>
    // 结束响应式 State 卡片。
    </Card>
    // 展示主题卡片。
    <Card title="Theme">
      // 组织主题内容。
      <Column gap="8px">
        // 排列主题操作。
        <Container direction="row" gap="12px" align="center">
          // 通过 Rust 组合根的公开 AppHandle 广播暗色主题。
          <Button automationId="theme-dark" @click="set_dark_theme()">暗色主题</Button>
          // 通过 Rust 组合根的公开 AppHandle 广播亮色主题。
          <Button automationId="theme-light" @click="set_light_theme()">亮色主题</Button>
          // 复用标题栏主题切换组件。
          <ThemeToggle />
        // 结束主题操作。
        </Container>
        // 显示所有窗口共享的应用主题状态。
        <Text automationId="runtime-theme-state">{theme_status}</Text>
        // 说明主题所有权的真实调用路径。
        <Text fontSize="small">主窗与子窗都经公开 AppHandle.set_theme 更新应用主题；逐窗 View 只消费同一主题事实。</Text>
        // 直接演示组件私有动态 class、布局更新与离开恢复。
        <StyleAction />
        // 说明 setStyle 不依赖调用方同名函数或运行时字符串注册表。
        <Text fontSize="small">setStyle 由编译器生成闭合 Style 分支；悬停替换当前 View 的动态 class，离开时恢复原始 class，内联 style 始终保持作者覆盖优先级。</Text>
        // 演示状态伪类自动选择与差异字段叠加。
        <PseudoStateAction />
        // 说明伪类与 setStyle 的职责边界。
        <Text fontSize="small">:hover 自动维护指针事实，:disabled / :checked 复用元素同名状态；变体只叠加声明字段。setStyle 继续用于自定义动态 class 切换。</Text>
        // 省略 label 调用参数，真实覆盖默认 prop、条件链、事件字段与扩展状态类型。
        <PhaseFiveAction />
        // 说明阶段五能力全部由编译期转换器验证。
        <Text fontSize="small">阶段 5 演示同时覆盖 If/ElseIf/Else 短路链、keyDown code 载荷、prop 默认值、非空 Vec 与 Some 初始值。</Text>
      // 结束主题内容。
      </Column>
    // 结束主题卡片。
    </Card>
    // 展示多窗口 Rust 组合边界。
    <Card title="Multi-window — Rust 组合根">
      // 组织按需打开入口与可观察状态。
      <Column gap="10px">
        // 通过 Rust 回调请求公开 open_window。
        <Button type="primary" automationId="runtime-open-theme-window" @click="open_theme_window()">打开主题联动窗口</Button>
        // 显示窗口创建结果。
        <Text automationId="runtime-multi-window-status">{multi_window_status}</Text>
        // 说明窗口私有资源不跨窗共享。
        <Text fontSize="small">open_window 与 WindowConfig 由 Rust 组合根持有；uix-lang 只调用窄回调，不接触 WindowSession、焦点或 swapchain。</Text>
      // 结束多窗口内容。
      </Column>
    // 结束多窗口卡片。
    </Card>
    // 展示 PicturePolicy 与自定义组件边界。
    <Alert message="PicturePolicy 与 component! 自定义组件保留 Rust API 边界，不在声明文件复制运行时所有权。" type="info" />
    // 展示编译期生成说明。
    <Alert message="uix! 在编译期生成公开 ViewNode，不引入运行时解释器。" type="success" />
  // 结束应用能力内容。
  </Column>
// 结束应用能力组件。
</Component>

// 提供页面文档独立解析所需的唯一根。
<Text>主演示页面组件库</Text>
