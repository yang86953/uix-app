// 显式公开本文件的主演示页面组件。
@export('InputPage', 'DataPage', 'FeedbackPage', 'ChartsPage', 'OtherPage')

// 声明输入页独占的类型化业务模型并供主入口生成 Rust items。
<Record name="Profile" fields="email: String, level: String, accepted: bool, channel: String, notifications: bool, volume: number" />

<Component name="InputPage" external="on_name_change, submit_profile" state="input_name: 'UIX Lang', input_number: i32 = 50, grouped_amount: '12.50', slider_volume: 35, range_start: 20, range_end: 80, rating: u32 = 7, gender: 'female', view_mode: 'grid', city: 'cn', tree_key: 'member', query: 'ap', mention_text: '请联系 @a', switch_enabled: false, checkbox_accepted: true, cities: HashSet<String> = [], region: CascaderValue = { labels: [], values: [] }, selected_date: Date = Date(2026, 8, 10), range_start_date: Date = Date(2026, 8, 1), range_end_date: Date = Date(2026, 8, 31), selected_time: Time = Time(14, 30), selected_color: Color = Color('#1677ff'), profile: Profile = { email: 'owner@example.com', level: '中级', accepted: true, channel: '邮件', notifications: true, volume: 35.0 }">
  // 组织输入组件内容。
  <Column gap="16px">
    // 展示输入组件标题。
    <Text fontSize="heading2">输入组件</Text>
    // 展示文本输入面板。
    <Container class="pagePanel">
      // 组织文本输入内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Input / InputNumber / InputGroup</Text>
        // 展示双向绑定文本输入。
        <Input value={input_name} placeholder="请输入文本" type="text" @change="on_name_change($event)" width="320px" />
        // 展示密码输入。
        <Input placeholder="密码输入" type="password" width="320px" automationId="demo-password-input" />
        // 展示多行输入。
        <Input placeholder="多行输入" type="textarea" width="320px" />
        // 展示带范围与步长的类型化 i32 数字输入。
        <InputNumber value={input_number} min="0" max="100" step="5" precision="0" width="180px" />
        // 展示带前后附加文本的复合输入。
        <InputGroup addonBefore="¥" value={grouped_amount} addonAfter="元" width="200px" />
      // 结束文本输入内容。
      </Column>
    // 结束文本输入面板。
    </Container>
    // 展示滑块评分面板。
    <Container class="pagePanel">
      // 组织滑块内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Slider / RangeSlider / Rate</Text>
        // 展示单值滑块。
        <Slider value={slider_volume} min="0" max="100" step="5" width="320px" />
        // 展示双状态区间滑块。
        <RangeSlider value={{ start: range_start, end: range_end }} min="0" max="100" step="5" width="320px" />
        // 展示允许半星的类型化 u32 评分控件。
        <Rate value={rating} count="5" allowHalf />
      // 结束滑块内容。
      </Column>
    // 结束滑块评分面板。
    </Container>
    // 展示勾选输入面板。
    <Container class="pagePanel">
      // 组织勾选内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Checkbox / Switch / Radio / Segmented</Text>
        // 排列勾选控件。
        <Container direction="row" gap="12px" align="center">
          // 展示双向勾选复选框。
          <Checkbox checked={checkbox_accepted} text="同意演示协议" />
          // 展示普通复选框。
          <Checkbox text="选项 B" />
          // 展示禁用复选框。
          <Checkbox text="禁用" disabled />
          // 展示双向开关。
          <Switch checked={switch_enabled} />
          // 通过 setState 切换组件私有开关状态。
          <Button @click="setState(switch_enabled: !switch_enabled)">切换开关</Button>
        // 结束勾选控件行。
        </Container>
        // 展示双向单选组。
        <Radio value={gender} options={['female', 'male']} width="320px" />
        // 展示双向分段控制器。
        <Segmented value={view_mode} options={['grid', 'list']} width="240px" />
      // 结束勾选内容。
      </Column>
    // 结束勾选输入面板。
    </Container>
    // 展示选择器面板。
    <Container class="pagePanel">
      // 组织选择器内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Select / Cascader / TreeSelect / AutoComplete / Mentions</Text>
        // 排列单选与多选下拉，共享同一结构化选项绑定。
        <Container direction="row" gap="12px" align="center">
          // 展示可搜索单选下拉。
          <Select value={city} options={[SelectOption('中国', 'cn'), SelectOption('美国', 'us'), SelectOption('日本', 'jp')]} searchable placeholder="请选择城市" width="200px" />
          // 展示集合状态多选下拉。
          <Select value={cities} options={[SelectOption('中国', 'cn'), SelectOption('美国', 'us'), SelectOption('日本', 'jp')]} multiple width="200px" />
        // 结束下拉行。
        </Container>
        // 展示级联选择器。
        <Cascader value={region} options={[CascaderOption('浙江', 'zj').children([CascaderOption('杭州', 'hz'), CascaderOption('宁波', 'nb')]), CascaderOption('江苏', 'js').children([CascaderOption('南京', 'nj')])]} width="240px" />
        // 展示树形选择器，与展示树共享同一节点绑定。
        <TreeSelect value={tree_key} options={[TreeNode('部门', 'dept').children([TreeNode('成员', 'member'), TreeNode('访客', 'guest')]), TreeNode('项目', 'project')]} width="240px" />
        // 展示自动完成输入。
        <AutoComplete value={query} options={['apple', 'apricot', 'application']} placeholder="输入城市..." width="240px" />
        // 展示提及输入。
        <Mentions value={mention_text} suggestions={['alice', 'adam']} placeholder="输入 @ 提及" width="240px" />
      // 结束选择器内容。
      </Column>
    // 结束选择器面板。
    </Container>
    // 展示日期时间面板。
    <Container class="pagePanel">
      // 组织日期内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">DatePicker / DateRangePicker / TimePicker / ColorPicker</Text>
        // 排列日期时间控件。
        <Container direction="row" gap="12px" align="center">
          // 展示周粒度日期选择。
          <DatePicker value={selected_date} mode="week" width="200px" />
          // 展示双状态日期范围选择。
          <DateRangePicker value={{ start: range_start_date, end: range_end_date }} width="260px" />
          // 展示时间选择。
          <TimePicker value={selected_time} width="160px" />
          // 展示颜色选择。
          <ColorPicker value={selected_color} width="160px" />
        // 结束日期时间行。
        </Container>
      // 结束日期内容。
      </Column>
    // 结束日期时间面板。
    </Container>
    // 展示表单面板。
    <Container class="pagePanel">
      // 组织表单内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Form / FormItem — 类型化模型</Text>
        // 展示绑定类型化模型的全字段表单。
        <Form model={profile} @submit="submit_profile" width="480px">
          // 展示必填邮箱字段。
          <FormInputItem field="email" label="邮箱" rules="required,email" />
          // 展示可搜索等级选择字段。
          <FormSelectItem field="level" label="等级" options={['初级', '中级', '高级']} rules="required" searchable placeholder="请选择" />
          // 展示协议确认字段。
          <FormCheckboxItem field="accepted" label="协议确认" text="我已阅读并同意" rules="required" />
          // 展示通知渠道单选字段。
          <FormRadioItem field="channel" label="通知渠道" options={['邮件', '短信']} rules="required" vertical />
          // 展示通知开关字段。
          <FormSwitchItem field="notifications" label="启用通知" rules="required" />
          // 展示音量滑块字段。
          <FormSliderItem field="volume" label="音量" min="0" max="100" step="5" />
          // 展示表单提交按钮。
          <Button type="primary" @click="submitForm">提交</Button>
        // 结束类型化表单。
        </Form>
      // 结束表单内容。
      </Column>
    // 结束表单面板。
    </Container>
  // 结束输入组件内容。
  </Column>
// 结束输入组件页组件。
</Component>

// 声明数据展示页组件并持有稳定选中、展开状态与有序派生值。
<Component name="DataPage" external="on_gallery_change" state="selected_item: Option<String> = None, active_panels: Vec<String> = []" computed="visible_panels: active_panels.filter(|key| key.length > 0), remaining: visible_panels.length">
  // 组织数据展示内容。
  <Column gap="16px">
    // 展示数据组件标题。
    <Text fontSize="heading2">数据展示</Text>
    // 展示选择、折叠与徽标组件面板。
    <Container class="pagePanel">
      // 组织三个新登记数据展示组件。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">SelectableList / Collapse / Badge</Text>
        // 使用稳定 id 与可空状态驱动可选中列表。
        <SelectableList items={[SelectableItem('overview', '总览'), SelectableItem('details', '详情'), SelectableItem('history', '历史记录')]} active={selected_item} width="320px" height="150px" automationId="demo-selectable-list" />
        // 使用稳定 key 集合驱动手风琴折叠面板。
        <Collapse panels={[CollapsePanel('基础信息', '展示公开字段与状态。').key('basic'), CollapsePanel('高级信息', '展示稳定 key 与受控展开。').key('advanced')]} accordion activeKeys={active_panels} width="420px" automationId="demo-collapse" />
        // 展示 filter 与后续 computed 依次求值得到的有效展开数量。
        <Text fontSize="small">筛选后仍有 {remaining} 个展开面板。</Text>
        // 排列数字、圆点与文字徽标。
        <Container direction="row" gap="18px" align="center">
          // 用数字徽标装饰真实业务按钮。
          <Badge count="5"><Button>通知</Button></Badge>
          // 用圆点徽标装饰真实头像。
          <Badge dot><Avatar text="UI" /></Badge>
          // 展示零子节点文字徽标。
          <Badge text="NEW" automationId="demo-badge" />
        // 结束徽标行。
        </Container>
      // 结束选择、折叠与徽标内容。
      </Column>
    // 结束选择、折叠与徽标面板。
    </Container>
    // 展示卡片列表面板。
    <Container class="pagePanel">
      // 组织卡片列表内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Card / List / Descriptions</Text>
        // 展示带操作项的卡片。
        <Card title="卡片" actions={['编辑', '删除']} width="320px">
          // 说明卡片承载能力。
          <Text>Card 可承载异质有序子树。</Text>
        // 结束操作卡片。
        </Card>
        // 展示带头尾文本的数据列表。
        <List data={['视觉基线', '语义断言', '交互回归']} header="用户列表" footer="共 3 人" loadMore="加载更多" width="320px" />
        // 展示三列描述列表。
        <Descriptions data={[DescriptionsItem('姓名', 'Ada'), DescriptionsItem('角色', '管理员'), DescriptionsItem('邮箱', 'ada@ex.com')]} columns="2" width="480px" />
      // 结束卡片列表内容。
      </Column>
    // 结束卡片列表面板。
    </Container>
    // 展示时间轴面板。
    <Container class="pagePanel">
      // 组织时间轴内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Timeline / Tree / Carousel</Text>
        // 展示带 pending 与 reverse 的时间轴。
        <Timeline items={[TimelineItem('创建').description('2026-08-01'), TimelineItem('设计').description('2026-08-05'), TimelineItem('上线').description('2026-08-10')]} pending reverse />
        // 展示可勾选默认展开的树。
        <Tree data={[TreeNode('部门', 'dept').children([TreeNode('成员', 'member'), TreeNode('访客', 'guest')]), TreeNode('项目', 'project')]} checkable defaultExpandAll width="320px" />
        // 展示自动播放轮播器。
        <Carousel autoplay height="120px" width="320px">
          // 展示第一张幻灯片。
          <Container backgroundColor="#E6F4FF" align="center" justify="center"><Text>幻灯片 1</Text></Container>
          // 展示第二张幻灯片。
          <Container backgroundColor="#FFF7E6" align="center" justify="center"><Text>幻灯片 2</Text></Container>
          // 展示第三张幻灯片。
          <Container backgroundColor="#F6FFED" align="center" justify="center"><Text>幻灯片 3</Text></Container>
        // 结束轮播器。
        </Carousel>
      // 结束时间轴内容。
      </Column>
    // 结束时间轴面板。
    </Container>
    // 展示媒体面板。
    <Container class="pagePanel">
      // 组织媒体内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Avatar / Image / ImageGroup</Text>
        // 排列媒体组件。
        <Container direction="row" gap="12px" align="center">
          // 展示文字头像。
          <Avatar text="U" />
          // 展示圆形彩色头像。
          <Avatar text="A" shape="circle" size="48px" backgroundColor="#4096FF" />
          // 展示带预览与回退文字的图片。
          <Image src="assets/images/demo.png" alt="demo" fallback="图片加载失败" width="120px" height="84px" radius="8px" preview />
          // 展示带变化事件的图片组。
          <ImageGroup images={['assets/images/demo.png', 'assets/images/demo.png']} startIndex="0" @change="on_gallery_change($event)" width="280px" />
        // 结束媒体组件行。
        </Container>
      // 结束媒体内容。
      </Column>
    // 结束媒体面板。
    </Container>
    // 展示状态组件面板。
    <Container class="pagePanel">
      // 组织状态组件内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Skeleton / Empty / ResultView / Calendar / RichText</Text>
        // 排列骨架屏形状。
        <Container direction="row" gap="12px" align="center">
          // 展示矩形骨架。
          <Skeleton shape="rect" width="240px" height="16px" />
          // 展示圆形骨架。
          <Skeleton shape="circle" width="48px" height="48px" />
          // 展示文本骨架。
          <Skeleton shape="text" width="120px" height="16px" />
        // 结束骨架屏行。
        </Container>
        // 展示空状态。
        <Empty description="暂无数据" icon="inbox" width="240px" />
        // 排列结果状态。
        <Container direction="row" gap="16px">
          // 展示成功结果。
          <ResultView status="success" title="数据加载完成" extraText="重新加载" width="200px" />
          // 展示失败结果。
          <ResultView status="error" title="加载失败" width="200px" />
        // 结束结果状态行。
        </Container>
        // 展示月视图日历。
        <Calendar width="300px" />
        // 展示可选中 Markdown 富文本。
        <RichText content="**RichText** 与 `QRCode` 均由已注册标签生成。" selectable width="320px" />
      // 结束状态组件内容。
      </Column>
    // 结束状态组件面板。
    </Container>
    // 说明数据展示标签已完成声明式覆盖。
    <Alert message="Table、SelectableList、Collapse 与 Badge 均由 uix-lang 生成并复用公开受控状态契约。" type="success" />
  // 结束数据展示内容。
  </Column>
// 结束数据展示页组件。
</Component>

// 声明反馈组件页组件：受控浮层与确认计数由组件私有 state 驱动。
<Component name="FeedbackPage" external="on_alert_closed" state="feedback_open: false, drawer_open: false, confirm_count: 0, cancel_count: 0">
  // 组织反馈组件内容。
  <Column gap="16px">
    // 展示反馈组件标题。
    <Text fontSize="heading2">反馈组件</Text>
    // 展示警告提示面板。
    <Container class="pagePanel">
      // 组织警告内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Alert — 4 种类型</Text>
        // 展示成功提示。
        <Alert message="成功: 操作已完成" type="success" />
        // 展示信息提示。
        <Alert message="信息: 提示" type="info" />
        // 展示可关闭警告。
        <Alert message="警告: 请注意" type="warning" closable />
        // 展示带关闭事件的错误提示。
        <Alert message="错误: 失败" type="error" closable @close="on_alert_closed($event)" />
      // 结束警告内容。
      </Column>
    // 结束警告提示面板。
    </Container>
    // 展示 keyed 消息、通知与确认气泡面板。
    <Container class="pagePanel">
      // 组织声明式反馈租约与确认交互。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Message / Notification / Popconfirm</Text>
        // 声明不会自动超时的可关闭成功消息。
        <Message key="demo-message" type="success" content="主演示 Message 已由 uix-lang 声明" duration="0" closable automationId="demo-message" />
        // 声明不会自动超时的可关闭通知。
        <Notification key="demo-notification" type="info" title="声明式通知" content="逐窗 overlay host 持有稳定 keyed 租约" duration="0" closable automationId="demo-notification" />
        // 展示确认与取消结果计数。
        <Text>确认 {confirm_count} 次 · 取消 {cancel_count} 次</Text>
        // 使用真实按钮作为确认气泡唯一 trigger。
        <Popconfirm title="确认执行主演示操作？" confirmText="确认" cancelText="取消" placement="bottom" automationId="demo-popconfirm" @confirm="setState(confirm_count: confirm_count + 1)" @cancel="setState(cancel_count: cancel_count + 1)">
          // 保留业务按钮自己的布局与交互身份。
          <Button type="primary" automationId="demo-popconfirm-trigger">打开 Popconfirm</Button>
        // 结束确认气泡。
        </Popconfirm>
      // 结束声明式反馈内容。
      </Column>
    // 结束声明式反馈面板。
    </Container>
    // 展示浮层面板。
    <Container class="pagePanel">
      // 组织浮层内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Modal / Drawer（组件私有受控状态）</Text>
        // 排列浮层入口。
        <Container direction="row" gap="12px" align="center">
          // 通过 setState 打开反馈模态。
          <Button type="primary" @click="setState(feedback_open: true)">打开 Modal</Button>
          // 通过 setState 打开抽屉。
          <Button @click="setState(drawer_open: true)">打开 Drawer</Button>
        // 结束浮层入口行。
        </Container>
        // 展示由私有 State<bool> 控制的模态框。
        <Modal open={feedback_open} title="系统键盘焦点陷阱" maskClosable footerVisible @ok="setState(feedback_open: false)" @cancel="setState(feedback_open: false)" width="480px">
          // 排列模态操作按钮。
          <Container direction="row" gap="8px">
            // 展示模态取消按钮。
            <Button @click="setState(feedback_open: false)">取消</Button>
            // 展示模态确认按钮。
            <Button type="primary" @click="setState(feedback_open: false)">确认</Button>
          // 结束模态操作行。
        // 结束受控模态框。
        </Container>
        </Modal>
        // 展示右侧受控抽屉。
        <Drawer open={drawer_open} placement="right" width="300px">
          // 组织抽屉内容。
          <Column gap="12px">
            // 说明抽屉内容来源。
            <Text>抽屉内容来自 uix-lang 声明。</Text>
            // 展示关闭抽屉按钮。
            <Button @click="setState(drawer_open: false)">关闭抽屉</Button>
          // 结束抽屉内容。
          </Column>
        // 结束受控抽屉。
        </Drawer>
      // 结束浮层内容。
      </Column>
    // 结束浮层面板。
    </Container>
    // 展示悬浮交互面板。
    <Container class="pagePanel">
      // 组织悬浮内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Tooltip / Popover / FocusTrap</Text>
        // 排列悬浮组件。
        <Container direction="row" gap="12px" align="center">
          // 展示默认悬停文字提示。
          <Tooltip text="来自 uix-lang 的提示"><Button>悬停查看 Tooltip</Button></Tooltip>
          // 展示点击触发气泡卡片。
          <Popover content="气泡内容" trigger="click"><Button>点击查看 Popover</Button></Popover>
        // 结束悬浮组件行。
        </Container>
        // 展示焦点陷阱作用域。
        <FocusTrap>
          // 排列焦点陷阱内按钮。
          <Container direction="row" gap="8px">
            // 展示焦点陷阱取消按钮。
            <Button>取消</Button>
            // 展示焦点陷阱确认按钮。
            <Button type="primary">确认</Button>
          // 结束焦点陷阱按钮行。
          </Container>
        // 结束焦点陷阱作用域。
        </FocusTrap>
      // 结束悬浮内容。
      </Column>
    // 结束悬浮交互面板。
    </Container>
    // 展示加载反馈面板。
    <Container class="pagePanel">
      // 组织加载内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">ProgressBar / Spin — 进度与加载</Text>
        // 展示确定模式的线形 fraction。
        <ProgressBar progress="0.65" type="line" width="320px" />
        // 展示保留确定 fraction 的圆形不确定模式。
        <ProgressBar progress="0.65" indeterminate type="circle" width="72px" height="72px" />
        // 展示带遮罩子树的加载指示器。
        <Spin spinning text="正在加载" width="320px">
          // 展示被遮罩的卡片。
          <Card title="加载内容"><Text>Spin 遮罩子树。</Text></Card>
        // 结束遮罩子树。
        </Spin>
      // 结束加载内容。
      </Column>
    // 结束加载反馈面板。
    </Container>
    // 说明反馈标签已完成声明式覆盖。
    <Alert message="Message、Notification 与 Popconfirm 已进入主演示并复用逐窗反馈 owner。" type="success" />
  // 结束反馈组件内容。
  </Column>
// 结束反馈组件页组件。
</Component>

// 声明图表能力页组件。
<Component name="ChartsPage">
  // 组织图表能力内容。
  <Column gap="16px">
    // 展示图表能力标题。
    <Text fontSize="heading2">图表</Text>
    // 明确当前声明式标签边界。
    <Alert message="charts 能力已与 API Demo 一致启用（Bar / Line / Pie / Area / Radar / Heatmap / Gauge 等），但图表标签尚未注册到 uix-lang。" type="warning" />
    // 说明当前可用调用路径。
    <Card title="当前边界"><Text>图表继续通过 Rust API 构造；待标签契约登记后再迁入声明文件。</Text></Card>
  // 结束图表能力内容。
  </Column>
// 结束图表能力页组件。
</Component>

// 声明其他组件页组件并持有上传队列唯一状态。
<Component name="OtherPage" state="upload_files: Vec<UploadFile> = []">
  // 组织其他组件内容。
  <Column gap="16px">
    // 展示其他组件标题。
    <Text fontSize="heading2">其他组件</Text>
    // 展示受控上传组件面板。
    <Container class="pagePanel">
      // 组织上传拖放区与边界说明。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Upload — 受控文件队列</Text>
        // 绑定组件私有文件状态并启用扩展名、数量与大小门禁。
        <Upload files={upload_files} accept=".png,*.jpg" multiple maxCount="8" maxSize="10485760" drag width="480px" height="240px" automationId="demo-upload" />
        // 说明上传运行时所有权边界。
        <Text fontSize="small">Upload 只拥有拖放与列表瞬态状态；文件队列由 UploadFile 的 Vec 状态唯一持有。</Text>
      // 结束上传内容。
      </Column>
    // 结束上传面板。
    </Container>
    // 展示媒体组件面板。
    <Container class="pagePanel">
      // 组织媒体内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">QRCode / Watermark / RichText</Text>
        // 排列媒体组件。
        <Container direction="row" gap="24px" align="center">
          // 展示二维码。
          <QRCode value="https://github.com/yanghaku/uix" size="128px" errorLevel="M" />
          // 展示平铺水印。
          <Watermark text="UIX LANG" opacity="0.18" width="320px" />
        // 结束媒体组件行。
        </Container>
        // 展示可选中富文本。
        <RichText content="**Markdown** 富文本与 `代码` 内联样式。" selectable width="320px" />
      // 结束媒体内容。
      </Column>
    // 结束媒体组件面板。
    </Container>
    // 展示语义色面板。
    <Container class="pagePanel">
      // 组织语义色内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">DesignTokens — 语义色</Text>
        // 排列语义色块。
        <Container direction="row" gap="8px">
          // 展示主色块。
          <Container width="72px" height="28px" backgroundColor="#1677FF" />
          // 展示成功色块。
          <Container width="72px" height="28px" backgroundColor="#52C41A" />
          // 展示警告色块。
          <Container width="72px" height="28px" backgroundColor="#FAAD14" />
          // 展示错误色块。
          <Container width="72px" height="28px" backgroundColor="#FF4D4F" />
          // 展示信息色块。
          <Container width="72px" height="28px" backgroundColor="#13C2C2" />
        // 结束语义色块行。
        </Container>
        // 说明语义色映射路径。
        <Text fontSize="small">六类语义色由声明式 backgroundColor 直接映射公开 ColorValue。</Text>
      // 结束语义色内容。
      </Column>
    // 结束语义色面板。
    </Container>
    // 说明仅剩的输入迁移边界。
    <Alert message="Upload 已由 uix-lang 生成；Transfer 仍保留 Rust API 边界。" type="info" />
  // 结束其他组件内容。
  </Column>
// 结束其他组件页组件。
</Component>

// 提供页面文档独立解析所需的唯一根。
<Text>主演示页面组件库</Text>
