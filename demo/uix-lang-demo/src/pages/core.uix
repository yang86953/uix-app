// 显式公开本文件的主演示页面组件。
@export('GeneralPage', 'LayoutPage', 'NavPage')

<Widget name="GeneralPage">
  // 组织通用组件内容。
  <Column gap="16px">
    // 展示通用组件标题。
    <Text fontSize="heading2">通用组件</Text>
    // 展示排版层级面板。
    <Container class="pagePanel">
      // 组织排版内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Typography — 标题层级</Text>
        // 展示与 Text 共享公开运行时的 Label 别名。
        <Label>Label — 可选择的通用文本</Label>
        // 展示一级标题。
        <Typography level="1">Heading 1 — 一级标题</Typography>
        // 展示二级标题。
        <Typography level="2">Heading 2 — 二级标题</Typography>
        // 展示三级标题。
        <Typography level="3">Heading 3 — 三级标题</Typography>
        // 展示次要文本。
        <Typography type="secondary">Secondary 次要文本</Typography>
        // 展示成功文本。
        <Typography type="success">Success 成功文本</Typography>
        // 展示警告文本。
        <Typography type="warning">Warning 警告文本</Typography>
        // 展示危险文本。
        <Typography type="danger">Danger 危险文本</Typography>
        // 展示标记、下划线与复制能力。
        <Typography mark underline copyable>标记 + 下划线 + 复制</Typography>
      // 结束排版内容。
      </Column>
    // 结束排版层级面板。
    </Container>
    // 展示按钮预设面板。
    <Container class="pagePanel">
      // 组织按钮内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Button — StyleSet 预设</Text>
        // 排列按钮预设。
        <Container direction="row" gap="8px">
          // 展示主要操作按钮。
          <Button type="primary">主要操作</Button>
          // 展示默认按钮。
          <Button>默认按钮</Button>
          // 展示幽灵按钮。
          <Button type="ghost">幽灵按钮</Button>
          // 展示危险按钮。
          <Button type="danger">危险按钮</Button>
          // 展示禁用按钮。
          <Button disabled>禁用按钮</Button>
          // 展示块级按钮。
          <Button block>块级按钮</Button>
        // 结束按钮预设行。
        </Container>
        // 展示按钮组连体组合。
        <ButtonGroup>
          // 展示连体左侧按钮。
          <Button type="primary">左</Button>
          // 展示连体中间按钮。
          <Button>中</Button>
          // 展示连体右侧按钮。
          <Button type="ghost">右</Button>
        // 结束按钮组。
        </ButtonGroup>
      // 结束按钮内容。
      </Column>
    // 结束按钮预设面板。
    </Container>
    // 展示标签、图标与分割线面板。
    <Container class="pagePanel">
      // 组织标签内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Tag / Icon / Divider</Text>
        // 排列语义色标签。
        <Container direction="row" gap="8px" align="center">
          // 展示默认标签。
          <Tag>Default</Tag>
          // 展示成功标签。
          <Tag color="success">Success</Tag>
          // 展示警告标签。
          <Tag color="warning">Warning</Tag>
          // 展示错误标签。
          <Tag color="error">Error</Tag>
          // 展示信息标签。
          <Tag color="info">Info</Tag>
          // 展示自定义色标签。
          <Tag color="#1677FF">自定义色</Tag>
          // 展示可关闭可勾选标签。
          <Tag color="success" closable checkable>已完成</Tag>
        // 结束语义色标签行。
        </Container>
        // 排列 Lucide 图标集。
        <Container direction="row" gap="12px" align="center">
          // 展示搜索图标。
          <Icon name="search" size="20px" />
          // 展示主页图标。
          <Icon name="home" size="20px" />
          // 展示设置图标。
          <Icon name="settings" size="20px" />
          // 展示用户图标。
          <Icon name="user" size="20px" />
          // 展示铃铛图标。
          <Icon name="bell" size="20px" />
          // 展示星标图标。
          <Icon name="star" size="20px" />
          // 展示爱心图标。
          <Icon name="heart" size="20px" />
          // 展示编辑图标。
          <Icon name="edit" size="20px" />
        // 结束图标行。
        </Container>
        // 展示带文字水平分割线。
        <Divider text="居中文字" />
        // 展示虚线分割线。
        <Divider dashed />
        // 展示垂直分割线行。
        <Container direction="row" gap="12px" align="center" height="32px">
          // 展示左侧文字。
          <Text>左</Text>
          // 展示垂直分割线。
          <Divider direction="vertical" />
          // 展示中间文字。
          <Text>中</Text>
          // 展示垂直分割线。
          <Divider direction="vertical" />
          // 展示右侧文字。
          <Text>右</Text>
        // 结束垂直分割线行。
        </Container>
      // 结束标签内容。
      </Column>
    // 结束标签、图标与分割线面板。
    </Container>
    // 展示间距与浮动按钮面板。
    <Container class="pagePanel">
      // 组织间距内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Space / FloatButton</Text>
        // 展示自定义间距行。
        <Space direction="horizontal" gap="8px">
          // 展示甲按钮。
          <Button>甲</Button>
          // 展示乙按钮。
          <Button>乙</Button>
          // 展示丙按钮。
          <Button>丙</Button>
        // 结束自定义间距行。
        </Space>
        // 排列浮动按钮。
        <Container direction="row" gap="24px" height="56px">
          // 展示左上角浮动按钮。
          <FloatButton icon="plus" description="新建" tooltip="新建项目" position="leftTop" />
          // 展示带徽标反馈浮动按钮。
          <FloatButton icon="message-circle" tooltip="反馈" badge={{ count: 7, dot: false }} />
        // 结束浮动按钮行。
        </Container>
        // 展示只接收稳定直接子按钮的浮动按钮组。
        <FloatButtonGroup trigger="click" automationId="demo-float-button-group">
          // 展示组内编辑按钮。
          <FloatButton icon="edit" tooltip="编辑" />
          // 展示组内分享按钮。
          <FloatButton icon="share-2" tooltip="分享" />
        // 结束浮动按钮组。
        </FloatButtonGroup>
      // 结束间距内容。
      </Column>
    // 结束间距与浮动按钮面板。
    </Container>
  // 结束通用组件内容。
  </Column>
// 结束通用组件页组件。
</Widget>

// 声明布局组件页组件：持有滚动位置与虚拟列表示例数据。
<Widget name="LayoutPage" state="scroll_y: f32 = 180, scroll_point: Point = Point(0.0, 0.0), virtual_items: Vec<String> = ['惰性行 1', '惰性行 2', '惰性行 3', '惰性行 4', '惰性行 5', '惰性行 6']">
  // 组织布局组件内容。
  <Column gap="16px">
    // 展示布局组件标题。
    <Text fontSize="heading2">布局组件</Text>
    // 展示 Flex 容器面板。
    <Container class="pagePanel">
      // 组织 Flex 内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Container — Flex Row / Column</Text>
        // 展示两端分布的横向 Flex。
        <Container direction="row" gap="12px" align="center" justify="spaceBetween" padding="12px" backgroundColor="#F0F0F0" height="72px">
