          <Container width="80px" height="28px" backgroundColor="#4096FF" align="center" justify="center"><Text> A </Text></Container>
          // 展示 B 色块。
          <Container width="80px" height="28px" backgroundColor="#52C41A" align="center" justify="center"><Text> B </Text></Container>
          // 展示 C 色块。
          <Container width="80px" height="28px" backgroundColor="#FAAD14" align="center" justify="center"><Text> C </Text></Container>
          // 展示 D 色块。
          <Container width="80px" height="28px" backgroundColor="#722ED1" align="center" justify="center"><Text> D </Text></Container>
        // 结束横向 Flex。
        </Container>
        // 展示居中的纵向 Flex。
        <Container direction="column" gap="8px" align="center" padding="12px" backgroundColor="#F0F0F0" height="120px">
          // 展示第一纵向色块。
          <Container width="80px" height="28px" backgroundColor="#4096FF" align="center" justify="center"><Text> 壹 </Text></Container>
          // 展示第二纵向色块。
          <Container width="80px" height="28px" backgroundColor="#52C41A" align="center" justify="center"><Text> 贰 </Text></Container>
          // 展示第三纵向色块。
          <Container width="80px" height="28px" backgroundColor="#FAAD14" align="center" justify="center"><Text> 叁 </Text></Container>
        // 结束纵向 Flex。
        </Container>
      // 结束 Flex 内容。
      </Column>
    // 结束 Flex 容器面板。
    </Container>
    // 展示栅格面板。
    <Container class="pagePanel">
      // 组织栅格内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Row / Col — 24 栅格</Text>
        // 展示两列等分栅格。
        <Row gap="12px">
          // 展示左侧 12 栅格。
          <Col span={12}><Card title="12 / 24"><Text>响应式 Col</Text></Card></Col>
          // 展示右侧 12 栅格。
          <Col span={12}><Card title="12 / 24"><Text>sm / md / lg 断点重排</Text></Card></Col>
        // 结束两列等分栅格。
        </Row>
        // 展示四列响应式栅格。
        <Row gap="12px">
          // 展示第一响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>按 logical 宽度切换</Text></Card></Col>
          // 展示第二响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>resize 自动重排</Text></Card></Col>
          // 展示第三响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>编译期 span 常量</Text></Card></Col>
          // 展示第四响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>与 API Demo 共用布局</Text></Card></Col>
        // 结束四列响应式栅格。
        </Row>
        // 展示显式轨道 Grid。
        <Grid columns="1fr 200px auto" rows="auto" colGap="8px" rowGap="4px" height="96px">
          // 展示弹性轨道列。
          <Col span={1}><Container backgroundColor="#E6F4FF" height="88px" align="center" justify="center"><Text>1fr</Text></Container></Col>
          // 展示固定轨道列。
          <Col span={1}><Container backgroundColor="#FFF7E6" height="88px" align="center" justify="center"><Text>200px</Text></Container></Col>
          // 展示自动轨道列。
          <Col span={1}><Container backgroundColor="#F6FFED" height="88px" align="center" justify="center"><Text>auto</Text></Container></Col>
        // 结束显式轨道 Grid。
        </Grid>
      // 结束栅格内容。
      </Column>
    // 结束栅格面板。
    </Container>
    // 展示应用壳面板。
    <Container class="pagePanel">
      // 组织应用壳内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Layout — Header / Sider / Content / Footer</Text>
        // 展示完整应用布局壳。
        <Layout direction="row" height="160px">
          // 展示可折叠侧栏。
          <Sider collapsible width="140px" backgroundColor="#E6F4FF"><Text> Sider </Text></Sider>
          // 展示右侧嵌套布局。
          <Layout>
            // 展示页头。
            <Header height="36px" backgroundColor="#BAE0FF"><Text>Header</Text></Header>
            // 展示内容区。
            <Content flexGrow={1}><Text>Content</Text></Content>
            // 展示页脚。
            <Footer height="28px" backgroundColor="#F0F0F0"><Text>Footer</Text></Footer>
          // 结束嵌套布局。
          </Layout>
        // 结束完整应用布局壳。
        </Layout>
      // 结束应用壳内容。
      </Column>
    // 结束应用壳面板。
    </Container>
    // 展示分隔器面板。
    <Container class="pagePanel">
      // 组织分隔器内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Splitter — 水平 / 垂直</Text>
        // 展示水平双面板。
        <Splitter direction="horizontal" defaultRatio="0.3" height="140px">
          // 展示左侧面板。
          <Container backgroundColor="#E6F4FF" align="center" justify="center"><Text>左侧面板</Text></Container>
          // 展示右侧面板。
          <Container backgroundColor="#F6FFED" align="center" justify="center"><Text>右侧面板</Text></Container>
        // 结束水平双面板。
        </Splitter>
        // 展示垂直双面板。
        <Splitter direction="vertical" defaultRatio="0.5" width="320px" height="100px">
          // 展示上面板。
          <Container backgroundColor="#FFF7E6" align="center" justify="center"><Text>上面板</Text></Container>
          // 展示下面板。
          <Container backgroundColor="#F9F0FF" align="center" justify="center"><Text>下面板</Text></Container>
        // 结束垂直双面板。
        </Splitter>
      // 结束分隔器内容。
      </Column>
    // 结束分隔器面板。
    </Container>
    // 展示滚动与吸顶面板。
    <Container class="pagePanel">
      // 组织滚动内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">ScrollView / VirtualScroll / Affix / BackTop</Text>
        // 展示双向绑定滚动偏移的滚动容器。
        <ScrollView direction="vertical" offset={scroll_point} height="120px">
          // 使用纵向容器承载滚动行。
          <Column gap="4px">
            // 展示第一滚动行。
            <Text>ScrollView 行 1 — 滚轮滚动</Text>
            // 展示第二滚动行。
            <Text>ScrollView 行 2</Text>
            // 展示第三滚动行。
            <Text>ScrollView 行 3</Text>
            // 展示第四滚动行。
            <Text>ScrollView 行 4</Text>
            // 展示第五滚动行。
            <Text>ScrollView 行 5</Text>
            // 展示第六滚动行。
            <Text>ScrollView 行 6</Text>
          // 结束滚动行。
          </Column>
        // 结束滚动容器。
        </ScrollView>
        // 展示惰性行虚拟滚动。
        <VirtualScroll data={virtual_items} rowHeight="32px" item={item} height="160px">
          // 用 For 模板描述单行结构。
          <For {item} {index} in {virtual_items} key={item}>
            // 展示带稳定 key 的行容器。
            <Container direction="row" gap="8px" padding="4px">
              // 展示行索引。
              <Text>{index}</Text>
              // 展示行内容。
              <Text>{item}</Text>
            // 结束行容器。
            </Container>
          // 结束行模板。
          </For>
        // 结束虚拟滚动。
        </VirtualScroll>
        // 排列吸顶与回到顶部演示。
        <Container direction="row" gap="24px" align="center" height="48px">
          // 展示读取组件私有滚动状态的吸顶容器。
          <Affix offsetTop="12" scrollY={scroll_y}><Button type="primary">已吸顶</Button></Affix>
          // 展示读取组件私有滚动状态的回到顶部按钮。
          <FloatButtonBackTop threshold="100" scrollY={scroll_y} />
          // 展示同一状态契约下的标准 BackTop 标签。
          <BackTop threshold="120" scrollY={scroll_y} />
          // 说明状态来源。
          <Text fontSize="small">Affix / FloatButtonBackTop / BackTop 读取组件私有 scroll_y 状态（f32 = 180 模拟已滚动）</Text>
        // 结束吸顶演示行。
        </Container>
      // 结束滚动内容。
      </Column>
    // 结束滚动与吸顶面板。
    </Container>
  // 结束布局组件内容。
  </Column>
// 结束布局组件页组件。
</Widget>

// 声明导航组件页组件：持有步骤、分页、标签页、菜单与侧栏受控状态。
<Widget name="NavPage" state="steps_current: usize = 1, page_current: usize = 1, page_size: usize = 10, active_tab: 'account', menu_selected: Option<String> = None, menu_open: Vec<String> = [], nav_active: Option<String> = None, nav_open: Vec<String> = [], nav_collapsed: false, menu_bar_choice: String = ''">
  // 组织导航组件内容。
  <Column gap="16px">
    // 展示导航组件标题。
    <Text fontSize="heading2">导航组件</Text>
    // 展示横向菜单栏与稳定 key 的 Change 事实。
    <Container class="pagePanel">
      // 组织菜单栏内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">MenuBar</Text>
        // 顶级入口点击展开下拉，选择后发布条目稳定 key。
        <MenuBar menus={[MenuBarMenu('文件', 'file').item(MenuBarItem('新建任务', 'file-new-task').icon('plus')).item(MenuBarItem('新建项目', 'file-new-project').icon('folder')).item(MenuBarItem('打开工作区…', 'file-open-workspace')), MenuBarMenu('视图', 'view').item(MenuBarItem('导航页', 'view-nav').icon('compass')).item(MenuBarItem('禁用项', 'view-disabled').disabled(true))]} @change="setState(menu_bar_choice: $event.value)" automationId="demo-menu-bar" />
        // 展示最近一次菜单选择的稳定 key。
        <Text fontSize="small">最近选择：{menu_bar_choice == '' ? '（未选择）' : menu_bar_choice}</Text>
      // 结束菜单栏内容。
      </Column>
    // 结束菜单栏面板。
    </Container>
    // 展示步骤与分页面板。
    <Container class="pagePanel">
      // 组织步骤内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Steps / Pagination</Text>
        // 展示可点击的水平圆点步骤条。
        <Steps current={steps_current} items={[Step('注册'), Step('验证'), Step('完成')]} clickable dot />
        // 展示不可直接切换的垂直步骤条，同一状态仍可由外部按钮驱动。
        <Steps current={steps_current} items={[Step('注册'), Step('验证'), Step('完成')]} direction="vertical" clickable="false" />
        // 通过 setState 更新类型化 usize 步骤状态。
        <Container direction="row" gap="8px">
          // 跳回第一步。
          <Button @click="setState(steps_current: 0)">回到第 1 步</Button>
          // 跳到第三步。
          <Button @click="setState(steps_current: 2)">跳到第 3 步</Button>
        // 结束步骤操作行。
        </Container>
        // 展示含总数、尺寸切换、尺寸选项与跳转入口的双状态分页器。
        <Pagination total="120" current={page_current} pageSize={page_size} pageSizeOptions="10,20,50" showTotal showSizeChanger showJumper />
        // 展示隐藏总数的非受控紧凑分页器。
        <Pagination total="120" simple showTotal="false" />
      // 结束步骤内容。
      </Column>
    // 结束步骤与分页面板。
    </Container>
    // 展示面包屑与锚点面板。
    <Container class="pagePanel">
      // 组织面包屑内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Breadcrumb / Anchor</Text>
        // 展示自定义分隔符和折叠阈值的末项激活面包屑。
        <Breadcrumb items={[BreadcrumbItem('首页'), BreadcrumbItem('组件'), BreadcrumbItem('导航').active()]} separator="›" maxItems="3" />
        // 展示关闭活动指示线、带偏移与 href 事件的锚点导航。
        <Anchor items={[AnchorItem('基础', '#basic'), AnchorItem('高级', '#advanced'), AnchorItem('API', '#api')]} offsetTop="24" showInk="false" />
      // 结束面包屑内容。
      </Column>
    // 结束面包屑与锚点面板。
    </Container>
    // 展示由唯一按钮 trigger 子树驱动的 keyed Dropdown。
    <Container class="pagePanel">
      // 组织下拉菜单内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Dropdown</Text>
        // 同名选项通过独立稳定 key 发布 Change 事实。
        <Dropdown items={[DropdownItem('编辑', 'edit').icon('edit'), DropdownItem('复制', 'copy').icon('copy'), DropdownItem('更多', 'more').children([DropdownItem('导出', 'export'), DropdownItem('归档', 'archive')])]} trigger="click" width="180px">
          // Dropdown 拥有完整按钮 trigger 子树与焦点生命周期。
          <Button>更多操作</Button>
        // 结束组合 Dropdown。
        </Dropdown>
      // 结束下拉菜单内容。
      </Column>
    // 结束下拉菜单面板。
    </Container>
    // 展示 typed 菜单树与双受控 key 状态。
    <Container class="pagePanel">
      // 组织菜单内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Menu</Text>
        // Inline 始终显示递归子项，点击只写回 selectedKey 而不改写 openKeys。
        <Menu items={[MenuItem('设置', 'settings').icon('settings').children([MenuItem('账户', 'account'), MenuItem('安全', 'security')]), MenuItem('帮助', 'help')]} selectedKey={menu_selected} openKeys={menu_open} mode="inline" collapsible width="320px" />
      // 结束菜单内容。
      </Column>
    // 结束菜单面板。
    </Container>
    // 展示受控标签页与两个保持状态的静态面板。
    <Container class="pagePanel">
      // 组织标签页内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Tabs</Text>
        // items 只声明稳定 key 元数据，五个直接面板按源码顺序一一对应。
        <Tabs items={[Tab('账户').key('account'), Tab('安全').key('security'), Tab('通知').key('notifications'), Tab('高级').key('advanced'), Tab('日志').key('logs')]} activeKey={active_tab} tabPosition="left" scrollable height="180px">
          // 账户面板在切出后仍保持挂载状态。
          <Container padding="12px"><Text>账户资料面板</Text></Container>
          // 安全面板在活动时独占布局与命中。
          <Container padding="12px"><Button>更新安全设置</Button></Container>
          // 通知面板验证垂直标签栏的第三个声明项。
          <Container padding="12px"><Text>通知偏好面板</Text></Container>
          // 高级面板扩展主轴内容以触发滚动边界。
          <Container padding="12px"><Text>高级选项面板</Text></Container>
          // 日志面板位于溢出标签栏的末端。
          <Container padding="12px"><Text>审计日志面板</Text></Container>
        // 结束受控标签页。
        </Tabs>
      // 结束标签页内容。
      </Column>
    // 结束标签页面板。
    </Container>
    // 展示只拥有侧栏外壳并复用受控 Menu 的 Navigation。
    <Container class="pagePanel">
      // 组织完整侧栏组合内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Navigation</Text>
        // 选择、展开与整栏折叠分别绑定调用方唯一状态。
        <Navigation title="UIX Demo" items={[MenuItem('首页', 'home').icon('home'), MenuItem('管理', 'admin').icon('settings').children([MenuItem('用户', 'users'), MenuItem('权限', 'roles')])]} activeKey={nav_active} openKeys={nav_open} collapsed={nav_collapsed} version="v0.0.3" width="320px" height="320px" />
      // 结束完整侧栏组合内容。
      </Column>
    // 结束 Navigation 面板。
    </Container>
  // 结束导航组件内容。
  </Column>
// 结束导航组件页组件。
</Widget>

// 提供页面文档独立解析所需的唯一根。
<Text>主演示页面组件库</Text>
