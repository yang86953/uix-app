// 组织只供 test-harness 使用的固定 GPU 像素参考页。
<Container direction="column" flexGrow={0} padding="20px" gap="20px" style="backgroundColor: #FFFFFF; alignItems: flex-start;">
// 绘制固定四像素橙色边框，持续覆盖原始 Linux Shape 缺边问题。
<Container flexGrow={0} width="360px" height="80px" style="backgroundColor: #F5F5F5; borderWidth: 4px; borderColor: #FF7716; alignItems: center; justifyContent: center;">
// 使用随包字体同时触发 Latin 与简体中文字形覆盖率路径。
<Text fontSize="large">UIX 跨平台一致</Text>
// 结束固定字体参考卡片。
</Container>
// 绘制半透明红色径向 Gradient；正确 straight-alpha 合成后中心应接近 #FF7F7F。
<Container flexGrow={0} width="160px" height="160px" style="backgroundColor: #FFFFFF; backgroundImage: radial-gradient(rgba(255,0,0,0.5), rgba(255,0,0,0.5));" />
// 绘制向右偏移的零模糊黑色 Shadow；容器右侧必须露出十二像素确定性黑色条带。
<Container flexGrow={0} width="160px" height="60px" style="backgroundColor: #FFFFFF; boxShadow: 12px 0px 0px rgba(0,0,0,1);" />
// 绑定受控偏移的固定视口，第二帧必须经正常组件协调生成局部滚动搬移。
<ScrollView direction="vertical" offset={scroll_offset} flexGrow={0} width="360px" height="80px">
// 使用单一高内容盒绘制垂直渐变，使相隔四十像素的来源与目标可直接比较。
<Container flexGrow={0} width="340px" height="160px" style="backgroundImage: linear-gradient(#113355, #CC3366);" />
// 结束受控滚动参考视口。
</ScrollView>
// 结束固定参考页。
</Container>
