// 使用完整设计 token 字段覆盖内建 light 主题的代表值。
@theme light {
  // 保留品牌主色并驱动关联色板推导。
  primaryColor: #1677FF;
  // 保留应用布局背景兼容别名。
  backgroundColor: #F5F5F5;
  // 精确覆盖正文与边框语义色。
  colorText: #1F1F1F;
  colorBorder: #D9D9D9;
  // 精确覆盖容器背景。
  colorBgContainer: #FFFFFF;
  // 展示排版、间距和圆角数值 token。
  fontSize: 14px;
  padding: 16px;
  borderRadius: 6px;
  // 展示动效与断点 token。
  motionDurationFast: 0.1;
  screenMD: 768px;
  // 明确主题模式事实。
  isDark: false;
}

// 声明文档级样式类：统一内容面板底与边框。
pagePanel {
  padding: 16px;
  borderWidth: 1px;
  borderColor: #E5E7EB;
  borderRadius: 8px;
  backgroundColor: #backgroundColor;
}

// 声明继承面板样式并增加左侧强调线的强调面板。
accentPanel {
  extends: pagePanel;
  borderLeftWidth: 4px;
  borderColor: #1677FF;
}

// 声明 setStyle 演示的原始动态 class。
normalStyleAction {
  padding: 6px 12px;
  backgroundColor: #backgroundColor;
  borderWidth: 1px;
  borderColor: #D1D5DB;
  borderRadius: 6px;
}

// 声明 setStyle 演示的悬停动态 class，并覆盖布局与绘制字段。
hoverStyleAction {
  padding: 10px 18px;
  backgroundColor: #E6F4FF;
  borderWidth: 2px;
  borderColor: #1677FF;
  borderRadius: 8px;
}

// 声明自动 hover 与 disabled 伪类共用的按钮基础样式。
pseudoStateButton {
  padding: 8px 12px;
  borderWidth: 1px;
  borderColor: #colorBorder;
  borderRadius: #borderRadius;
  backgroundColor: #colorBgContainer;
}

// 悬停只覆盖背景与边框颜色，其他字段隐含继承基础类。
pseudoStateButton:hover {
  backgroundColor: #colorPrimaryBg;
  borderColor: #colorPrimary;
}

// 禁用只覆盖透明度，优先于悬停叠加层。
pseudoStateButton:disabled {
  opacity: 0.5;
}

// 声明 checked 演示的复选框基础样式。
pseudoStateCheck {
  borderWidth: 1px;
  borderColor: #colorBorder;
}

// 勾选时只覆盖边框颜色与宽度。
pseudoStateCheck:checked {
  borderColor: #colorPrimary;
  borderWidth: 2px;
}

// 声明拥有独立动态样式状态的悬停操作组件。
<Widget name="StyleAction">
  // 当前 Button 自己接收事件；内联颜色在两个动态 class 分支中保持最高优先级。
  <Button class="normalStyleAction" style="color: #1677FF;" automationId="uix-set-style-action" @mouseEnter="setStyle('hoverStyleAction')" @mouseLeave="setStyle('')">悬停切换 setStyle</Button>
// 结束动态样式组件。
</Widget>

// 声明消费既有 disabled 与 checked 状态事实的伪类演示组件。
<Widget name="PseudoStateAction" state="checked: bool = false, disabled: bool = false">
  // 纵向组织状态控件与切换操作。
  <Column gap="8px">
    // Button 的 hover 自动切换，disabled 读取同名布尔事实。
    <Button class="pseudoStateButton" disabled={disabled} automationId="uix-pseudo-state-button">自动 hover / disabled</Button>
    // Checkbox 的 checked 直接读取其既有 State<bool> 绑定。
    <Checkbox class="pseudoStateCheck" text="checked 状态叠加" checked={checked} />
    // 使用既有 setState 切换禁用事实。
    <Button @click="setState(disabled: !disabled)">切换 disabled</Button>
  // 结束状态伪类内容。
  </Column>
// 结束状态伪类演示组件。
</Widget>

// 声明阶段五语法小项的真实编译演示组件。
<Widget name="PhaseFiveAction" props="label: String = '阶段 5 默认标题'" state="primary: bool = false, fallback: bool = true, scores: Vec<number> = [1, 2], tags: Vec<String> = ['语法', '类型'], selected: Option<String> = Some('ready')">
  // 纵向组织默认 prop、扩展状态和条件链。
  <Column gap="8px">
    // 省略调用参数时显示 prop 默认值，并读取非空数字集合。
    <Text>{label} · 分数项 {scores.length}</Text>
    // 点击切换首分支，键盘事件读取按事件登记的 code 字段。
    <Button automationId="uix-phase-five-action" @click="setState(primary: !primary)" @keyDown="setState(primary: $event.code == 'Enter')">切换阶段 5 条件链</Button>
    // 首分支命中时只渲染这一项。
    <If {primary}><Tag color="success">If 命中 · {tags.length} 个标签</Tag></If>
    // 首分支未命中时继续短路判断。
    <ElseIf {fallback}><Tag color="info">ElseIf 命中</Tag></ElseIf>
    // 前两个条件均不命中时渲染尾分支。
    <Else><Tag color="warning">Else 命中</Tag></Else>
  // 结束阶段五演示内容。
  </Column>
// 结束阶段五语法小项演示组件。
</Widget>

// 声明页头标题组件，由共享 page 状态驱动条件标题。
<Widget name="PageTitle" props="page: State<number>">
  // 显示首页标题。
  <If {page == 0}><Text fontSize="heading3">首页</Text></If>
  // 显示语言能力页标题。
  <If {page == 1}><Text fontSize="heading3">语言能力</Text></If>
  // 显示通用组件页标题。
  <If {page == 2}><Text fontSize="heading3">通用</Text></If>
  // 显示布局组件页标题。
  <If {page == 3}><Text fontSize="heading3">布局</Text></If>
  // 显示导航组件页标题。
  <If {page == 4}><Text fontSize="heading3">导航</Text></If>
  // 显示输入组件页标题。
  <If {page == 5}><Text fontSize="heading3">输入</Text></If>
  // 显示数据展示页标题。
  <If {page == 6}><Text fontSize="heading3">数据展示</Text></If>
  // 显示反馈组件页标题。
  <If {page == 7}><Text fontSize="heading3">反馈</Text></If>
  // 显示图表能力页标题。
  <If {page == 8}><Text fontSize="heading3">图表</Text></If>
  // 显示其他组件页标题。
  <If {page == 9}><Text fontSize="heading3">其他</Text></If>
  // 显示框架能力页标题。
  <If {page == 10}><Text fontSize="heading3">框架能力</Text></If>
  // 显示覆盖清单页标题。
  <If {page == 11}><Text fontSize="heading3">覆盖清单</Text></If>
// 结束页头标题组件。
</Widget>

// 导入首页与运行时页面。
@import('./pages/start.uix')
// 导入通用、布局与导航页面。
@import('./pages/core.uix')
// 导入输入、数据、反馈、图表与其他页面。
@import('./pages/extended.uix')
// 导入框架与覆盖清单页面。
@import('./pages/reference.uix')

<Widget name="DemoApp" state="page: 0, count: 0">
  // 使用纵向根布局承载自定义标题栏与应用主体。
  <Column flexGrow={1} style="backgroundColor: #backgroundColor;">
    // 构造与 API GUI Demo 对齐的自定义标题栏。
    <Container direction="row" height="48px" gap="10px" align="center" style="backgroundColor: #backgroundColor;">
      // 只让非交互标题内容占据可拖拽区域。
      <WindowDragRegion flexGrow={1} height="48px" automationId="window-titlebar-drag">
        // 使用横向容器绘制应用标识与标题。
        <Container direction="row" height="48px" padding="8px" gap="10px" align="center">
          // 显示应用标识图标。
          <Icon name="layout-dashboard" />
          // 显示统一演示标题。
          <Text fontSize="heading4">UIX Demo</Text>
        // 结束非交互标题内容。
        </Container>
      // 结束窗口拖拽区域，后续交互控件保持为同级节点。
      </WindowDragRegion>
      // 提供主题明暗切换入口。
      <ThemeToggle automationId="theme-toggle" />
      // 复用公开窗口最小化、最大化与关闭控件。
      <WindowControl showMinimize showMaximize showClose />
    // 结束自定义标题栏。
    </Container>
    // 分隔标题栏与应用主体。
    <Divider />

    // 使用横向应用布局组织侧边栏与主内容区。
    <Layout direction="row" flexGrow={1}>
      // 构造与 API GUI Demo 同宽的侧边导航。
      <Sider width="220px" style="backgroundColor: #backgroundColor;">
        // 使用纵向容器组织导航分组。
        <Column gap="6px" padding="12px">
          // 标记入门导航分组。
          <Text fontSize="small">入门</Text>
          // 导航到首页。
          <Button @click="setState(page: 0)" automationId="sidebar-page-0">首页</Button>
          // 导航到语言能力页。
          <Button @click="setState(page: 1)" automationId="sidebar-page-1">语言能力</Button>
          // 导航到框架能力页。
          <Button @click="setState(page: 10)" automationId="sidebar-page-10">框架能力</Button>
          // 分隔入门与组件导航。
          <Divider />
          // 标记组件导航分组。
          <Text fontSize="small">组件</Text>
          // 导航到通用组件页。
          <Button @click="setState(page: 2)" automationId="sidebar-page-2">通用</Button>
          // 导航到布局组件页。
          <Button @click="setState(page: 3)" automationId="sidebar-page-3">布局</Button>
          // 导航到导航组件页。
          <Button @click="setState(page: 4)" automationId="sidebar-page-4">导航</Button>
          // 导航到输入组件页。
          <Button @click="setState(page: 5)" automationId="sidebar-page-5">输入</Button>
          // 导航到数据展示页。
          <Button @click="setState(page: 6)" automationId="sidebar-page-6">数据展示</Button>
          // 导航到反馈组件页。
          <Button @click="setState(page: 7)" automationId="sidebar-page-7">反馈</Button>
          // 导航到图表能力页。
          <Button @click="setState(page: 8)" automationId="sidebar-page-8">图表</Button>
          // 导航到其他组件页。
          <Button @click="setState(page: 9)" automationId="sidebar-page-9">其他</Button>
          // 分隔组件与参考导航。
          <Divider />
          // 标记参考导航分组。
          <Text fontSize="small">参考</Text>
          // 导航到覆盖清单页。
          <Button @click="setState(page: 11)" automationId="sidebar-page-11">覆盖清单</Button>
        // 结束侧边导航容器。
        </Column>
      // 结束侧边导航。
      </Sider>

      // 使用纵向布局承载页头、内容与状态栏。
      <Layout flexGrow={1}>
        // 构造当前页面标题栏。
        <Header height="56px" padding="12px" style="backgroundColor: #backgroundColor;">
          // 使用横向容器排列标题与运行状态。
          <Container direction="row" gap="10px" align="center">
            // 复用页头标题组件。
            <PageTitle page={page} />
            // 使用弹性占位把状态标签推到右侧。
            <Container flexGrow={1} />
            // 标记实时运行状态。
            <Tag color="success">live</Tag>
            // 标记当前界面来自编译期 uix-lang。
            <Tag color="info">uix-lang</Tag>
          // 结束页头内容容器。
          </Container>
        // 结束当前页面标题栏。
        </Header>
        // 分隔页头与页面内容。
        <Divider />

        // 让主内容区填满剩余空间。
        <Content flexGrow={1}>
          // 允许较长页面垂直滚动。
          <ScrollView direction="vertical" automationId="main-page-scroll">
            // 使用统一间距承载全部条件页面。
            <Column gap="16px" padding="24px">
              // 按当前页面状态显示首页。
              <If {page == 0}><HomePage page={page} count={count} /></If>
              // 按当前页面状态显示语言能力页。
              <If {page == 1}><RuntimePage /></If>
              // 按当前页面状态显示通用组件页。
              <If {page == 2}><GeneralPage /></If>
              // 按当前页面状态显示布局组件页。
              <If {page == 3}><LayoutPage /></If>
              // 按当前页面状态显示导航组件页。
              <If {page == 4}><NavPage /></If>
              // 按当前页面状态显示输入组件页。
              <If {page == 5}><InputPage /></If>
              // 按当前页面状态显示数据展示页。
              <If {page == 6}><DataPage /></If>
              // 按当前页面状态显示反馈组件页。
              <If {page == 7}><FeedbackPage /></If>
              // 按当前页面状态显示图表能力页。
              <If {page == 8}><ChartsPage /></If>
              // 按当前页面状态显示其他组件页。
              <If {page == 9}><OtherPage /></If>
              // 按当前页面状态显示框架能力页。
              <If {page == 10}><FrameworkPage /></If>
              // 按当前页面状态显示覆盖清单页。
              <If {page == 11}><GalleryPage /></If>
            // 结束页面内容容器。
            </Column>
          // 结束滚动内容区。
          </ScrollView>
        // 结束主内容区。
        </Content>

        // 构造与 API GUI Demo 对齐的状态栏。
        <Footer height="36px" padding="8px" style="backgroundColor: #backgroundColor;">
          // 展示运行与能力边界摘要。
          <Container direction="row" gap="10px" align="center" automationId="app-status-bar">
            // 展示状态栏图标。
            <Icon name="terminal" size="12px" />
            // 展示状态栏摘要。
            <Text fontSize="small">UIX 全组件演示 · uix-lang 编译期界面 · Rust 仅持有 App 生命周期</Text>
          // 结束状态栏内容。
          </Container>
        // 结束状态栏。
        </Footer>
      // 结束主内容纵向布局。
      </Layout>
    // 结束应用主体布局。
    </Layout>
  // 结束根布局。
  </Column>
// 结束声明式演示组件。
</Widget>
// 声明应用入口的窗口规格与内建初始主题。
<App title="UIX Demo" size="1200x800" theme="light">
  // 实例化唯一 View 根；页面与演示状态全部由语言面拥有。
  <DemoApp />
// 结束应用入口。
</App>
