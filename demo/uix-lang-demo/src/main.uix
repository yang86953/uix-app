// 声明框架能力页组件。
<Component name="FrameworkPage">
  // 组织框架能力内容。
  <Column gap="16px">
    // 展示框架能力标题。
    <Text fontSize="heading2">框架能力</Text>
    // 展示窗口框架面板。
    <Container class="pagePanel">
      // 组织窗口框架内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">窗口框架 / 拖拽区域</Text>
        // 排列窗口控件。
        <Container direction="row" gap="12px" align="center">
          // 展示窗口最小化、最大化与关闭控件。
          <WindowControl showMinimize showMaximize showClose />
          // 展示主题切换控件。
          <ThemeToggle />
        // 结束窗口控件行。
        </Container>
        // 展示可拖拽区域。
        <WindowDragRegion height="40px" backgroundColor="#F0F0F0">
          // 展示拖拽区域说明。
          <Container height="40px" align="center" justify="center"><Text>WindowDragRegion — 可拖拽区域</Text></Container>
        // 结束可拖拽区域。
        </WindowDragRegion>
      // 结束窗口框架内容。
      </Column>
    // 结束窗口框架面板。
    </Container>
    // 展示样式系统面板。
    <Container class="accentPanel">
      // 组织样式系统内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">样式类继承与内联覆盖</Text>
        // 说明当前面板样式来源。
        <Text>本面板使用 accentPanel（extends pagePanel + 左侧强调线）。</Text>
        // 展示内联样式覆盖样式类。
        <Container class="pagePanel" style="padding: 24px; borderColor: #1677FF; borderWidth: 2px;">
          // 说明内联样式优先级。
          <Text>内联 style 优先于样式类：padding 24px + 蓝色边框。</Text>
        // 结束内联覆盖容器。
        </Container>
      // 结束样式系统内容。
      </Column>
    // 结束样式系统面板。
    </Container>
    // 展示编译期生成面板。
    <Container class="pagePanel">
      // 组织编译期内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">编译期生成</Text>
        // 展示编译期生成说明。
        <Alert message="uix! 在编译期生成公开 ViewNode，不引入运行时解释器。" type="success" />
        // 展示语言能力标签行。
        <Container direction="row" gap="8px">
          // 标记自动化标识能力。
          <Tag color="success">automationId</Tag>
          // 标记稳定身份能力。
          <Tag color="success">key</Tag>
          // 标记受控状态能力。
          <Tag color="info">受控状态</Tag>
          // 标记状态更新能力。
          <Tag color="info">setState</Tag>
          // 标记主题切换能力。
          <Tag color="warning">setTheme</Tag>
        // 结束语言能力标签行。
        </Container>
        // 说明生命周期所有权。
        <Text>窗口创建、主题跟随、诊断与事件循环仍由 src/main.rs 的 App 组合根持有。</Text>
      // 结束编译期内容。
      </Column>
    // 结束编译期生成面板。
    </Container>
    // 说明 Provider 边界。
    <Alert message="LocaleProvider、ConfigProvider、ComponentOverrides 保留 Rust API 边界。" type="info" />
  // 结束框架能力内容。
  </Column>
// 结束框架能力页组件。
</Component>

// 声明覆盖清单页组件。
<Component name="GalleryPage">
  // 组织覆盖清单内容。
  <Column gap="16px">
    // 展示覆盖清单标题。
    <Text fontSize="heading2">覆盖清单</Text>
    // 展示覆盖清单面板。
    <Container class="pagePanel">
      // 组织覆盖清单内容。
      <Column gap="8px">
        // 展示已对齐结构小节。
        <Text fontSize="heading5">已对齐结构</Text>
        // 说明结构对齐范围。
        <Text>窗口尺寸 1200×800、自定义标题栏、分组侧栏、页头、滚动内容区、状态栏与 12 个公开入口。</Text>
        // 展示已覆盖标签小节。
        <Text fontSize="heading5">已覆盖标签</Text>
        // 说明通用标签覆盖。
        <Text>通用：Button / ButtonGroup / FloatButton / Icon / Divider / Space / Typography / Tag / Text / Label</Text>
        // 说明布局标签覆盖。
        <Text>布局：Container / Row / Col / Grid / ScrollView / VirtualScroll / Splitter / Affix / BackTop / Layout / Sider / Header / Content / Footer</Text>
        // 说明输入标签覆盖。
        <Text>输入：Input / InputNumber / InputGroup / Slider / RangeSlider / Rate / Checkbox / Switch / Radio / Segmented / Select / Cascader / TreeSelect / AutoComplete / Mentions / DatePicker / DateRangePicker / TimePicker / ColorPicker / Form 全字段</Text>
        // 说明数据展示标签覆盖。
        <Text>数据展示：Card / List / Skeleton / Empty / ResultView / Descriptions / Timeline / Calendar / Carousel / Tree / Avatar / Image / ImageGroup / RichText</Text>
        // 说明反馈标签覆盖。
        <Text>反馈：Alert / Modal / Drawer / Tooltip / Popover / FocusTrap / Spin</Text>
        // 说明导航与框架标签覆盖。
        <Text>导航与框架：Steps / Pagination / Breadcrumb / Anchor / ThemeToggle / WindowControl / WindowDragRegion / QRCode / Watermark</Text>
        // 展示语言能力小节。
        <Text fontSize="heading5">语言能力</Text>
        // 说明组件与状态能力。
        <Text>组件：props / 私有 state / 类型化 state（u32、usize、f32、i32、Date、Time、Color、Point、CascaderValue、HashSet）/ setState / 句柄位绑定 / If / For / 样式类继承 / setTheme。</Text>
        // 说明数据声明能力。
        <Text>数据：数组字面量 / 十二类数据类型构造链（SelectOption、CascaderOption、TreeNode、TimelineItem、Step、DescriptionsItem、BreadcrumbItem、AnchorItem、Date、Time、Color、Point）/ Record 类型化业务模型。</Text>
        // 展示保留边界小节。
        <Text fontSize="heading5">保留边界</Text>
        // 说明保留在 Rust API 的边界。
        <Text>图表、表格、菜单、标签页等未登记标签，以及 Agent 控制与 test-harness 专用入口。</Text>
        // 展示验收状态标签。
        <Container direction="row" gap="8px">
          // 标记结构对齐状态。
          <Tag color="success">结构已对齐</Tag>
          // 标记编译边界状态。
          <Tag color="success">编译期生成</Tag>
          // 标记待验收状态。
          <Tag color="warning">待视觉验收</Tag>
        // 结束验收状态行。
        </Container>
      // 结束覆盖清单内容。
      </Column>
    // 结束覆盖清单面板。
    </Container>
  // 结束覆盖清单内容。
  </Column>
// 结束覆盖清单页组件。
</Component>

// 声明演示组件，并接收由窗口 root factory 持有的页面、计数与 tick 状态。
<Component name="DemoApp" props="page: State<number>, count: State<number>, tick: State<number>">
  // 使用纵向根布局承载自定义标题栏与应用主体。
  <Column flexGrow={1} backgroundColor="#F5F5F5">
    // 构造与 API GUI Demo 对齐的自定义标题栏。
    <Container direction="row" height="48px" gap="10px" align="center" backgroundColor="#FFFFFF">
      // 只让非交互标题内容占据可拖拽区域。
      <WindowDragRegion flexGrow={1} height="48px" automationId="window-titlebar-drag">
        // 使用横向容器绘制应用标识与标题。
        <Container direction="row" height="48px" padding="8px" gap="10px" align="center">
          // 显示应用标识图标。
          <Icon name="layout-dashboard" />
          // 显示统一演示标题。
          <Text fontSize="heading4">UIX Demo</Text>
        // 结束非交互标题内容。
        </Container>
      // 结束窗口拖拽区域，后续交互控件保持为同级节点。
      </WindowDragRegion>
      // 提供主题明暗切换入口。
      <ThemeToggle automationId="theme-toggle" />
      // 复用公开窗口最小化、最大化与关闭控件。
      <WindowControl showMinimize showMaximize showClose />
    // 结束自定义标题栏。
    </Container>
    // 分隔标题栏与应用主体。
    <Divider />

    // 使用横向应用布局组织侧边栏与主内容区。
    <Layout direction="row" flexGrow={1}>
      // 构造与 API GUI Demo 同宽的侧边导航。
      <Sider width="220px" backgroundColor="#FFFFFF">
        // 使用纵向容器组织导航分组。
        <Column gap="6px" padding="12px">
          // 标记入门导航分组。
          <Text fontSize="small">入门</Text>
          // 导航到首页。
          <Button @click="setState(page: 0)">首页</Button>
          // 导航到应用能力页。
          <Button @click="setState(page: 1)">应用能力</Button>
          // 导航到框架能力页。
          <Button @click="setState(page: 10)">框架能力</Button>
          // 分隔入门与组件导航。
          <Divider />
          // 标记组件导航分组。
          <Text fontSize="small">组件</Text>
          // 导航到通用组件页。
          <Button @click="setState(page: 2)">通用</Button>
          // 导航到布局组件页。
          <Button @click="setState(page: 3)">布局</Button>
          // 导航到导航组件页。
          <Button @click="setState(page: 4)">导航</Button>
          // 导航到输入组件页。
          <Button @click="setState(page: 5)">输入</Button>
          // 导航到数据展示页。
          <Button @click="setState(page: 6)">数据展示</Button>
          // 导航到反馈组件页。
          <Button @click="setState(page: 7)">反馈</Button>
          // 导航到图表能力页。
          <Button @click="setState(page: 8)">图表</Button>
          // 导航到其他组件页。
          <Button @click="setState(page: 9)">其他</Button>
          // 分隔组件与参考导航。
          <Divider />
          // 标记参考导航分组。
          <Text fontSize="small">参考</Text>
          // 导航到覆盖清单页。
          <Button @click="setState(page: 11)">覆盖清单</Button>
        // 结束侧边导航容器。
        </Column>
      // 结束侧边导航。
      </Sider>

      // 使用纵向布局承载页头、内容与状态栏。
      <Layout flexGrow={1}>
        // 构造当前页面标题栏。
        <Header height="56px" padding="12px" backgroundColor="#FFFFFF">
          // 使用横向容器排列标题与运行状态。
          <Container direction="row" gap="10px" align="center">
            // 复用页头标题组件。
            <PageTitle page={page} />
            // 使用弹性占位把状态标签推到右侧。
            <Container flexGrow={1} />
            // 标记实时运行状态。
            <Tag color="success">live</Tag>
            // 显示 App.on_start 秒级计时器状态。
            <Text fontSize="small">tick: {tick}s</Text>
            // 标记当前界面来自编译期 uix-lang。
            <Tag color="info">uix-lang</Tag>
          // 结束页头内容容器。
          </Container>
        // 结束当前页面标题栏。
        </Header>
        // 分隔页头与页面内容。
        <Divider />

        // 让主内容区填满剩余空间。
        <Content flexGrow={1}>
          // 允许较长页面垂直滚动。
          <ScrollView direction="vertical">
            // 使用统一间距承载全部条件页面。
            <Column gap="16px" padding="24px">
              // 按当前页面状态显示首页。
              <If {page == 0}><HomePage page={page} count={count} /></If>
              // 按当前页面状态显示应用能力页。
              <If {page == 1}><RuntimePage tick={tick} count={count} /></If>
              // 按当前页面状态显示通用组件页。
              <If {page == 2}><GeneralPage /></If>
              // 按当前页面状态显示布局组件页。
              <If {page == 3}><LayoutPage /></If>
              // 按当前页面状态显示导航组件页。
              <If {page == 4}><NavPage /></If>
              // 按当前页面状态显示输入组件页。
              <If {page == 5}><InputPage /></If>
              // 按当前页面状态显示数据展示页。
              <If {page == 6}><DataPage /></If>
              // 按当前页面状态显示反馈组件页。
              <If {page == 7}><FeedbackPage /></If>
              // 按当前页面状态显示图表能力页。
              <If {page == 8}><ChartsPage /></If>
              // 按当前页面状态显示其他组件页。
              <If {page == 9}><OtherPage /></If>
              // 按当前页面状态显示框架能力页。
              <If {page == 10}><FrameworkPage /></If>
              // 按当前页面状态显示覆盖清单页。
              <If {page == 11}><GalleryPage /></If>
            // 结束页面内容容器。
            </Column>
          // 结束滚动内容区。
          </ScrollView>
        // 结束主内容区。
        </Content>

        // 构造与 API GUI Demo 对齐的状态栏。
        <Footer height="36px" padding="8px" backgroundColor="#FFFFFF">
          // 展示运行与能力边界摘要。
          <Container direction="row" gap="10px" align="center" automationId="app-status-bar">
            // 展示状态栏图标。
            <Icon name="terminal" size="12px" />
            // 展示状态栏摘要。
            <Text fontSize="small">UIX GUI 演示 · uix-lang 编译期界面 · Rust App 生命周期 · tick {tick}s</Text>
          // 结束状态栏内容。
          </Container>
        // 结束状态栏。
        </Footer>
      // 结束主内容纵向布局。
      </Layout>
    // 结束应用主体布局。
    </Layout>
  // 结束根布局。
  </Column>
// 结束声明式演示组件。
</Component>
// 实例化文档的唯一根组件并传入窗口级持久状态句柄。
<DemoApp page={page} count={count} tick={tick} />
