// 声明文档级样式类：统一内容面板底与边框。
pagePanel {
  padding: 16px;
  borderWidth: 1px;
  borderColor: #E5E7EB;
  borderRadius: 8px;
  backgroundColor: #FFFFFF;
}

// 声明继承面板样式并增加左侧强调线的强调面板。
accentPanel {
  extends: pagePanel;
  borderLeftWidth: 4px;
  borderColor: #1677FF;
}

// 声明 setStyle 演示的原始动态 class。
normalStyleAction {
  padding: 6px 12px;
  backgroundColor: #FFFFFF;
  borderWidth: 1px;
  borderColor: #D1D5DB;
  borderRadius: 6px;
}

// 声明 setStyle 演示的悬停动态 class，并覆盖布局与绘制字段。
hoverStyleAction {
  padding: 10px 18px;
  backgroundColor: #E6F4FF;
  borderWidth: 2px;
  borderColor: #1677FF;
  borderRadius: 8px;
}

// 声明拥有独立动态样式状态的悬停操作组件。
<Component name="StyleAction">
  // 当前 Button 自己接收事件；内联颜色在两个动态 class 分支中保持最高优先级。
  <Button class="normalStyleAction" style="color: #1677FF;" automationId="uix-set-style-action" @mouseEnter="setStyle('hoverStyleAction')" @mouseLeave="setStyle('')">悬停切换 setStyle</Button>
// 结束动态样式组件。
</Component>

// 声明语言面类型化业务模型：Form 演示的提交载荷与 Rust 侧回调共享同一类型。
<Record name="Profile" fields="email: String, level: String, accepted: bool, channel: String, notifications: bool, volume: number" />

// 声明页头标题组件，由共享 page 状态驱动条件标题。
<Component name="PageTitle" props="page: State<number>">
  // 显示首页标题。
  <If {page == 0}><Text fontSize="heading3">首页</Text></If>
  // 显示应用能力页标题。
  <If {page == 1}><Text fontSize="heading3">应用能力</Text></If>
  // 显示通用组件页标题。
  <If {page == 2}><Text fontSize="heading3">通用</Text></If>
  // 显示布局组件页标题。
  <If {page == 3}><Text fontSize="heading3">布局</Text></If>
  // 显示导航组件页标题。
  <If {page == 4}><Text fontSize="heading3">导航</Text></If>
  // 显示输入组件页标题。
  <If {page == 5}><Text fontSize="heading3">输入</Text></If>
  // 显示数据展示页标题。
  <If {page == 6}><Text fontSize="heading3">数据展示</Text></If>
  // 显示反馈组件页标题。
  <If {page == 7}><Text fontSize="heading3">反馈</Text></If>
  // 显示图表能力页标题。
  <If {page == 8}><Text fontSize="heading3">图表</Text></If>
  // 显示其他组件页标题。
  <If {page == 9}><Text fontSize="heading3">其他</Text></If>
  // 显示框架能力页标题。
  <If {page == 10}><Text fontSize="heading3">框架能力</Text></If>
  // 显示覆盖清单页标题。
  <If {page == 11}><Text fontSize="heading3">覆盖清单</Text></If>
// 结束页头标题组件。
</Component>

// 声明首页组件：接收窗口级计数与页面状态，并持有私有点赞状态。
<Component name="HomePage" props="page: State<number>, count: State<number>" state="likes: 0">
  // 组织首页内容。
  <Column gap="16px">
    // 展示首页主卡片与统一演示标题。
    <Container class="accentPanel" direction="row" gap="10px" align="center">
      // 展示全景图标。
      <Icon name="star" size="18px" />
      // 展示首页主标题。
      <Text fontSize="heading2">UIX 组件全景</Text>
      // 标记演示版本。
      <Tag color="info">Demo</Tag>
    // 结束首页主卡片。
    </Container>
    // 说明声明式版本的对齐目标。
    <Text>此界面由 src/main.uix 在编译期生成，页面结构与 API GUI Demo 对齐。</Text>
    // 展示窗口级共享状态卡片。
    <Card title="响应式 State（窗口级共享）">
      // 组织计数器内容。
      <Column gap="10px">
        // 显示窗口级共享计数。
        <Text>计数: {count}</Text>
        // 使用横向容器排列计数器操作。
        <Container direction="row" gap="8px">
          // 通过声明式事件递增共享状态。
          <Button type="primary" @click="setState(count: count + 1)" automationId="home-count-increment">+1</Button>
          // 通过三元表达式实现不减到负数。
          <Button @click="setState(count: count > 0 ? count - 1 : 0)" automationId="home-count-decrement">-1</Button>
          // 重置共享计数。
          <Button type="ghost" @click="setState(count: 0)" automationId="home-count-reset">重置</Button>
        // 结束计数器操作行。
        </Container>
      // 结束计数器内容。
      </Column>
    // 结束共享状态卡片。
    </Card>
    // 展示组件私有状态卡片。
    <Card title="组件私有状态（state 声明）">
      // 组织点赞内容。
      <Column gap="10px">
        // 显示组件私有点赞数。
        <Text>点赞数: {likes}</Text>
        // 通过 setState 更新私有状态。
        <Button @click="setState(likes: likes + 1)">点赞 +1</Button>
      // 结束点赞内容。
      </Column>
    // 结束私有状态卡片。
    </Card>
    // 展示覆盖与快捷导航卡片。
    <Container direction="row" gap="12px">
      // 展示覆盖范围卡片。
      <Card title="覆盖范围" width="220px">
        // 组织覆盖统计内容。
        <Column gap="8px">
          // 展示演示页总数。
          <Text fontSize="heading1">12</Text>
          // 说明页面数量单位。
          <Text>个演示页</Text>
          // 展示能力标签行。
          <Container direction="row" gap="6px">
            // 标记组件能力。
            <Tag color="success">组件</Tag>
            // 标记运行时能力。
            <Tag color="info">运行时</Tag>
            // 标记主题能力。
            <Tag color="warning">主题</Tag>
          // 结束能力标签行。
          </Container>
        // 结束覆盖统计内容。
        </Column>
      // 结束覆盖范围卡片。
      </Card>
      // 展示快捷导航卡片。
      <Card title="快捷导航" width="220px">
        // 组织导航按钮。
        <Column gap="6px">
          // 跳转应用能力页。
          <Button @click="setState(page: 1)">应用能力</Button>
          // 跳转通用组件页。
          <Button @click="setState(page: 2)">通用组件</Button>
          // 跳转覆盖清单页。
          <Button @click="setState(page: 11)">覆盖清单</Button>
        // 结束导航按钮。
        </Column>
      // 结束快捷导航卡片。
      </Card>
    // 结束首页卡片行。
    </Container>
    // 展示可用性提示。
    <Alert message="左侧导航可切换 12 个公开演示页面。" type="success" />
  // 结束首页内容。
  </Column>
// 结束首页组件。
</Component>

// 声明应用能力组件：展示 App Timer、响应式状态与 setTheme。
<Component name="RuntimePage" props="tick: State<number>, count: State<number>">
  // 组织应用能力内容。
  <Column gap="16px">
    // 展示应用能力标题。
    <Text fontSize="heading2">应用能力</Text>
    // 展示 App Timer 卡片。
    <Card title="App Timer — run_interval">
      // 组织计时器内容。
      <Column gap="8px">
        // 显示每秒递增的全局 tick。
        <Text>全局 tick: {tick}（每秒 +1）</Text>
        // 说明计时器由 Rust 组合根注册。
        <Text fontSize="small">src/main.rs 的 App.on_start 注册 1s run_interval 更新共享 tick 状态。</Text>
      // 结束计时器内容。
      </Column>
    // 结束 App Timer 卡片。
    </Card>
    // 展示响应式 State 卡片。
    <Card title="响应式 State / setState">
      // 组织计数内容。
      <Column gap="10px">
        // 显示窗口级计数。
        <Text>本地计数: {count}</Text>
        // 排列计数操作。
        <Container direction="row" gap="8px">
          // 递增计数。
          <Button type="primary" @click="setState(count: count + 1)">+1</Button>
          // 递减计数。
          <Button @click="setState(count: count > 0 ? count - 1 : 0)">-1</Button>
        // 结束计数操作。
        </Container>
      // 结束计数内容。
      </Column>
    // 结束响应式 State 卡片。
    </Card>
    // 展示主题卡片。
    <Card title="Theme">
      // 组织主题内容。
      <Column gap="8px">
        // 排列主题操作。
        <Container direction="row" gap="12px" align="center">
          // 通过 setTheme 内置操作切换到暗色。
          <Button @click="setTheme('dark')">暗色主题</Button>
          // 通过 setTheme 内置操作切换到亮色。
          <Button @click="setTheme('light')">亮色主题</Button>
          // 复用标题栏主题切换组件。
          <ThemeToggle />
        // 结束主题操作。
        </Container>
        // 说明内置操作的真实调用路径。
        <Text fontSize="small">setTheme 是框架内置操作，生成主题请求通道调用；App 组合根在窗口循环内注册请求器并复用 runtime.set_theme 通道。</Text>
        // 直接演示组件私有动态 class、布局更新与离开恢复。
        <StyleAction />
        // 说明 setStyle 不依赖调用方同名函数或运行时字符串注册表。
        <Text fontSize="small">setStyle 由编译器生成闭合 Style 分支；悬停替换当前 View 的动态 class，离开时恢复原始 class，内联 style 始终保持作者覆盖优先级。</Text>
      // 结束主题内容。
      </Column>
    // 结束主题卡片。
    </Card>
    // 展示多窗口与 PicturePolicy 边界。
    <Alert message="多窗口 open_window、PicturePolicy 与 component! 自定义组件保留 Rust API 边界，不在声明文件复制运行时所有权。" type="info" />
    // 展示编译期生成说明。
    <Alert message="uix! 在编译期生成公开 ViewNode，不引入运行时解释器。" type="success" />
  // 结束应用能力内容。
  </Column>
// 结束应用能力组件。
</Component>

// 声明通用组件页组件。
<Component name="GeneralPage">
  // 组织通用组件内容。
  <Column gap="16px">
    // 展示通用组件标题。
    <Text fontSize="heading2">通用组件</Text>
    // 展示排版层级面板。
    <Container class="pagePanel">
      // 组织排版内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Typography — 标题层级</Text>
        // 展示一级标题。
        <Typography level="1">Heading 1 — 一级标题</Typography>
        // 展示二级标题。
        <Typography level="2">Heading 2 — 二级标题</Typography>
        // 展示三级标题。
        <Typography level="3">Heading 3 — 三级标题</Typography>
        // 展示次要文本。
        <Typography type="secondary">Secondary 次要文本</Typography>
        // 展示成功文本。
        <Typography type="success">Success 成功文本</Typography>
        // 展示警告文本。
        <Typography type="warning">Warning 警告文本</Typography>
        // 展示危险文本。
        <Typography type="danger">Danger 危险文本</Typography>
        // 展示标记、下划线与复制能力。
        <Typography mark underline copyable>标记 + 下划线 + 复制</Typography>
      // 结束排版内容。
      </Column>
    // 结束排版层级面板。
    </Container>
    // 展示按钮预设面板。
    <Container class="pagePanel">
      // 组织按钮内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Button — StyleSet 预设</Text>
        // 排列按钮预设。
        <Container direction="row" gap="8px">
          // 展示主要操作按钮。
          <Button type="primary">主要操作</Button>
          // 展示默认按钮。
          <Button>默认按钮</Button>
          // 展示幽灵按钮。
          <Button type="ghost">幽灵按钮</Button>
          // 展示危险按钮。
          <Button type="danger">危险按钮</Button>
          // 展示禁用按钮。
          <Button disabled>禁用按钮</Button>
          // 展示块级按钮。
          <Button block>块级按钮</Button>
        // 结束按钮预设行。
        </Container>
        // 展示按钮组连体组合。
        <ButtonGroup>
          // 展示连体左侧按钮。
          <Button type="primary">左</Button>
          // 展示连体中间按钮。
          <Button>中</Button>
          // 展示连体右侧按钮。
          <Button type="ghost">右</Button>
        // 结束按钮组。
        </ButtonGroup>
      // 结束按钮内容。
      </Column>
    // 结束按钮预设面板。
    </Container>
    // 展示标签、图标与分割线面板。
    <Container class="pagePanel">
      // 组织标签内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Tag / Icon / Divider</Text>
        // 排列语义色标签。
        <Container direction="row" gap="8px" align="center">
          // 展示默认标签。
          <Tag>Default</Tag>
          // 展示成功标签。
          <Tag color="success">Success</Tag>
          // 展示警告标签。
          <Tag color="warning">Warning</Tag>
          // 展示错误标签。
          <Tag color="error">Error</Tag>
          // 展示信息标签。
          <Tag color="info">Info</Tag>
          // 展示自定义色标签。
          <Tag color="#1677FF">自定义色</Tag>
          // 展示可关闭可勾选标签。
          <Tag color="success" closable checkable>已完成</Tag>
        // 结束语义色标签行。
        </Container>
        // 排列 Lucide 图标集。
        <Container direction="row" gap="12px" align="center">
          // 展示搜索图标。
          <Icon name="search" size="20px" />
          // 展示主页图标。
          <Icon name="home" size="20px" />
          // 展示设置图标。
          <Icon name="settings" size="20px" />
          // 展示用户图标。
          <Icon name="user" size="20px" />
          // 展示铃铛图标。
          <Icon name="bell" size="20px" />
          // 展示星标图标。
          <Icon name="star" size="20px" />
          // 展示爱心图标。
          <Icon name="heart" size="20px" />
          // 展示编辑图标。
          <Icon name="edit" size="20px" />
        // 结束图标行。
        </Container>
        // 展示带文字水平分割线。
        <Divider text="居中文字" />
        // 展示虚线分割线。
        <Divider dashed />
        // 展示垂直分割线行。
        <Container direction="row" gap="12px" align="center" height="32px">
          // 展示左侧文字。
          <Text>左</Text>
          // 展示垂直分割线。
          <Divider direction="vertical" />
          // 展示中间文字。
          <Text>中</Text>
          // 展示垂直分割线。
          <Divider direction="vertical" />
          // 展示右侧文字。
          <Text>右</Text>
        // 结束垂直分割线行。
        </Container>
      // 结束标签内容。
      </Column>
    // 结束标签、图标与分割线面板。
    </Container>
    // 展示间距与浮动按钮面板。
    <Container class="pagePanel">
      // 组织间距内容。
      <Column gap="8px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Space / FloatButton</Text>
        // 展示自定义间距行。
        <Space direction="horizontal" gap="8px">
          // 展示甲按钮。
          <Button>甲</Button>
          // 展示乙按钮。
          <Button>乙</Button>
          // 展示丙按钮。
          <Button>丙</Button>
        // 结束自定义间距行。
        </Space>
        // 排列浮动按钮。
        <Container direction="row" gap="24px" height="56px">
          // 展示左上角浮动按钮。
          <FloatButton icon="plus" description="新建" tooltip="新建项目" position="leftTop" />
          // 展示带徽标反馈浮动按钮。
          <FloatButton icon="message" tooltip="反馈" badge={{ count: 7, dot: false }} />
        // 结束浮动按钮行。
        </Container>
      // 结束间距内容。
      </Column>
    // 结束间距与浮动按钮面板。
    </Container>
  // 结束通用组件内容。
  </Column>
// 结束通用组件页组件。
</Component>

// 声明布局组件页组件：持有吸顶演示的滚动位置状态。
<Component name="LayoutPage" state="scroll_y: f32 = 180, scroll_point: Point = Point(0.0, 0.0)">
  // 组织布局组件内容。
  <Column gap="16px">
    // 展示布局组件标题。
    <Text fontSize="heading2">布局组件</Text>
    // 展示 Flex 容器面板。
    <Container class="pagePanel">
      // 组织 Flex 内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Container — Flex Row / Column</Text>
        // 展示两端分布的横向 Flex。
        <Container direction="row" gap="12px" align="center" justify="spaceBetween" padding="12px" backgroundColor="#F0F0F0" height="72px">
          // 展示 A 色块。
          <Container width="80px" height="28px" backgroundColor="#4096FF" align="center" justify="center"><Text> A </Text></Container>
          // 展示 B 色块。
          <Container width="80px" height="28px" backgroundColor="#52C41A" align="center" justify="center"><Text> B </Text></Container>
          // 展示 C 色块。
          <Container width="80px" height="28px" backgroundColor="#FAAD14" align="center" justify="center"><Text> C </Text></Container>
          // 展示 D 色块。
          <Container width="80px" height="28px" backgroundColor="#722ED1" align="center" justify="center"><Text> D </Text></Container>
        // 结束横向 Flex。
        </Container>
        // 展示居中的纵向 Flex。
        <Container direction="column" gap="8px" align="center" padding="12px" backgroundColor="#F0F0F0" height="120px">
          // 展示第一纵向色块。
          <Container width="80px" height="28px" backgroundColor="#4096FF" align="center" justify="center"><Text> 壹 </Text></Container>
          // 展示第二纵向色块。
          <Container width="80px" height="28px" backgroundColor="#52C41A" align="center" justify="center"><Text> 贰 </Text></Container>
          // 展示第三纵向色块。
          <Container width="80px" height="28px" backgroundColor="#FAAD14" align="center" justify="center"><Text> 叁 </Text></Container>
        // 结束纵向 Flex。
        </Container>
      // 结束 Flex 内容。
      </Column>
    // 结束 Flex 容器面板。
    </Container>
    // 展示栅格面板。
    <Container class="pagePanel">
      // 组织栅格内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Row / Col — 24 栅格</Text>
        // 展示两列等分栅格。
        <Row gap="12px">
          // 展示左侧 12 栅格。
          <Col span={12}><Card title="12 / 24"><Text>响应式 Col</Text></Card></Col>
          // 展示右侧 12 栅格。
          <Col span={12}><Card title="12 / 24"><Text>sm / md / lg 断点重排</Text></Card></Col>
        // 结束两列等分栅格。
        </Row>
        // 展示四列响应式栅格。
        <Row gap="12px">
          // 展示第一响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>按 logical 宽度切换</Text></Card></Col>
          // 展示第二响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>resize 自动重排</Text></Card></Col>
          // 展示第三响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>编译期 span 常量</Text></Card></Col>
          // 展示第四响应式列。
          <Col span={24} md={12} lg={6}><Card title="24/12/6"><Text>与 API Demo 共用布局</Text></Card></Col>
        // 结束四列响应式栅格。
        </Row>
        // 展示显式轨道 Grid。
        <Grid columns="1fr 200px auto" rows="auto" colGap="8px" rowGap="4px" height="96px">
          // 展示弹性轨道列。
          <Col span={1}><Container backgroundColor="#E6F4FF" height="88px" align="center" justify="center"><Text>1fr</Text></Container></Col>
          // 展示固定轨道列。
          <Col span={1}><Container backgroundColor="#FFF7E6" height="88px" align="center" justify="center"><Text>200px</Text></Container></Col>
          // 展示自动轨道列。
          <Col span={1}><Container backgroundColor="#F6FFED" height="88px" align="center" justify="center"><Text>auto</Text></Container></Col>
        // 结束显式轨道 Grid。
        </Grid>
      // 结束栅格内容。
      </Column>
    // 结束栅格面板。
    </Container>
    // 展示应用壳面板。
    <Container class="pagePanel">
      // 组织应用壳内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Layout — Header / Sider / Content / Footer</Text>
        // 展示完整应用布局壳。
        <Layout direction="row" height="160px">
          // 展示可折叠侧栏。
          <Sider collapsible width="140px" backgroundColor="#E6F4FF"><Text> Sider </Text></Sider>
          // 展示右侧嵌套布局。
          <Layout>
            // 展示页头。
            <Header height="36px" backgroundColor="#BAE0FF"><Text>Header</Text></Header>
            // 展示内容区。
            <Content flexGrow={1}><Text>Content</Text></Content>
            // 展示页脚。
            <Footer height="28px" backgroundColor="#F0F0F0"><Text>Footer</Text></Footer>
          // 结束嵌套布局。
          </Layout>
        // 结束完整应用布局壳。
        </Layout>
      // 结束应用壳内容。
      </Column>
    // 结束应用壳面板。
    </Container>
    // 展示分隔器面板。
    <Container class="pagePanel">
      // 组织分隔器内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Splitter — 水平 / 垂直</Text>
        // 展示水平双面板。
        <Splitter direction="horizontal" defaultRatio="0.3" height="140px">
          // 展示左侧面板。
          <Container backgroundColor="#E6F4FF" align="center" justify="center"><Text>左侧面板</Text></Container>
          // 展示右侧面板。
          <Container backgroundColor="#F6FFED" align="center" justify="center"><Text>右侧面板</Text></Container>
        // 结束水平双面板。
        </Splitter>
        // 展示垂直双面板。
        <Splitter direction="vertical" defaultRatio="0.5" width="320px" height="100px">
          // 展示上面板。
          <Container backgroundColor="#FFF7E6" align="center" justify="center"><Text>上面板</Text></Container>
          // 展示下面板。
          <Container backgroundColor="#F9F0FF" align="center" justify="center"><Text>下面板</Text></Container>
        // 结束垂直双面板。
        </Splitter>
      // 结束分隔器内容。
      </Column>
    // 结束分隔器面板。
    </Container>
    // 展示滚动与吸顶面板。
    <Container class="pagePanel">
      // 组织滚动内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">ScrollView / VirtualScroll / Affix / BackTop</Text>
        // 展示双向绑定滚动偏移的滚动容器。
        <ScrollView direction="vertical" offset={scroll_point} height="120px">
          // 使用纵向容器承载滚动行。
          <Column gap="4px">
            // 展示第一滚动行。
            <Text>ScrollView 行 1 — 滚轮滚动</Text>
            // 展示第二滚动行。
            <Text>ScrollView 行 2</Text>
            // 展示第三滚动行。
            <Text>ScrollView 行 3</Text>
            // 展示第四滚动行。
            <Text>ScrollView 行 4</Text>
            // 展示第五滚动行。
            <Text>ScrollView 行 5</Text>
            // 展示第六滚动行。
            <Text>ScrollView 行 6</Text>
          // 结束滚动行。
          </Column>
        // 结束滚动容器。
        </ScrollView>
        // 展示惰性行虚拟滚动。
        <VirtualScroll data={virtual_items} rowHeight="32px" item={item} height="160px">
          // 用 For 模板描述单行结构。
          <For {item} {index} in {virtual_items} key={item.id}>
            // 展示带稳定 key 的行容器。
            <Container direction="row" gap="8px" padding="4px">
              // 展示行索引。
              <Text>{index}</Text>
              // 展示行内容。
              <Text>{item.name}</Text>
            // 结束行容器。
            </Container>
          // 结束行模板。
          </For>
        // 结束虚拟滚动。
        </VirtualScroll>
        // 排列吸顶与回到顶部演示。
        <Container direction="row" gap="24px" align="center" height="48px">
          // 展示读取组件私有滚动状态的吸顶容器。
          <Affix offsetTop="12" scrollY={scroll_y}><Button type="primary">已吸顶</Button></Affix>
          // 展示读取组件私有滚动状态的回到顶部按钮。
          <BackTop threshold="100" scrollY={scroll_y} />
          // 说明状态来源。
          <Text fontSize="small">Affix / BackTop 读取组件私有 scroll_y 状态（f32 = 180 模拟已滚动）</Text>
        // 结束吸顶演示行。
        </Container>
      // 结束滚动内容。
      </Column>
    // 结束滚动与吸顶面板。
    </Container>
  // 结束布局组件内容。
  </Column>
// 结束布局组件页组件。
</Component>

// 声明导航组件页组件：持有类型化步骤与分页状态。
<Component name="NavPage" state="steps_current: usize = 1, page_current: usize = 1, page_size: usize = 10">
  // 组织导航组件内容。
  <Column gap="16px">
    // 展示导航组件标题。
    <Text fontSize="heading2">导航组件</Text>
    // 展示步骤与分页面板。
    <Container class="pagePanel">
      // 组织步骤内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Steps / Pagination</Text>
        // 展示水平步骤条。
        <Steps current={steps_current} items={[Step('注册').status('finish'), Step('验证').status('process'), Step('完成').status('wait')]} />
        // 展示垂直步骤条，同一数据绑定被两个标签按值 clone 消费。
        <Steps current={steps_current} items={[Step('注册').status('finish'), Step('验证').status('process'), Step('完成').status('wait')]} direction="vertical" />
        // 通过 setState 更新类型化 usize 步骤状态。
        <Container direction="row" gap="8px">
          // 跳回第一步。
          <Button @click="setState(steps_current: 0)">回到第 1 步</Button>
          // 跳到第三步。
          <Button @click="setState(steps_current: 2)">跳到第 3 步</Button>
        // 结束步骤操作行。
        </Container>
        // 展示双状态分页器。
        <Pagination total="120" current={page_current} pageSize={page_size} @change="on_page_change($event)" />
      // 结束步骤内容。
      </Column>
    // 结束步骤与分页面板。
    </Container>
    // 展示面包屑与锚点面板。
    <Container class="pagePanel">
      // 组织面包屑内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Breadcrumb / Anchor</Text>
        // 展示末项激活面包屑。
        <Breadcrumb items={[BreadcrumbItem('首页'), BreadcrumbItem('组件'), BreadcrumbItem('导航').active()]} />
        // 展示带偏移与 href 事件的锚点导航。
        <Anchor items={[AnchorItem('基础', '#basic'), AnchorItem('高级', '#advanced'), AnchorItem('API', '#api')]} offsetTop="24" @change="on_anchor_change($event)" />
      // 结束面包屑内容。
      </Column>
    // 结束面包屑与锚点面板。
    </Container>
    // 说明规划中标签边界。
    <Alert message="Menu、Navigation、Tabs、Dropdown 标签已在规划矩阵登记，仍保持 Rust API 边界。" type="info" />
  // 结束导航组件内容。
  </Column>
// 结束导航组件页组件。
</Component>

// 声明输入组件页组件：全部双向绑定控件都由组件私有 state 驱动。
<Component name="InputPage" state="input_name: 'UIX Lang', input_number: i32 = 50, grouped_amount: '12.50', slider_volume: 35, range_start: 20, range_end: 80, rating: u32 = 7, gender: 'female', view_mode: 'grid', city: 'cn', tree_key: 'member', query: 'ap', mention_text: '请联系 @a', switch_enabled: false, checkbox_accepted: true, cities: HashSet<String> = [], region: CascaderValue = { labels: [], values: [] }, selected_date: Date = Date(2026, 8, 10), range_start_date: Date = Date(2026, 8, 1), range_end_date: Date = Date(2026, 8, 31), selected_time: Time = Time(14, 30), selected_color: Color = Color('#1677ff'), profile: Profile = { email: 'owner@example.com', level: '中级', accepted: true, channel: '邮件', notifications: true, volume: 35.0 }">
  // 组织输入组件内容。
  <Column gap="16px">
    // 展示输入组件标题。
    <Text fontSize="heading2">输入组件</Text>
    // 展示文本输入面板。
    <Container class="pagePanel">
      // 组织文本输入内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Input / InputNumber / InputGroup</Text>
        // 展示双向绑定文本输入。
        <Input value={input_name} placeholder="请输入文本" type="text" @change="on_name_change($event)" width="320px" />
        // 展示密码输入。
        <Input placeholder="密码输入" type="password" width="320px" />
        // 展示多行输入。
        <Input placeholder="多行输入" type="textarea" width="320px" />
        // 展示带范围与步长的类型化 i32 数字输入。
        <InputNumber value={input_number} min="0" max="100" step="5" precision="0" width="180px" />
        // 展示带前后附加文本的复合输入。
        <InputGroup addonBefore="¥" value={grouped_amount} addonAfter="元" width="200px" />
      // 结束文本输入内容。
      </Column>
    // 结束文本输入面板。
    </Container>
    // 展示滑块评分面板。
    <Container class="pagePanel">
      // 组织滑块内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Slider / RangeSlider / Rate</Text>
        // 展示单值滑块。
        <Slider value={slider_volume} min="0" max="100" step="5" width="320px" />
        // 展示双状态区间滑块。
        <RangeSlider value={{ start: range_start, end: range_end }} min="0" max="100" step="5" width="320px" />
        // 展示允许半星的类型化 u32 评分控件。
        <Rate value={rating} count="5" allowHalf />
      // 结束滑块内容。
      </Column>
    // 结束滑块评分面板。
    </Container>
    // 展示勾选输入面板。
    <Container class="pagePanel">
      // 组织勾选内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Checkbox / Switch / Radio / Segmented</Text>
        // 排列勾选控件。
        <Container direction="row" gap="12px" align="center">
          // 展示双向勾选复选框。
          <Checkbox checked={checkbox_accepted} text="同意演示协议" />
          // 展示普通复选框。
          <Checkbox text="选项 B" />
          // 展示禁用复选框。
          <Checkbox text="禁用" disabled />
          // 展示双向开关。
          <Switch checked={switch_enabled} />
          // 通过 setState 切换组件私有开关状态。
          <Button @click="setState(switch_enabled: !switch_enabled)">切换开关</Button>
        // 结束勾选控件行。
        </Container>
        // 展示双向单选组。
        <Radio value={gender} options={['female', 'male']} width="320px" />
        // 展示双向分段控制器。
        <Segmented value={view_mode} options={['grid', 'list']} width="240px" />
      // 结束勾选内容。
      </Column>
    // 结束勾选输入面板。
    </Container>
    // 展示选择器面板。
    <Container class="pagePanel">
      // 组织选择器内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Select / Cascader / TreeSelect / AutoComplete / Mentions</Text>
        // 排列单选与多选下拉，共享同一结构化选项绑定。
        <Container direction="row" gap="12px" align="center">
          // 展示可搜索单选下拉。
          <Select value={city} options={[SelectOption('中国', 'cn'), SelectOption('美国', 'us'), SelectOption('日本', 'jp')]} searchable placeholder="请选择城市" width="200px" />
          // 展示集合状态多选下拉。
          <Select value={cities} options={[SelectOption('中国', 'cn'), SelectOption('美国', 'us'), SelectOption('日本', 'jp')]} multiple width="200px" />
        // 结束下拉行。
        </Container>
        // 展示级联选择器。
        <Cascader value={region} options={[CascaderOption('浙江', 'zj').children([CascaderOption('杭州', 'hz'), CascaderOption('宁波', 'nb')]), CascaderOption('江苏', 'js').children([CascaderOption('南京', 'nj')])]} width="240px" />
        // 展示树形选择器，与展示树共享同一节点绑定。
        <TreeSelect value={tree_key} options={[TreeNode('部门', 'dept').children([TreeNode('成员', 'member'), TreeNode('访客', 'guest')]), TreeNode('项目', 'project')]} width="240px" />
        // 展示自动完成输入。
        <AutoComplete value={query} options={['apple', 'apricot', 'application']} placeholder="输入城市..." width="240px" />
        // 展示提及输入。
        <Mentions value={mention_text} suggestions={['alice', 'adam']} placeholder="输入 @ 提及" width="240px" />
      // 结束选择器内容。
      </Column>
    // 结束选择器面板。
    </Container>
    // 展示日期时间面板。
    <Container class="pagePanel">
      // 组织日期内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">DatePicker / DateRangePicker / TimePicker / ColorPicker</Text>
        // 排列日期时间控件。
        <Container direction="row" gap="12px" align="center">
          // 展示周粒度日期选择。
          <DatePicker value={selected_date} mode="week" width="200px" />
          // 展示双状态日期范围选择。
          <DateRangePicker value={{ start: range_start_date, end: range_end_date }} width="260px" />
          // 展示时间选择。
          <TimePicker value={selected_time} width="160px" />
          // 展示颜色选择。
          <ColorPicker value={selected_color} width="160px" />
        // 结束日期时间行。
        </Container>
      // 结束日期内容。
      </Column>
    // 结束日期时间面板。
    </Container>
    // 展示表单面板。
    <Container class="pagePanel">
      // 组织表单内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Form / FormItem — 类型化模型</Text>
        // 展示绑定类型化模型的全字段表单。
        <Form model={profile} @submit="submit_profile" width="480px">
          // 展示必填邮箱字段。
          <FormInputItem field="email" label="邮箱" rules="required,email" />
          // 展示可搜索等级选择字段。
          <FormSelectItem field="level" label="等级" options={['初级', '中级', '高级']} rules="required" searchable placeholder="请选择" />
          // 展示协议确认字段。
          <FormCheckboxItem field="accepted" label="协议确认" text="我已阅读并同意" rules="required" />
          // 展示通知渠道单选字段。
          <FormRadioItem field="channel" label="通知渠道" options={['邮件', '短信']} rules="required" vertical />
          // 展示通知开关字段。
          <FormSwitchItem field="notifications" label="启用通知" rules="required" />
          // 展示音量滑块字段。
          <FormSliderItem field="volume" label="音量" min="0" max="100" step="5" />
          // 展示表单提交按钮。
          <Button type="primary" @click="submitForm">提交</Button>
        // 结束类型化表单。
        </Form>
      // 结束表单内容。
      </Column>
    // 结束表单面板。
    </Container>
  // 结束输入组件内容。
  </Column>
// 结束输入组件页组件。
</Component>

// 声明数据展示页组件。
<Component name="DataPage">
  // 组织数据展示内容。
  <Column gap="16px">
    // 展示数据组件标题。
    <Text fontSize="heading2">数据展示</Text>
    // 展示卡片列表面板。
    <Container class="pagePanel">
      // 组织卡片列表内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Card / List / Descriptions</Text>
        // 展示带操作项的卡片。
        <Card title="卡片" actions={['编辑', '删除']} width="320px">
          // 说明卡片承载能力。
          <Text>Card 可承载异质有序子树。</Text>
        // 结束操作卡片。
        </Card>
        // 展示带头尾文本的数据列表。
        <List data={['视觉基线', '语义断言', '交互回归']} header="用户列表" footer="共 3 人" loadMore="加载更多" width="320px" />
        // 展示三列描述列表。
        <Descriptions data={[DescriptionsItem('姓名', 'Ada'), DescriptionsItem('角色', '管理员'), DescriptionsItem('邮箱', 'ada@ex.com')]} columns="2" width="480px" />
      // 结束卡片列表内容。
      </Column>
    // 结束卡片列表面板。
    </Container>
    // 展示时间轴面板。
    <Container class="pagePanel">
      // 组织时间轴内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Timeline / Tree / Carousel</Text>
        // 展示带 pending 与 reverse 的时间轴。
        <Timeline items={[TimelineItem('创建').description('2026-08-01'), TimelineItem('设计').description('2026-08-05'), TimelineItem('上线').description('2026-08-10')]} pending reverse />
        // 展示可勾选默认展开的树。
        <Tree data={[TreeNode('部门', 'dept').children([TreeNode('成员', 'member'), TreeNode('访客', 'guest')]), TreeNode('项目', 'project')]} checkable defaultExpandAll width="320px" />
        // 展示自动播放轮播器。
        <Carousel autoplay height="120px" width="320px">
          // 展示第一张幻灯片。
          <Container backgroundColor="#E6F4FF" align="center" justify="center"><Text>幻灯片 1</Text></Container>
          // 展示第二张幻灯片。
          <Container backgroundColor="#FFF7E6" align="center" justify="center"><Text>幻灯片 2</Text></Container>
          // 展示第三张幻灯片。
          <Container backgroundColor="#F6FFED" align="center" justify="center"><Text>幻灯片 3</Text></Container>
        // 结束轮播器。
        </Carousel>
      // 结束时间轴内容。
      </Column>
    // 结束时间轴面板。
    </Container>
    // 展示媒体面板。
    <Container class="pagePanel">
      // 组织媒体内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Avatar / Image / ImageGroup</Text>
        // 排列媒体组件。
        <Container direction="row" gap="12px" align="center">
          // 展示文字头像。
          <Avatar text="U" />
          // 展示圆形彩色头像。
          <Avatar text="A" shape="circle" size="48px" backgroundColor="#4096FF" />
          // 展示带预览与回退文字的图片。
          <Image src="assets/images/demo.png" alt="demo" fallback="图片加载失败" width="120px" height="84px" radius="8px" preview />
          // 展示带变化事件的图片组。
          <ImageGroup images={['assets/images/demo.png', 'assets/images/demo.png']} startIndex="0" @change="on_gallery_change($event)" width="280px" />
        // 结束媒体组件行。
        </Container>
      // 结束媒体内容。
      </Column>
    // 结束媒体面板。
    </Container>
    // 展示状态组件面板。
    <Container class="pagePanel">
      // 组织状态组件内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Skeleton / Empty / ResultView / Calendar / RichText</Text>
        // 排列骨架屏形状。
        <Container direction="row" gap="12px" align="center">
          // 展示矩形骨架。
          <Skeleton shape="rect" width="240px" height="16px" />
          // 展示圆形骨架。
          <Skeleton shape="circle" width="48px" height="48px" />
          // 展示文本骨架。
          <Skeleton shape="text" width="120px" height="16px" />
        // 结束骨架屏行。
        </Container>
        // 展示空状态。
        <Empty description="暂无数据" icon="inbox" width="240px" />
        // 排列结果状态。
        <Container direction="row" gap="16px">
          // 展示成功结果。
          <ResultView status="success" title="数据加载完成" extraText="重新加载" width="200px" />
          // 展示失败结果。
          <ResultView status="error" title="加载失败" width="200px" />
        // 结束结果状态行。
        </Container>
        // 展示月视图日历。
        <Calendar width="300px" />
        // 展示可选中 Markdown 富文本。
        <RichText content="**RichText** 与 `QRCode` 均由已注册标签生成。" selectable width="320px" />
      // 结束状态组件内容。
      </Column>
    // 结束状态组件面板。
    </Container>
    // 说明未登记标签边界。
    <Alert message="Table、SelectableList、Collapse、Badge 标签尚未注册，保留 Rust API 边界。" type="info" />
  // 结束数据展示内容。
  </Column>
// 结束数据展示页组件。
</Component>

// 声明反馈组件页组件：受控浮层由组件私有 state 与 setState 驱动。
<Component name="FeedbackPage" state="feedback_open: false, drawer_open: false">
  // 组织反馈组件内容。
  <Column gap="16px">
    // 展示反馈组件标题。
    <Text fontSize="heading2">反馈组件</Text>
    // 展示警告提示面板。
    <Container class="pagePanel">
      // 组织警告内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Alert — 4 种类型</Text>
        // 展示成功提示。
        <Alert message="成功: 操作已完成" type="success" />
        // 展示信息提示。
        <Alert message="信息: 提示" type="info" />
        // 展示可关闭警告。
        <Alert message="警告: 请注意" type="warning" closable />
        // 展示带关闭事件的错误提示。
        <Alert message="错误: 失败" type="error" closable @close="on_alert_closed($event)" />
      // 结束警告内容。
      </Column>
    // 结束警告提示面板。
    </Container>
    // 展示浮层面板。
    <Container class="pagePanel">
      // 组织浮层内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Modal / Drawer（组件私有受控状态）</Text>
        // 排列浮层入口。
        <Container direction="row" gap="12px" align="center">
          // 通过 setState 打开反馈模态。
          <Button type="primary" @click="setState(feedback_open: true)">打开 Modal</Button>
          // 通过 setState 打开抽屉。
          <Button @click="setState(drawer_open: true)">打开 Drawer</Button>
        // 结束浮层入口行。
        </Container>
        // 展示由私有 State<bool> 控制的模态框。
        <Modal open={feedback_open} title="系统键盘焦点陷阱" maskClosable footerVisible @ok="setState(feedback_open: false)" @cancel="setState(feedback_open: false)" width="480px">
          // 排列模态操作按钮。
          <Container direction="row" gap="8px">
            // 展示模态取消按钮。
            <Button @click="setState(feedback_open: false)">取消</Button>
            // 展示模态确认按钮。
            <Button type="primary" @click="setState(feedback_open: false)">确认</Button>
          // 结束模态操作行。
        // 结束受控模态框。
        </Container>
        </Modal>
        // 展示右侧受控抽屉。
        <Drawer open={drawer_open} placement="right" width="300px">
          // 组织抽屉内容。
          <Column gap="12px">
            // 说明抽屉内容来源。
            <Text>抽屉内容来自 uix-lang 声明。</Text>
            // 展示关闭抽屉按钮。
            <Button @click="setState(drawer_open: false)">关闭抽屉</Button>
          // 结束抽屉内容。
          </Column>
        // 结束受控抽屉。
        </Drawer>
      // 结束浮层内容。
      </Column>
    // 结束浮层面板。
    </Container>
    // 展示悬浮交互面板。
    <Container class="pagePanel">
      // 组织悬浮内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Tooltip / Popover / FocusTrap</Text>
        // 排列悬浮组件。
        <Container direction="row" gap="12px" align="center">
          // 展示默认悬停文字提示。
          <Tooltip text="来自 uix-lang 的提示"><Button>悬停查看 Tooltip</Button></Tooltip>
          // 展示点击触发气泡卡片。
          <Popover content="气泡内容" trigger="click"><Button>点击查看 Popover</Button></Popover>
        // 结束悬浮组件行。
        </Container>
        // 展示焦点陷阱作用域。
        <FocusTrap>
          // 排列焦点陷阱内按钮。
          <Container direction="row" gap="8px">
            // 展示焦点陷阱取消按钮。
            <Button>取消</Button>
            // 展示焦点陷阱确认按钮。
            <Button type="primary">确认</Button>
          // 结束焦点陷阱按钮行。
          </Container>
        // 结束焦点陷阱作用域。
        </FocusTrap>
      // 结束悬浮内容。
      </Column>
    // 结束悬浮交互面板。
    </Container>
    // 展示加载反馈面板。
    <Container class="pagePanel">
      // 组织加载内容。
      <Column gap="12px">
        // 展示面板小节标题。
        <Text fontSize="heading5">Spin — 遮罩子树</Text>
        // 展示带遮罩子树的加载指示器。
        <Spin spinning text="正在加载" width="320px">
          // 展示被遮罩的卡片。
          <Card title="加载内容"><Text>Spin 遮罩子树。</Text></Card>
        // 结束遮罩子树。
        </Spin>
      // 结束加载内容。
      </Column>
    // 结束加载反馈面板。
    </Container>
    // 说明未登记标签边界。
    <Alert message="Message、Notification、ProgressBar、Popconfirm 标签尚未注册，保留 Rust API 边界。" type="info" />
  // 结束反馈组件内容。
  </Column>
// 结束反馈组件页组件。
</Component>

// 声明图表能力页组件。
<Component name="ChartsPage">
  // 组织图表能力内容。
  <Column gap="16px">
    // 展示图表能力标题。
    <Text fontSize="heading2">图表</Text>
    // 明确当前声明式标签边界。
    <Alert message="charts 能力已与 API Demo 一致启用（Bar / Line / Pie / Area / Radar / Heatmap / Gauge 等），但图表标签尚未注册到 uix-lang。" type="warning" />
    // 说明当前可用调用路径。
    <Card title="当前边界"><Text>图表继续通过 Rust API 构造；待标签契约登记后再迁入声明文件。</Text></Card>
