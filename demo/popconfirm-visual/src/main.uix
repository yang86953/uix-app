// 声明验收页面使用的面板样式。
acceptancePanel {
  // 为内容保留稳定内边距。
  padding: 24px;
  // 使用白色面板背景便于核对阴影与焦点环。
  backgroundColor: #FFFFFF;
  // 使用浅色边框标记页面边界。
  borderWidth: 1px;
  // 使用中性边框颜色。
  borderColor: #D9D9D9;
  // 使用统一圆角。
  borderRadius: 10px;
}

// 声明带可见动作计数的 Popconfirm 验收面板。
<Component name="PopconfirmAcceptance" state="confirm_count: 0, cancel_count: 0">
  // 纵向排列说明、计数与六个位置样例。
  <Column gap="18px">
    // 展示验收标题。
    <Text fontSize="heading2">Popconfirm 真窗视觉验收</Text>
    // 说明真实 trigger 与输入契约。
    <Text>长文本按钮保持自身尺寸与 Click；确认 / 取消分别只计数一次。</Text>
    // 同屏展示当前回调次数。
    <Container direction="row" gap="20px">
      // 展示确认回调次数。
      <Text>确认次数：{confirm_count}</Text>
      // 展示取消回调次数。
      <Text>取消次数：{cancel_count}</Text>
    // 结束计数行。
    </Container>
    // 第一行覆盖顶部三个位置。
    <Container direction="row" gap="28px" align="center">
      // 验证顶部左对齐和长 trigger 不裁剪。
      <Popconfirm title="确认顶部左侧操作？" placement="topLeft" @confirm="setState(confirm_count: confirm_count + 1)" @cancel="setState(cancel_count: cancel_count + 1)">
        // 真实按钮独占绘制、焦点和业务 Click。
        <Button type="danger">很长的自定义删除按钮 · TopLeft</Button>
      // 结束顶部左侧样例。
      </Popconfirm>
      // 验证顶部居中位置。
      <Popconfirm title="确认顶部操作？" placement="top" @confirm="setState(confirm_count: confirm_count + 1)" @cancel="setState(cancel_count: cancel_count + 1)">
        // 使用普通按钮验证完整样式保留。
        <Button>自定义按钮 · Top</Button>
      // 结束顶部样例。
      </Popconfirm>
      // 验证顶部右对齐位置。
      <Popconfirm title="确认顶部右侧操作？" placement="topRight" @confirm="setState(confirm_count: confirm_count + 1)" @cancel="setState(cancel_count: cancel_count + 1)">
        // 使用主按钮验证样式与焦点环。
        <Button type="primary">自定义按钮 · TopRight</Button>
      // 结束顶部右侧样例。
      </Popconfirm>
    // 结束顶部位置行。
    </Container>
    // 第二行覆盖底部三个位置与箭头配置。
    <Container direction="row" gap="28px" align="center">
      // 验证底部左对齐位置。
      <Popconfirm title="确认底部左侧操作？" placement="bottomLeft" @confirm="setState(confirm_count: confirm_count + 1)" @cancel="setState(cancel_count: cancel_count + 1)">
        // 使用长文本再次核对自然宽度。
        <Button type="danger">很长的自定义删除按钮 · BottomLeft</Button>
      // 结束底部左侧样例。
      </Popconfirm>
      // 验证底部居中与无图标配置。
      <Popconfirm title="确认底部操作？" placement="bottom" icon="false" @confirm="setState(confirm_count: confirm_count + 1)" @cancel="setState(cancel_count: cancel_count + 1)">
        // 使用普通按钮作为真实 trigger。
        <Button>自定义按钮 · Bottom</Button>
      // 结束底部样例。
      </Popconfirm>
      // 验证底部右对齐与无箭头配置。
      <Popconfirm title="确认底部右侧操作？" placement="bottomRight" arrow="false" @confirm="setState(confirm_count: confirm_count + 1)" @cancel="setState(cancel_count: cancel_count + 1)">
        // 使用主按钮作为真实 trigger。
        <Button type="primary">自定义按钮 · BottomRight</Button>
      // 结束底部右侧样例。
      </Popconfirm>
    // 结束底部位置行。
    </Container>
    // 说明键盘与外部点击验收动作。
    <Text>键盘：Tab 聚焦 trigger，Enter 打开，左右键选择，Enter 执行，Escape 取消；鼠标点击空白处取消。</Text>
  // 结束验收内容。
  </Column>
// 结束验收面板组件。
</Component>

// 声明独立真窗应用入口。
<App title="UIX Popconfirm 视觉验收" size="1080x520" theme="light">
  // 使用固定验收面板承载全部样例。
  <Container class="acceptancePanel">
    // 挂载带动作计数的验收组件。
    <PopconfirmAcceptance />
  // 结束页面面板。
  </Container>
// 结束应用入口。
</App>
