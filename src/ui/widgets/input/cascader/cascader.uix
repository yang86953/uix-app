// Cascader 的尺寸、几何、排版、图标、时序、层级和主题角色由 UIX 唯一拥有。
<Visual
  name="CASCADER_DEFAULTS_VISUAL"
  type="CascaderDefaultsVisual"
  intrinsicWidth={120.0}
/>

<Visual
  name="CASCADER_LAYOUT_VISUAL"
  type="CascaderLayoutVisual"
  triggerHeight={32.0}
  popupGap={2.0}
  popupColumnMinWidth={200.0}
  popupHeight={200.0}
  itemHeight={32.0}
  wheelStep={40.0}
  fallbackPopupSides={2.0}
  triggerHorizontalPadding={12.0}
  triggerArrowGap={4.0}
  trailingSlotWidth={24.0}
  triggerArrowRightInset={4.0}
  caretHeight={18.0}
  caretWidth={1.0}
  itemHorizontalPadding={12.0}
  columnSeparatorWidth={1.0}
  loadingRadius={4.5}
  loadingRadiusRatio={0.25}
  loadingArcPi={1.45}
  loadingStrokeWidth={1.6}
/>

<Visual
  name="CASCADER_TYPOGRAPHY_VISUAL"
  type="CascaderTypographyVisual"
  trigger={cascader_font_fixed(14.0)}
  item={cascader_font_fixed(14.0)}
  empty={cascader_font_base()}
/>

<Visual
  name="CASCADER_MOTION_VISUAL"
  type="CascaderMotionVisual"
  enterDuration={0.15}
  exitDuration={0.1}
  loadingCycle={0.8}
/>

<Visual
  name="CASCADER_ICONS_VISUAL"
  type="CascaderIconsVisual"
  expanded="chevron-up"
  collapsed="chevron-down"
  child="chevron-right"
/>

<Visual
  name="CASCADER_CHROME_VISUAL"
  type="CascaderChromeVisual"
  normalBorderWidth={1.0}
  focusedBorderWidth={2.0}
  popupBorderWidth={1.0}
  overlayZ={900}
  radius={cascader_radius_small()}
/>

<Visual
  name="CASCADER_PALETTE_VISUAL"
  type="CascaderPaletteVisual"
  inputBackground={cascader_input_background()}
  popupBackground={cascader_popup_background()}
  border={cascader_border()}
  primary={cascader_primary()}
  primaryBackground={cascader_primary_background()}
  text={cascader_text()}
  secondaryText={cascader_secondary_text()}
  tertiaryText={cascader_tertiary_text()}
/>

<Visual
  name="CASCADER_VISUAL"
  type="CascaderVisual"
  defaults={CASCADER_DEFAULTS_VISUAL}
  layout={CASCADER_LAYOUT_VISUAL}
  typography={CASCADER_TYPOGRAPHY_VISUAL}
  motion={CASCADER_MOTION_VISUAL}
  icons={CASCADER_ICONS_VISUAL}
  chrome={CASCADER_CHROME_VISUAL}
  palette={CASCADER_PALETTE_VISUAL}
/>

<KernelView value={build_cascader_view(kernel, CASCADER_VISUAL_REF)} />
