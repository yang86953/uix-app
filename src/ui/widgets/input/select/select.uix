// Select 的控件、标签、候选弹层、加载器、图标、层级、排版和主题由 UIX 唯一拥有。
<Visual
  name="SELECT_LAYOUT_VISUAL"
  type="SelectLayoutVisual"
  smallHeight={24.0}
  mediumHeight={32.0}
  largeHeight={40.0}
  naturalMinWidth={120.0}
  intrinsicExtraWidth={40.0}
  rowHeight={28.0}
  maxDropdownHeight={280.0}
  controlLeftPadding={10.0}
  arrowSlotWidth={28.0}
  caretVerticalInset={4.0}
  caretWidth={1.5}
  tagVerticalInset={8.0}
  tagMaxHeight={24.0}
  tagMinRemaining={20.0}
  tagCloseWidth={18.0}
  tagHorizontalPadding={6.0}
  tagGap={4.0}
  rowHorizontalPadding={10.0}
  customMultiLeft={32.0}
  customRightInset={32.0}
  optionRightInset={42.0}
  checkSize={14.0}
  selectedIconSlot={28.0}
  selectedIconWidth={20.0}
  loadingRadius={5.0}
  loadingRadiusRatio={0.25}
/>

<Visual
  name="SELECT_TYPOGRAPHY_VISUAL"
  type="SelectTypographyVisual"
  text={select_font_fixed(13.0)}
  group={select_font_small()}
  tag={select_font_small()}
  arrowIcon={select_font_fixed(12.0)}
  tagCloseIcon={select_font_fixed(10.0)}
  optionCheckIcon={select_font_fixed(10.0)}
  selectedCheckIcon={select_font_fixed(12.0)}
/>

<Visual
  name="SELECT_CHROME_VISUAL"
  type="SelectChromeVisual"
  borderWidth={1.0}
  focusBorderWidth={2.0}
  tagRadius={4.0}
  checkRadius={3.0}
  shadowExpand={8.0}
  loadingStroke={1.8}
  loadingSweepPi={1.45}
  overlayZ={900}
  radius={select_radius_small()}
  shadow={select_shadow_secondary()}
/>

<Visual
  name="SELECT_MOTION_VISUAL"
  type="SelectMotionVisual"
  loadingCycleSeconds={0.8}
/>

<Visual
  name="SELECT_ICONS_VISUAL"
  type="SelectIconsVisual"
  arrowUp="chevron-up"
  arrowDown="chevron-down"
  close="x"
  check="check"
/>

<Visual
  name="SELECT_PALETTE_VISUAL"
  type="SelectPaletteVisual"
  primary={select_primary()}
  primaryBackground={select_primary_background()}
  text={select_text()}
  textSecondary={select_text_secondary()}
  textQuaternary={select_text_quaternary()}
  fillTertiary={select_fill_tertiary()}
  fillQuaternary={select_fill_quaternary()}
  background={select_background()}
  backgroundElevated={select_background_elevated()}
  border={select_border()}
  borderSecondary={select_border_secondary()}
  white={select_white()}
/>

<Visual
  name="SELECT_VISUAL"
  type="SelectVisual"
  layout={SELECT_LAYOUT_VISUAL}
  typography={SELECT_TYPOGRAPHY_VISUAL}
  chrome={SELECT_CHROME_VISUAL}
  motion={SELECT_MOTION_VISUAL}
  icons={SELECT_ICONS_VISUAL}
  palette={SELECT_PALETTE_VISUAL}
/>

<KernelView value={build_select_view(kernel, SELECT_VISUAL_REF)} />
