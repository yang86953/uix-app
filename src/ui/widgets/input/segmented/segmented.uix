// Segmented 的排版、滑块、分隔线、焦点与主题角色由 UIX 唯一拥有。
<Visual
  name="SEGMENTED_VISUAL"
  type="SegmentedVisual"
  baseFontSize={13.0}
  segmentExtraWidth={24.0}
  thumbInset={2.0}
  thumbRadius={3.0}
  dividerInset={6.0}
  dividerWidth={1.0}
  focusStrokeWidth={1.5}
  containerRadius={segmented_small_radius()}
  container={segmented_container()}
  containerDisabled={segmented_container_disabled()}
  selected={segmented_selected()}
  selectedDisabled={segmented_selected_disabled()}
  primary={segmented_primary()}
  primaryHover={segmented_primary_hover()}
  text={segmented_text()}
  textDisabled={segmented_text_disabled()}
  divider={segmented_divider()}
/>

<KernelView value={build_segmented_view(kernel, SEGMENTED_VISUAL_REF)} />
