// DateRangePicker 的触发框、月历、预设页脚、图标、主题和弹层规格由 UIX 唯一拥有。
<Visual
  name="DATE_RANGE_PICKER_TRIGGER_VISUAL"
  type="DateRangePickerTriggerVisual"
  intrinsicWidth={280.0}
  fontSize={14.0}
  horizontalPadding={12.0}
  iconGap={4.0}
  iconSlotWidth={24.0}
  iconRightInset={4.0}
  rangeIconGap={4.0}
  rangeIconWidth={16.0}
  borderWidth={1.0}
  focusBorderWidth={2.0}
/>

<Visual
  name="DATE_RANGE_PICKER_POPUP_VISUAL"
  type="DateRangePickerPopupVisual"
  popupGap={2.0}
  presetGap={2.0}
  presetRowHeight={24.0}
  presetVerticalInset={4.0}
  presetHorizontalInset={8.0}
  presetFontSize={12.0}
  presetBorderWidth={1.0}
/>

<Visual
  name="DATE_RANGE_PICKER_CALENDAR_VISUAL"
  type="CalendarPanelVisual"
  height={250.0}
  minWidth={160.0}
  headerHeight={32.0}
  weekdayHeight={24.0}
  cellHeight={30.0}
  horizontalInset={8.0}
  navigationWidth={32.0}
  titleFontSize={14.0}
  navigationIconSize={12.0}
  weekdayFontSize={10.0}
  dayFontSize={12.0}
  borderWidth={1.0}
/>

<Visual
  name="DATE_RANGE_PICKER_CALENDAR_ICONS_VISUAL"
  type="CalendarPanelIconsVisual"
  previous="chevron-left"
  next="chevron-right"
/>

<Visual
  name="DATE_RANGE_PICKER_CHROME_VISUAL"
  type="DateRangePickerChromeVisual"
  triggerIcon="calendar"
  rangeIcon="arrow-right"
  overlayZ={900}
  triggerRadius={date_range_picker_radius_small()}
  popupRadius={date_range_picker_radius_small()}
/>

<Visual
  name="DATE_RANGE_PICKER_PALETTE_VISUAL"
  type="DateRangePickerPaletteVisual"
  primary={date_range_picker_primary()}
  primaryBackground={date_range_picker_primary_background()}
  border={date_range_picker_border()}
  text={date_range_picker_text()}
  textSecondary={date_range_picker_text_secondary()}
  textTertiary={date_range_picker_text_tertiary()}
  triggerBackground={date_range_picker_trigger_background()}
  popupBackground={date_range_picker_popup_background()}
  hoverFill={date_range_picker_hover_fill()}
/>

<Visual
  name="DATE_RANGE_PICKER_VISUAL"
  type="DateRangePickerVisual"
  trigger={DATE_RANGE_PICKER_TRIGGER_VISUAL}
  popup={DATE_RANGE_PICKER_POPUP_VISUAL}
  calendar={DATE_RANGE_PICKER_CALENDAR_VISUAL}
  calendarIcons={DATE_RANGE_PICKER_CALENDAR_ICONS_VISUAL}
  chrome={DATE_RANGE_PICKER_CHROME_VISUAL}
  palette={DATE_RANGE_PICKER_PALETTE_VISUAL}
/>

<KernelView value={build_date_range_picker_view(kernel, DATE_RANGE_PICKER_VISUAL_REF)} />
