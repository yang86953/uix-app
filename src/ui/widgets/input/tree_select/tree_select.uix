// TreeSelect 的触发器、树行、缩进、弹层、图标、层级和主题由 UIX 唯一拥有。
<Visual name="TREE_SELECT_LAYOUT_VISUAL" type="TreeSelectLayoutVisual"
  intrinsicWidth={200.0} triggerHeight={32.0} rowHeight={28.0}
  maxDropdownHeight={280.0} minDropdownWidth={200.0} fontSize={13.0}
  leftPadding={10.0} arrowSlot={28.0} arrowIconSize={12.0}
  rowHorizontalPadding={10.0} indentWidth={20.0} indentBase={8.0}
  indentRightReserve={34.0} textRightPadding={10.0}
/>
<Visual name="TREE_SELECT_CHROME_VISUAL" type="TreeSelectChromeVisual"
  borderWidth={1.0} focusBorderWidth={2.0} overlayZ={900}
  radius={tree_select_radius_small()}
/>
<Visual name="TREE_SELECT_ICONS_VISUAL" type="TreeSelectIconsVisual"
  arrowUp="chevron-up" arrowDown="chevron-down"
/>
<Visual name="TREE_SELECT_PALETTE_VISUAL" type="TreeSelectPaletteVisual"
  background={tree_select_background()} border={tree_select_border()}
  primary={tree_select_primary()} primaryBackground={tree_select_primary_background()}
  text={tree_select_text()} textSecondary={tree_select_text_secondary()}
  textQuaternary={tree_select_text_quaternary()} fillTertiary={tree_select_fill_tertiary()}
/>
<Visual name="TREE_SELECT_VISUAL" type="TreeSelectVisual"
  layout={TREE_SELECT_LAYOUT_VISUAL} chrome={TREE_SELECT_CHROME_VISUAL}
  icons={TREE_SELECT_ICONS_VISUAL} palette={TREE_SELECT_PALETTE_VISUAL}
/>
<KernelView value={build_tree_select_view(kernel, TREE_SELECT_VISUAL_REF)} />
