// DatePicker 的触发框、月历面板、图标、主题和弹层规格由 UIX 唯一拥有。
<Visual
  name="DATE_PICKER_TRIGGER_VISUAL"
  type="DatePickerTriggerVisual"
  fontSize={14.0}
  horizontalPadding={12.0}
  iconGap={4.0}
  iconSlotWidth={24.0}
  iconRightInset={4.0}
  borderWidth={1.0}
  focusBorderWidth={2.0}
/>

<Visual
  name="DATE_PICKER_LAYOUT_VISUAL"
  type="DatePickerLayoutVisual"
  intrinsicWidth={160.0}
  popupGap={2.0}
/>

<Visual
  name="DATE_PICKER_CALENDAR_VISUAL"
  type="CalendarPanelVisual"
  height={250.0}
  minWidth={160.0}
  headerHeight={32.0}
  weekdayHeight={24.0}
  cellHeight={30.0}
  horizontalInset={8.0}
  navigationWidth={32.0}
  titleFontSize={14.0}
  navigationIconSize={12.0}
  weekdayFontSize={10.0}
  dayFontSize={12.0}
  borderWidth={1.0}
/>

<Visual
  name="DATE_PICKER_CALENDAR_ICONS_VISUAL"
  type="CalendarPanelIconsVisual"
  previous="chevron-left"
  next="chevron-right"
/>

<Visual
  name="DATE_PICKER_CHROME_VISUAL"
  type="DatePickerChromeVisual"
  triggerIcon="calendar"
  overlayZ={900}
  triggerRadius={date_picker_radius_small()}
  popupRadius={date_picker_radius_small()}
/>

<Visual
  name="DATE_PICKER_PALETTE_VISUAL"
  type="DatePickerPaletteVisual"
  primary={date_picker_primary()}
  primaryBackground={date_picker_primary_background()}
  border={date_picker_border()}
  text={date_picker_text()}
  textSecondary={date_picker_text_secondary()}
  textTertiary={date_picker_text_tertiary()}
  triggerBackground={date_picker_trigger_background()}
  popupBackground={date_picker_popup_background()}
  hoverFill={date_picker_hover_fill()}
/>

<Visual
  name="DATE_PICKER_VISUAL"
  type="DatePickerVisual"
  trigger={DATE_PICKER_TRIGGER_VISUAL}
  layout={DATE_PICKER_LAYOUT_VISUAL}
  calendar={DATE_PICKER_CALENDAR_VISUAL}
  calendarIcons={DATE_PICKER_CALENDAR_ICONS_VISUAL}
  chrome={DATE_PICKER_CHROME_VISUAL}
  palette={DATE_PICKER_PALETTE_VISUAL}
/>

<KernelView value={build_date_picker_view(kernel, DATE_PICKER_VISUAL_REF)} />
