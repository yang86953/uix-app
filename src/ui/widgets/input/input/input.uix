// Input 的单行/多行几何、附件槽、编辑标记、图标、状态与主题由 UIX 唯一拥有。
<Visual
  name="INPUT_LAYOUT_VISUAL"
  type="InputLayoutVisual"
  smallHeight={24.0}
  mediumHeight={32.0}
  largeHeight={40.0}
  naturalWidth={80.0}
  textareaMinHeight={48.0}
  textareaIntrinsicVerticalPadding={16.0}
  textareaTopPadding={6.0}
  textareaContentVerticalInset={6.0}
  textareaContentMinWidth={20.0}
  textareaContentMinHeight={20.0}
  horizontalPadding={12.0}
  singlelineTextMinWidth={20.0}
  prefixWidth={20.0}
  suffixWidth={20.0}
  clearWidth={20.0}
  passwordWidth={24.0}
  searchWidth={24.0}
  addonHorizontalPadding={16.0}
  addonTextInset={8.0}
  prefixIconInset={2.0}
  caretWidth={1.5}
  caretVerticalInset={4.0}
  caretMinFontRatio={0.8}
  compositionBottomInsetTextarea={2.0}
  compositionBottomInsetSingleline={3.0}
  compositionMinWidth={1.5}
  compositionUnderlineHeight={1.5}
  scrollRightMargin={10.0}
  scrollEndGuard={1.0}
/>

<Visual
  name="INPUT_TYPOGRAPHY_VISUAL"
  type="InputTypographyVisual"
  fontSize={14.0}
  lineHeight={22.0}
  addonFontSize={13.0}
  statusFontSize={12.0}
  prefixIconSize={12.0}
  passwordIconSize={14.0}
  layoutLineHeightRatio={1.5}
  fallbackLineHeightRatio={1.2}
  accessoryIconSize={input_font_size_small()}
/>

<Visual
  name="INPUT_CHROME_VISUAL"
  type="InputChromeVisual"
  borderWidth={1.0}
  focusBorderWidth={2.0}
  selectionAlpha={64}
  statusMessageHeight={18.0}
  radius={input_radius_small()}
/>

<Visual
  name="INPUT_ICONS_VISUAL"
  type="InputIconsVisual"
  clear="x"
  passwordVisible="eye"
  passwordHidden="eye-off"
  search="search"
/>

<Visual
  name="INPUT_PALETTE_VISUAL"
  type="InputPaletteVisual"
  primary={input_primary()}
  primaryHover={input_primary_hover()}
  border={input_border()}
  text={input_text()}
  textSecondary={input_text_secondary()}
  textTertiary={input_text_tertiary()}
  textQuaternary={input_text_quaternary()}
  fillTertiary={input_fill_tertiary()}
  background={input_background()}
  backgroundElevated={input_background_elevated()}
  success={input_success()}
  warning={input_warning()}
  error={input_error()}
/>

<Visual
  name="INPUT_VISUAL"
  type="InputVisual"
  layout={INPUT_LAYOUT_VISUAL}
  typography={INPUT_TYPOGRAPHY_VISUAL}
  chrome={INPUT_CHROME_VISUAL}
  icons={INPUT_ICONS_VISUAL}
  palette={INPUT_PALETTE_VISUAL}
/>

<KernelView value={build_input_view(kernel, INPUT_VISUAL_REF)} />
