// TimePicker 的触发器、时钟图标、双列面板、排版、描边、层级和主题由 UIX 唯一拥有。
<Visual
  name="TIME_PICKER_LAYOUT_VISUAL"
  type="TimePickerLayoutVisual"
  smallHeight={24.0}
  mediumHeight={32.0}
  largeHeight={40.0}
  naturalWidth={120.0}
  popupGap={2.0}
  popupHeight={200.0}
  popupMinWidth={120.0}
  itemHeight={32.0}
  horizontalPadding={12.0}
  iconGap={4.0}
  iconSlotWidth={24.0}
  iconRightInset={4.0}
  columnRatio={0.5}
/>

<Visual
  name="TIME_PICKER_TYPOGRAPHY_VISUAL"
  type="TimePickerTypographyVisual"
  trigger={time_picker_font_normal()}
  item={time_picker_font_normal()}
  icon={time_picker_font_normal()}
/>

<Visual
  name="TIME_PICKER_CHROME_VISUAL"
  type="TimePickerChromeVisual"
  borderWidth={1.0}
  focusBorderWidth={2.0}
  dividerWidth={1.0}
  overlayZ={900}
  radius={time_picker_radius_small()}
/>

<Visual
  name="TIME_PICKER_ICONS_VISUAL"
  type="TimePickerIconsVisual"
  clock="clock"
/>

<Visual
  name="TIME_PICKER_PALETTE_VISUAL"
  type="TimePickerPaletteVisual"
  primary={time_picker_primary()}
  border={time_picker_border()}
  text={time_picker_text()}
  textSecondary={time_picker_text_secondary()}
  textTertiary={time_picker_text_tertiary()}
  background={time_picker_background()}
  popupBackground={time_picker_popup_background()}
  primaryBackground={time_picker_primary_background()}
/>

<Visual
  name="TIME_PICKER_VISUAL"
  type="TimePickerVisual"
  layout={TIME_PICKER_LAYOUT_VISUAL}
  typography={TIME_PICKER_TYPOGRAPHY_VISUAL}
  chrome={TIME_PICKER_CHROME_VISUAL}
  icons={TIME_PICKER_ICONS_VISUAL}
  palette={TIME_PICKER_PALETTE_VISUAL}
/>

<KernelView value={build_time_picker_view(kernel, TIME_PICKER_VISUAL_REF)} />
