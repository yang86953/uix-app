<Visual
  name="FLOAT_BUTTON_GEOMETRY_VISUAL"
  type="FloatButtonGeometryVisual"
  defaultSize={40.0}
  surfaceInset={24.0}
  descriptionGap={6.0}
  descriptionTrailingPadding={14.0}
  averageCharacterWidth={7.0}
  tooltipHorizontalPadding={20.0}
  tooltipMinWidth={44.0}
  tooltipHeight={28.0}
  tooltipGap={8.0}
  badgeCountSize={20.0}
  badgeDotSize={8.0}
  shadowLeftOutset={10.0}
  shadowTopOutset={10.0}
  shadowWidthExtra={20.0}
  shadowHeightExtra={24.0}
/>

<Visual
  name="FLOAT_BUTTON_PAINT_VISUAL"
  type="FloatButtonPaintVisual"
  radiusFactor={0.5}
  shadowBlur={8.0}
  shadowOffsetX={0.0}
  shadowOffsetY={4.0}
  shadowAlpha={40}
  focusStrokeWidth={2.0}
  iconSize={16.0}
  badgeFontSize={10.0}
  tooltipBorderWidth={1.0}
  badgeOverflowThreshold={99}
  overlayZIndex={900}
/>

<Visual
  name="FLOAT_BUTTON_PALETTE_VISUAL"
  type="FloatButtonPaletteVisual"
  primary={float_button_primary()}
  primaryHover={float_button_primary_hover()}
  primaryActive={float_button_primary_active()}
  foreground={float_button_white()}
  tooltipText={float_button_text_quaternary()}
  shadow={float_button_black()}
  focusBorder={float_button_primary_border()}
  badge={float_button_error()}
  tooltipBackground={float_button_bg_elevated()}
  tooltipBorder={float_button_border_secondary()}
/>

<Visual
  name="FLOAT_BUTTON_VISUAL"
  type="FloatButtonVisual"
  geometry={FLOAT_BUTTON_GEOMETRY_VISUAL}
  paint={FLOAT_BUTTON_PAINT_VISUAL}
  palette={FLOAT_BUTTON_PALETTE_VISUAL}
  descriptionFont={float_button_small_font()}
  tooltipFont={float_button_small_font()}
  tooltipRadius={float_button_small_radius()}
  defaultIcon="plus"
/>

<KernelView value={build_float_button_view(kernel, FLOAT_BUTTON_VISUAL_REF)} />
