<Visual
  name="FLOAT_BUTTON_GROUP_GEOMETRY_VISUAL"
  type="FloatButtonGroupGeometryVisual"
  triggerSize={40.0}
  itemGap={8.0}
  dirtyLeftOutset={10.0}
  dirtyTopOutset={10.0}
  dirtyWidthExtra={20.0}
  dirtyHeightExtra={24.0}
/>

<Visual
  name="FLOAT_BUTTON_GROUP_PAINT_VISUAL"
  type="FloatButtonGroupPaintVisual"
  radiusFactor={0.5}
  shadowBlur={8.0}
  shadowOffsetX={0.0}
  shadowOffsetY={4.0}
  shadowAlpha={40}
  focusStrokeWidth={2.0}
  iconSize={18.0}
  expandedIcon="x"
  collapsedIcon="plus"
/>

<Visual
  name="FLOAT_BUTTON_GROUP_PALETTE_VISUAL"
  type="FloatButtonGroupPaletteVisual"
  primary={float_button_primary()}
  primaryHover={float_button_primary_hover()}
  primaryActive={float_button_primary_active()}
  foreground={float_button_white()}
  shadow={float_button_black()}
  focusBorder={float_button_primary_border()}
/>

<Visual
  name="FLOAT_BUTTON_GROUP_VISUAL"
  type="FloatButtonGroupVisual"
  geometry={FLOAT_BUTTON_GROUP_GEOMETRY_VISUAL}
  paint={FLOAT_BUTTON_GROUP_PAINT_VISUAL}
  palette={FLOAT_BUTTON_GROUP_PALETTE_VISUAL}
/>

<KernelView
  value={build_float_button_group_view(kernel, children, FLOAT_BUTTON_GROUP_VISUAL_REF)}
/>
