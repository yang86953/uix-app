<Visual
  name="LABEL_METRICS_VISUAL"
  type="LabelMetricsVisual"
  defaultFontSize={14.0}
  defaultLineHeightFactor={1.5}
  singleLineHeightFactor={1.5}
  measurementDpi={96.0}
  selectionAlpha={64}
  layoutMaxHeight={0.0}
  wordWrap={false}
  verticalAlign={label_vertical_align_top()}
/>

<Visual
  name="LABEL_PALETTE_VISUAL"
  type="LabelPaletteVisual"
  text={label_text_color()}
  primary={label_primary_color()}
/>

<Visual
  name="LABEL_VISUAL"
  type="LabelVisual"
  metrics={LABEL_METRICS_VISUAL}
  palette={LABEL_PALETTE_VISUAL}
/>

<KernelView value={build_label_view(kernel, LABEL_VISUAL_REF)} />
