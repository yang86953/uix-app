<Visual
  name="BUTTON_STYLE_ROLES_VISUAL"
  type="ButtonStyleRolesVisual"
  default={button_default_style_role()}
  primary={button_primary_style_role()}
  ghost={button_ghost_style_role()}
  danger={button_danger_style_role()}
/>

<Visual
  name="BUTTON_GEOMETRY_VISUAL"
  type="ButtonGeometryVisual"
  fallbackFontSize={14.0}
  minimumWidth={32.0}
  joinedBorderRadius={0.0}
  joinedLeftBorderWidth={0.0}
  iconFontScale={1.2}
  spinnerFontRadiusFactor={0.42}
  spinnerContentRadiusFactor={0.35}
  spinnerSweepPiFactor={1.45}
  spinnerStrokeWidth={1.8}
/>

<Visual
  name="BUTTON_MOTION_VISUAL"
  type="ButtonMotionVisual"
  rippleExpandSecs={0.32}
  rippleFadeSecs={0.2}
  loadingPeriodSecs={0.8}
/>

<Visual
  name="BUTTON_RIPPLE_VISUAL"
  type="ButtonRippleVisual"
  lightAlpha={56}
  darkAlpha={36}
  darkBackgroundAlphaThreshold={200}
/>

<Visual
  name="BUTTON_VISUAL"
  type="ButtonVisual"
  styles={BUTTON_STYLE_ROLES_VISUAL}
  geometry={BUTTON_GEOMETRY_VISUAL}
  motion={BUTTON_MOTION_VISUAL}
  ripple={BUTTON_RIPPLE_VISUAL}
/>

<KernelView value={build_button_view(kernel, BUTTON_VISUAL_REF)} />
