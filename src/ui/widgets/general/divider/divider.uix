// Divider 的标签尺寸、线段几何、固有尺寸与主题色角色由 UIX 唯一拥有。
<Visual
  name="DIVIDER_VISUAL"
  type="DividerVisual"
  textSize={14.0}
  textGlyphWidth={7.5}
  textPadding={8.0}
  edgeOffset={32.0}
  textGap={8.0}
  lineWidth={1.0}
  dashSegment={6.0}
  dashGap={4.0}
  labelledExtent={24.0}
  plainExtent={1.0}
  lineColor={divider_border_secondary()}
  textColor={divider_text_secondary()}
/>

<KernelView value={build_divider_view(kernel, DIVIDER_VISUAL_REF)} />
