<Visual
  name="POPCONFIRM_DEFAULTS_VISUAL"
  type="PopconfirmDefaultsVisual"
  popupWidth={200.0}
  popupHeight={110.0}
  triggerWidth={80.0}
  triggerHeight={28.0}
  placement={popconfirm_placement_top()}
  arrow={true}
  icon={true}
  confirmText="OK"
  cancelText="Cancel"
/>

<Visual
  name="POPCONFIRM_LAYOUT_VISUAL"
  type="PopconfirmLayoutVisual"
  arrowGap={10.0}
  plainGap={4.0}
  fallbackOffsetPopups={2.0}
  fallbackSpanPopups={5.0}
  shadowExpand={12.0}
  contentInset={12.0}
  titleButtonGap={6.0}
  titleTopInset={6.0}
  iconMinPopupWidth={48.0}
  iconWidth={20.0}
  iconTopInset={8.0}
  buttonGap={8.0}
  buttonHeight={26.0}
  buttonBottomInset={10.0}
  arrowSize={6.0}
/>

<Visual
  name="POPCONFIRM_TYPOGRAPHY_VISUAL"
  type="PopconfirmTypographyVisual"
  trigger={popconfirm_font_fixed(13.0)}
  title={popconfirm_font_fixed(13.0)}
  confirm={popconfirm_font_fixed(12.0)}
  cancel={popconfirm_font_small()}
  warningIcon={16.0}
/>

<Visual
  name="POPCONFIRM_MOTION_VISUAL"
  type="PopconfirmMotionVisual"
  enterDuration={0.15}
  exitDuration={0.1}
/>

<Visual
  name="POPCONFIRM_ICONS_VISUAL"
  type="PopconfirmIconsVisual"
  warning="alert-triangle"
/>

<Visual
  name="POPCONFIRM_CHROME_VISUAL"
  type="PopconfirmChromeVisual"
  panelStroke={1.0}
  focusStroke={2.0}
  overlayZ={950}
  radius={popconfirm_radius_small()}
  buttonRadius={4.0}
  shadow={popconfirm_shadow_secondary()}
/>

<Visual
  name="POPCONFIRM_PALETTE_VISUAL"
  type="PopconfirmPaletteVisual"
  popupBackground={popconfirm_bg_elevated()}
  border={popconfirm_border()}
  text={popconfirm_text()}
  primary={popconfirm_primary()}
  primaryHover={popconfirm_primary_hover()}
  primaryActive={popconfirm_primary_active()}
  error={popconfirm_error()}
  warning={popconfirm_warning()}
  fillSecondary={popconfirm_fill_secondary()}
  fillTertiary={popconfirm_fill_tertiary()}
  white={popconfirm_white()}
/>

<Visual
  name="POPCONFIRM_VISUAL"
  type="PopconfirmVisual"
  defaults={POPCONFIRM_DEFAULTS_VISUAL}
  layout={POPCONFIRM_LAYOUT_VISUAL}
  typography={POPCONFIRM_TYPOGRAPHY_VISUAL}
  motion={POPCONFIRM_MOTION_VISUAL}
  icons={POPCONFIRM_ICONS_VISUAL}
  chrome={POPCONFIRM_CHROME_VISUAL}
  palette={POPCONFIRM_PALETTE_VISUAL}
/>

<KernelView value={build_popconfirm_view(kernel, POPCONFIRM_VISUAL_REF)} />
