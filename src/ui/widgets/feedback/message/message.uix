<Visual
  name="MESSAGE_DEFAULTS_VISUAL"
  type="MessageDefaultsVisual"
  placement={message_placement_top()}
  successDurationMs={3000}
  infoDurationMs={3000}
  warningDurationMs={4000}
  errorDurationMs={5000}
/>

<Visual
  name="MESSAGE_LAYOUT_VISUAL"
  type="MessageLayoutVisual"
  maxWidth={380.0}
  itemHeight={40.0}
  itemStride={48.0}
  surfaceInset={12.0}
  shadowMargin={12.0}
  accentVerticalInset={4.0}
  accentWidth={3.0}
  accentRadius={1.5}
  iconInset={7.0}
  iconMaxWidth={24.0}
  iconContentGap={5.0}
  actionInset={4.0}
  closeInset={5.0}
  closeWidth={40.0}
  actionHorizontalPadding={16.0}
  actionMinWidth={40.0}
  actionMaxWidth={112.0}
  controlGap={4.0}
  contentTrailingGap={7.0}
/>

<Visual
  name="MESSAGE_TYPOGRAPHY_VISUAL"
  type="MessageTypographyVisual"
  body={13.0}
  action={12.0}
  statusIcon={14.0}
  closeIcon={13.0}
/>

<Visual
  name="MESSAGE_MOTION_VISUAL"
  type="MessageMotionVisual"
  enterDuration={0.2}
  leaveDuration={0.15}
/>

<Visual
  name="MESSAGE_ICONS_VISUAL"
  type="MessageIconsVisual"
  success="check-circle"
  info="info"
  warning="alert-triangle"
  error="x-circle"
  close="x"
/>

<Visual
  name="MESSAGE_CHROME_VISUAL"
  type="MessageChromeVisual"
  overlayZ={1200}
  radius={message_radius_large()}
  controlRadius={message_radius_small()}
  shadow={message_shadow_primary()}
/>

<Visual
  name="MESSAGE_PALETTE_VISUAL"
  type="MessagePaletteVisual"
  background={message_bg_elevated()}
  text={message_text()}
  success={message_success()}
  info={message_info()}
  warning={message_warning()}
  error={message_error()}
  fillSecondary={message_fill_secondary()}
  fillTertiary={message_fill_tertiary()}
  textQuaternary={message_text_quaternary()}
/>

<Visual
  name="MESSAGE_VISUAL"
  type="MessageVisual"
  defaults={MESSAGE_DEFAULTS_VISUAL}
  layout={MESSAGE_LAYOUT_VISUAL}
  typography={MESSAGE_TYPOGRAPHY_VISUAL}
  motion={MESSAGE_MOTION_VISUAL}
  icons={MESSAGE_ICONS_VISUAL}
  chrome={MESSAGE_CHROME_VISUAL}
  palette={MESSAGE_PALETTE_VISUAL}
/>

<KernelView value={build_message_view(kernel, MESSAGE_VISUAL_REF)} />
