<Visual
  name="NOTIFICATION_DEFAULTS_VISUAL"
  type="NotificationDefaultsVisual"
  placement={notification_placement_top_right()}
  durationMs={4500}
/>

<Visual
  name="NOTIFICATION_LAYOUT_VISUAL"
  type="NotificationLayoutVisual"
  maxWidth={384.0}
  horizontalInset={24.0}
  verticalInset={12.0}
  itemGap={12.0}
  shadowMargin={12.0}
  compactHeight={48.0}
  detailedHeight={66.0}
  accentVerticalInset={6.0}
  accentWidth={3.0}
  accentRadius={1.5}
  iconInset={10.0}
  iconMaxWidth={24.0}
  iconContentGap={8.0}
  titleTopInset={4.0}
  titleHeight={30.0}
  actionInset={4.0}
  closeInset={6.0}
  closeDefaultWidth={40.0}
  actionHorizontalPadding={16.0}
  closeHorizontalPadding={16.0}
  actionMinWidth={40.0}
  actionMaxWidth={112.0}
  closeMinWidth={40.0}
  closeMaxWidth={112.0}
  controlGap={4.0}
  contentTrailingGap={8.0}
/>

<Visual
  name="NOTIFICATION_TYPOGRAPHY_VISUAL"
  type="NotificationTypographyVisual"
  title={notification_font_body()}
  description={12.0}
  action={12.0}
  closeLabel={11.0}
  statusIcon={16.0}
  closeIcon={13.0}
/>

<Visual
  name="NOTIFICATION_MOTION_VISUAL"
  type="NotificationMotionVisual"
  enterDuration={0.2}
  leaveDuration={0.15}
/>

<Visual
  name="NOTIFICATION_ICONS_VISUAL"
  type="NotificationIconsVisual"
  success="check-circle"
  info="info"
  warning="alert-triangle"
  error="x-circle"
  close="x"
/>

<Visual
  name="NOTIFICATION_CHROME_VISUAL"
  type="NotificationChromeVisual"
  overlayZ={1210}
  panelStroke={1.0}
  radius={notification_radius_large()}
  controlRadius={notification_radius_small()}
  shadow={notification_shadow_primary()}
/>

<Visual
  name="NOTIFICATION_PALETTE_VISUAL"
  type="NotificationPaletteVisual"
  background={notification_bg_elevated()}
  border={notification_border_secondary()}
  text={notification_text()}
  textSecondary={notification_text_secondary()}
  success={notification_success()}
  info={notification_info()}
  warning={notification_warning()}
  error={notification_error()}
  fillSecondary={notification_fill_secondary()}
  fillTertiary={notification_fill_tertiary()}
  textQuaternary={notification_text_quaternary()}
/>

<Visual
  name="NOTIFICATION_VISUAL"
  type="NotificationVisual"
  defaults={NOTIFICATION_DEFAULTS_VISUAL}
  layout={NOTIFICATION_LAYOUT_VISUAL}
  typography={NOTIFICATION_TYPOGRAPHY_VISUAL}
  motion={NOTIFICATION_MOTION_VISUAL}
  icons={NOTIFICATION_ICONS_VISUAL}
  chrome={NOTIFICATION_CHROME_VISUAL}
  palette={NOTIFICATION_PALETTE_VISUAL}
/>

<KernelView value={build_notification_view(kernel, NOTIFICATION_VISUAL_REF)} />
