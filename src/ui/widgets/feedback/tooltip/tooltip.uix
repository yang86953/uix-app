<Visual
  name="TOOLTIP_DEFAULTS_VISUAL"
  type="TooltipDefaultsVisual"
  width={80.0}
  height={28.0}
  placement={tooltip_placement_top()}
  arrow={true}
/>

<Visual
  name="TOOLTIP_MOTION_VISUAL"
  type="TooltipMotionVisual"
  enterDuration={0.15}
  exitDuration={0.1}
/>

<Visual
  name="TOOLTIP_PALETTE_VISUAL"
  type="TooltipPaletteVisual"
  background={tooltip_black()}
  text={tooltip_white()}
  backgroundAlpha={230}
/>

<Visual
  name="TOOLTIP_VISUAL"
  type="TooltipVisual"
  defaults={TOOLTIP_DEFAULTS_VISUAL}
  bubble={TOOLTIP_BUBBLE_VISUAL}
  motion={TOOLTIP_MOTION_VISUAL}
  overlayZ={1100}
  palette={TOOLTIP_PALETTE_VISUAL}
/>

<KernelView value={build_tooltip_view(kernel, TOOLTIP_VISUAL_REF)} />
