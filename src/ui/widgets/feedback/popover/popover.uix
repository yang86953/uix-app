<Visual
  name="POPOVER_DEFAULTS_VISUAL"
  type="PopoverDefaultsVisual"
  popupWidth={220.0}
  popupHeight={100.0}
  triggerWidth={80.0}
  triggerHeight={28.0}
  placement={popover_placement_top()}
  arrow={true}
/>

<Visual
  name="POPOVER_LAYOUT_VISUAL"
  type="PopoverLayoutVisual"
  arrowGap={10.0}
  plainGap={4.0}
  centerRatio={0.5}
  fallbackOffsetPopups={2.0}
  fallbackSpanPopups={5.0}
  shadowExpand={12.0}
  contentInset={12.0}
  titleHeight={32.0}
  dividerThickness={1.0}
  arrowSize={8.0}
/>

<Visual
  name="POPOVER_CHROME_VISUAL"
  type="PopoverChromeVisual"
  triggerStroke={1.0}
  focusStroke={2.0}
  overlayZ={900}
  defaultTriggerLabel="Popover"
  radius={popover_radius_small()}
  shadow={popover_shadow_secondary()}
/>

<Visual
  name="POPOVER_TYPOGRAPHY_VISUAL"
  type="PopoverTypographyVisual"
  trigger={popover_font_small()}
  title={popover_font_normal()}
  content={popover_font_fixed(12.0)}
/>

<Visual
  name="POPOVER_MOTION_VISUAL"
  type="PopoverMotionVisual"
  enterDuration={0.15}
  exitDuration={0.1}
/>

<Visual
  name="POPOVER_PALETTE_VISUAL"
  type="PopoverPaletteVisual"
  popupBackground={popover_bg_elevated()}
  border={popover_border()}
  text={popover_text()}
  textSecondary={popover_text_secondary()}
  fillSecondary={popover_fill_secondary()}
  fillTertiary={popover_fill_tertiary()}
  primary={popover_primary()}
/>

<Visual
  name="POPOVER_VISUAL"
  type="PopoverVisual"
  defaults={POPOVER_DEFAULTS_VISUAL}
  layout={POPOVER_LAYOUT_VISUAL}
  chrome={POPOVER_CHROME_VISUAL}
  typography={POPOVER_TYPOGRAPHY_VISUAL}
  motion={POPOVER_MOTION_VISUAL}
  palette={POPOVER_PALETTE_VISUAL}
/>

<KernelView value={build_popover_view(kernel, POPOVER_VISUAL_REF)} />
