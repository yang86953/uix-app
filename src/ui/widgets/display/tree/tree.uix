// Tree 的具名分组视觉由 UIX 唯一拥有；Rust 内核负责稳定 key、展开/勾选、搜索、拖拽、输入与虚拟化。
<Visual
  name="TREE_GEOMETRY_VISUAL"
  type="TreeGeometryVisual"
  defaultWidth={200.0}
  defaultHeight={300.0}
  rowHeight={28.0}
  searchHeight={32.0}
  slotWidth={20.0}
  indentWidth={20.0}
  minTitleWidth={24.0}
/>

<Visual
  name="TREE_CHROME_VISUAL"
  type="TreeChromeVisual"
  searchCursorCharWidth={8.0}
  searchCursorBaseWidth={8.0}
  searchHorizontalPadding={8.0}
  searchCursorY={6.0}
  searchCursorWidth={1.0}
  searchCursorHeight={20.0}
  searchStrokeWidth={1.0}
  searchFontSize={13.0}
  searchPlaceholder="搜索"
  dropBeforeRatio={0.33333334}
  dropAfterRatio={0.6666667}
  centerRatio={0.5}
  rowFocusInset={0.5}
  rowFocusStroke={1.0}
  checkedIcon="check-square"
  uncheckedIcon="square"
  checkIconSize={13.0}
  checkIconHeightRatio={0.65}
  expandedIcon="chevron-down"
  collapsedIcon="chevron-right"
  branchIconSize={12.0}
  branchIconHeightRatio={0.6}
  nodeIconSize={12.0}
  nodeIconHeightRatio={0.6}
  titleFontSize={13.0}
  titleHeightRatio={0.65}
  focusInset={0.75}
  focusStroke={1.5}
/>

<Visual
  name="TREE_PALETTE_VISUAL"
  type="TreePaletteVisual"
  primary={tree_primary_color()}
  text={tree_text_color()}
  textSecondary={tree_secondary_text_color()}
  selectedFill={tree_selected_fill_color()}
  hoverFill={tree_hover_fill_color()}
  pressedFill={tree_pressed_fill_color()}
  searchBackground={tree_search_background_color()}
  searchBorder={tree_search_border_color()}
/>

<Visual
  name="TREE_VISUAL"
  type="TreeVisual"
  geometry={TREE_GEOMETRY_VISUAL}
  chrome={TREE_CHROME_VISUAL}
  palette={TREE_PALETTE_VISUAL}
/>

<KernelView value={build_tree_view(kernel, TREE_VISUAL_REF)} />
