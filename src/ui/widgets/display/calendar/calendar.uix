// Calendar 的具名分组视觉由 UIX 唯一拥有；Rust 内核负责日期状态、动态日期格、输入、语义事件与绘制算法。
<Visual
  name="CALENDAR_GEOMETRY_VISUAL"
  type="CalendarGeometryVisual"
  defaultCellSize={40.0}
  minCellSize={20.0}
  headerHeight={40.0}
  titleHeight={24.0}
  weekdayHeight={16.0}
  gridColumns={7}
  gridRows={6}
  maxScale={1.0}
  centerRatio={0.5}
  navigationWidthRatio={0.33333334}
/>

<Visual
  name="CALENDAR_CHROME_VISUAL"
  type="CalendarChromeVisual"
  controlStrokeMin={0.5}
  titleSideGap={8.0}
  titleFontSize={15.0}
  titleHeightRatio={0.8}
  previousIcon="chevron-left"
  nextIcon="chevron-right"
  navigationIconSize={12.0}
  weekdayFontSize={11.0}
  weekdayWidthRatio={0.82}
  weekdayHeightRatio={0.8}
  dayRadius={4.0}
  focusInsetMin={0.5}
  focusStrokeWidth={1.5}
  dayFontSize={13.0}
  dayWidthRatio={0.8}
  dayHeightRatio={0.8}
  gridStrokeWidth={0.5}
  customCellStrokeWidth={0.75}
  eventMarkerLimit={calendar_event_marker_limit(3)}
  eventMarkerGap={4.0}
  eventMarkerBottom={4.0}
  eventMarkerRadius={1.5}
  eventOverflowInset={2.0}
  eventOverflowFontSize={8.0}
/>

<Visual
  name="CALENDAR_PALETTE_VISUAL"
  type="CalendarPaletteVisual"
  primary={calendar_primary_color()}
  text={calendar_text_color()}
  textSecondary={calendar_secondary_text_color()}
  textQuaternary={calendar_quaternary_text_color()}
  border={calendar_border_color()}
  background={calendar_background_color()}
  white={calendar_white_color()}
  error={calendar_error_color()}
  controlRadius={calendar_small_radius()}
/>

<Visual
  name="CALENDAR_VISUAL"
  type="CalendarVisual"
  geometry={CALENDAR_GEOMETRY_VISUAL}
  chrome={CALENDAR_CHROME_VISUAL}
  palette={CALENDAR_PALETTE_VISUAL}
/>

<KernelView value={build_calendar_view(kernel, CALENDAR_VISUAL_REF)} />
