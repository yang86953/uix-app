// Tag 的具名布局、预设色表与根视觉由 UIX 唯一拥有；Rust 内核负责状态与绘制。
<Visual
  name="TAG_LAYOUT_VISUAL"
  type="TagLayoutVisual"
  defaultFontSize={12.0}
  horizontalPadding={8.0}
  verticalPadding={4.0}
  compactPaddingRatio={0.25}
  closeWidth={20.0}
  checkWidth={14.0}
  cornerRadiusLimit={0.5}
  checkedInset={0.75}
  checkedStrokeWidth={1.5}
  focusInset={1.0}
  focusStrokeWidth={2.0}
  checkIconSize={10.0}
  leadingIconScale={0.85}
  leadingIconReserveScale={1.0}
  iconGap={4.0}
  closeIconSize={10.0}
  lightHoverAlpha={14}
  lightPressedAlpha={28}
  darkHoverAlpha={16}
  darkPressedAlpha={32}
/>

<Visual
  name="TAG_PALETTE_VISUAL"
  type="TagPaletteVisual"
  pairs={[
    tag_token_pair(tag_fill_tertiary(), tag_text()),
    tag_token_pair(tag_success_bg(), tag_success()),
    tag_token_pair(tag_info_bg(), tag_info()),
    tag_token_pair(tag_warning_bg(), tag_warning()),
    tag_token_pair(tag_error_bg(), tag_error()),
    tag_token_pair(tag_primary_bg(), tag_primary()),
    tag_hue_pair(tag_cyan_hue()),
    tag_hue_pair(tag_geekblue_hue()),
    tag_hue_pair(tag_purple_hue()),
    tag_hue_pair(tag_magenta_hue()),
    tag_hue_pair(tag_red_hue()),
    tag_hue_pair(tag_orange_hue()),
    tag_token_pair(tag_warning_bg(), tag_warning()),
    tag_hue_pair(tag_lime_hue()),
    tag_token_pair(tag_success_bg(), tag_success())
  ]}
/>

<Visual
  name="TAG_VISUAL"
  type="TagVisual"
  layout={TAG_LAYOUT_VISUAL}
  palette={TAG_PALETTE_VISUAL}
  customLightText={tag_black()}
  customDarkText={tag_white()}
  lightOverlay={tag_black()}
  darkOverlay={tag_white()}
  focusColor={tag_primary()}
  cornerRadius={tag_radius_sm()}
  checkIcon="check"
  closeIcon="x"
/>

<KernelView value={build_tag_view(kernel, TAG_VISUAL_REF)} />
