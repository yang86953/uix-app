// Watermark 的分组视觉记录由 UIX 唯一拥有；Rust 内核负责作者状态、平铺算法与底层绘制。
<Visual
  name="WATERMARK_TILING_VISUAL"
  type="WatermarkTilingVisual"
  defaultOpacity={0.15}
  defaultRotate={-22.0}
  defaultGapX={200.0}
  defaultGapY={160.0}
  defaultOffsetX={0.0}
  defaultOffsetY={0.0}
  overscanTiles={2}
/>

<Visual
  name="WATERMARK_TYPOGRAPHY_VISUAL"
  type="WatermarkTypographyVisual"
  font={watermark_body_font()}
  lineHeightRatio={1.4}
/>

<Visual
  name="WATERMARK_VISUAL"
  type="WatermarkVisual"
  tiling={WATERMARK_TILING_VISUAL}
  typography={WATERMARK_TYPOGRAPHY_VISUAL}
  textColor={watermark_text_color()}
/>

<KernelView value={build_watermark_view(kernel, WATERMARK_VISUAL_REF)} />
