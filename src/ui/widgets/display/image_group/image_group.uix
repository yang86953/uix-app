// ImageGroup 的具名分组视觉由 UIX 唯一拥有；Rust 内核负责资源、索引、事件与绘制算法。
<Visual
  name="IMAGE_GROUP_DEFAULTS_VISUAL"
  type="ImageGroupDefaultsVisual"
  width={320.0}
  height={220.0}
/>

<Visual
  name="IMAGE_GROUP_GALLERY_VISUAL"
  type="ImageGroupGalleryVisual"
  stripHeight={56.0}
  stripMinHeight={72.0}
  stripMinWidth={24.0}
  stripMaxRatio={0.4}
  navigationWidth={36.0}
  navigationWidthRatio={0.33333334}
  navigationMinWidth={4.0}
  borderWidth={1.0}
  focusInset={1.0}
  focusStrokeWidth={2.0}
/>

<Visual
  name="IMAGE_GROUP_PREVIEW_VISUAL"
  type="ImageGroupPreviewVisual"
  stripHeight={72.0}
  stripMinHeight={120.0}
  stripMinWidth={32.0}
  stripMaxRatio={0.25}
  marginRatio={0.06}
  marginMin={4.0}
  marginMax={40.0}
  navigationWidth={48.0}
  navigationWidthRatio={0.33333334}
  navigationMinWidth={4.0}
  closeSize={40.0}
  closeMargin={12.0}
  availableCenterRatio={0.5}
  panelRadius={4.0}
  counterY={8.0}
  counterHeight={24.0}
  zIndex={1100}
/>

<Visual
  name="IMAGE_GROUP_THUMBNAIL_VISUAL"
  type="ImageGroupThumbnailVisual"
  inlineMaxSize={44.0}
  previewMaxSize={52.0}
  padding={6.0}
  paddingStripRatio={0.2}
  minSize={4.0}
  gap={6.0}
  gapSizeRatio={0.25}
  centerRatio={0.5}
  selectedStrokeWidth={2.0}
  normalStrokeWidth={1.0}
/>

<Visual
  name="IMAGE_GROUP_CONTROLS_VISUAL"
  type="ImageGroupControlsVisual"
  navigationDiameter={30.0}
  navigationIconSize={16.0}
  navigationIconRatio={0.6}
  closeIconSize={20.0}
  closeIconRatio={0.6}
  emptyIconSize={16.0}
  emptyIconRatio={0.5}
  previousIcon="chevron-left"
  nextIcon="chevron-right"
  closeIcon="x"
  imageIcon="image"
  loadingLabel="图片加载中…"
  emptyLabel="暂无图片"
  unavailableLabel="图片不可用"
/>

<Visual
  name="IMAGE_GROUP_PALETTE_VISUAL"
  type="ImageGroupPaletteVisual"
  background={image_group_container_color()}
  textSecondary={image_group_secondary_text_color()}
  primary={image_group_primary_color()}
  fill={image_group_fill_color()}
  overlay={image_overlay_visual(
    image_group_mask_color(),
    image_group_overlay_color(),
    image_group_text_color(),
    image_group_border_color(),
    0.5
  )}
  frameRadius={image_group_body_radius()}
  thumbnailRadius={image_group_small_radius()}
/>

<Visual
  name="IMAGE_GROUP_VISUAL"
  type="ImageGroupVisual"
  defaults={IMAGE_GROUP_DEFAULTS_VISUAL}
  gallery={IMAGE_GROUP_GALLERY_VISUAL}
  preview={IMAGE_GROUP_PREVIEW_VISUAL}
  thumbnail={IMAGE_GROUP_THUMBNAIL_VISUAL}
  controls={IMAGE_GROUP_CONTROLS_VISUAL}
  palette={IMAGE_GROUP_PALETTE_VISUAL}
/>

<KernelView value={build_image_group_view(kernel, IMAGE_GROUP_VISUAL_REF)} />
