// Collapse 的具名分组视觉由 UIX 唯一拥有；Rust 内核负责稳定 key、展开状态、动态内容、输入与动画生命周期。
<Visual
  name="COLLAPSE_GEOMETRY_VISUAL"
  type="CollapseGeometryVisual"
  defaultWidth={240.0}
  maxIntrinsicWidth={320.0}
  headerHeight={36.0}
  headerIconSlot={28.0}
  headerRightPadding={12.0}
  contentHorizontalPadding={16.0}
  contentVerticalPadding={8.0}
/>

<Visual
  name="COLLAPSE_TYPOGRAPHY_VISUAL"
  type="CollapseTypographyVisual"
  headerFontSize={14.0}
  contentFontSize={12.0}
  contentLineHeightRatio={1.5}
/>

<Visual
  name="COLLAPSE_HEADER_VISUAL"
  type="CollapseHeaderVisual"
  iconX={4.0}
  iconWidth={24.0}
  iconSize={12.0}
  iconHeightRatio={0.6}
  expandedIcon="chevron-down"
  collapsedIcon="chevron-right"
  focusInset={0.75}
  focusStrokeWidth={1.5}
  borderWidth={1.0}
  separatorWidth={1.0}
  centerRatio={0.5}
/>

<Visual
  name="COLLAPSE_PALETTE_VISUAL"
  type="CollapsePaletteVisual"
  headerBackground={collapse_header_background()}
  bodyBackground={collapse_body_background()}
  border={collapse_border_color()}
  text={collapse_text_color()}
  textSecondary={collapse_secondary_text_color()}
  primary={collapse_primary_color()}
  hoverBackground={collapse_hover_background()}
  pressedBackground={collapse_pressed_background()}
  radius={collapse_small_radius()}
/>

<Visual
  name="COLLAPSE_VISUAL"
  type="CollapseVisual"
  geometry={COLLAPSE_GEOMETRY_VISUAL}
  typography={COLLAPSE_TYPOGRAPHY_VISUAL}
  header={COLLAPSE_HEADER_VISUAL}
  palette={COLLAPSE_PALETTE_VISUAL}
  borderlessDefault={false}
/>

<KernelView value={build_collapse_view(kernel, COLLAPSE_VISUAL_REF)} />
