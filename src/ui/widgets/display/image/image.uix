// Image 的具名分组视觉由 UIX 唯一拥有；Rust 内核负责资源、状态、事件与绘制算法。
<Visual
  name="IMAGE_DEFAULTS_VISUAL"
  type="ImageDefaultsVisual"
  radius={6.0}
  preview={true}
  fit={true}
  lazy={false}
/>

<Visual
  name="IMAGE_THUMBNAIL_VISUAL"
  type="ImageThumbnailVisual"
  padding={8.0}
  radiusLimitRatio={0.5}
  borderWidth={1.0}
  iconMaxSize={24.0}
  iconFrameRatio={0.45}
  icon="image"
  errorLabel="加载失败"
  labelFontSize={13.0}
  labelLineHeightRatio={1.5}
  centerRatio={0.5}
/>

<Visual
  name="IMAGE_FOCUS_VISUAL"
  type="ImageFocusVisual"
  inset={1.0}
  strokeWidth={2.0}
/>

<Visual
  name="IMAGE_INDICATOR_VISUAL"
  type="ImageIndicatorVisual"
  minShortest={20.0}
  badgeMaxSize={20.0}
  outerPadding={8.0}
  inset={6.0}
  centerRatio={0.5}
  iconRatio={0.58}
  icon="zoom-in"
/>

<Visual
  name="IMAGE_PREVIEW_VISUAL"
  type="ImagePreviewVisual"
  zIndex={1100}
  marginMax={48.0}
  marginViewportRatio={0.1}
  marginMin={16.0}
  minExtent={1.0}
  missingLabel="图片不可用"
  missingFont={image_large_font()}
  closeRightExtent={52.0}
  closeMinX={4.0}
  closeY={12.0}
  closeSize={40.0}
  centerRatio={0.5}
  closeIcon="x"
  closeIconSize={20.0}
/>

<Visual
  name="IMAGE_PALETTE_VISUAL"
  type="ImagePaletteVisual"
  fill={image_fill_color()}
  textSecondary={image_secondary_text_color()}
  primary={image_primary_color()}
  overlay={image_overlay_visual(
    image_mask_color(),
    image_overlay_color(),
    image_text_color(),
    image_border_color(),
    0.5
  )}
/>

<Visual
  name="IMAGE_VISUAL"
  type="ImageVisual"
  defaults={IMAGE_DEFAULTS_VISUAL}
  thumbnail={IMAGE_THUMBNAIL_VISUAL}
  focus={IMAGE_FOCUS_VISUAL}
  indicator={IMAGE_INDICATOR_VISUAL}
  preview={IMAGE_PREVIEW_VISUAL}
  palette={IMAGE_PALETTE_VISUAL}
/>

<KernelView value={build_image_view(kernel, IMAGE_VISUAL_REF)} />
