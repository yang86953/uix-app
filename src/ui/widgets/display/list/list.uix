// List 的分组视觉记录由 UIX 唯一拥有；Rust 内核负责数据、Empty 策略、真实插槽、测量与布局。
<Visual
  name="LIST_DEFAULTS_VISUAL"
  type="ListDefaultsVisual"
  width={400.0}
  minHeight={100.0}
  bordered={true}
/>

<Visual
  name="LIST_ROWS_VISUAL"
  type="ListRowsVisual"
  smallHeight={32.0}
  mediumHeight={40.0}
  largeHeight={48.0}
  horizontalPadding={16.0}
  horizontalPaddingFrameRatio={0.25}
  headerFooterFontSize={13.0}
  loadMoreHeight={40.0}
  loadMoreFontSize={14.0}
/>

<Visual
  name="LIST_FRAME_VISUAL"
  type="ListFrameVisual"
  radius={list_body_radius()}
  radiusLimitRatio={0.5}
  borderInset={0.5}
  borderWidth={1.0}
  dividerWidth={1.0}
/>

<Visual
  name="LIST_PALETTE_VISUAL"
  type="ListPaletteVisual"
  background={list_background_color()}
  border={list_border_color()}
  text={list_text_color()}
  textSecondary={list_secondary_text_color()}
  primary={list_primary_color()}
  itemFont={list_body_font()}
/>

<Visual
  name="LIST_VISUAL"
  type="ListVisual"
  defaults={LIST_DEFAULTS_VISUAL}
  rows={LIST_ROWS_VISUAL}
  frame={LIST_FRAME_VISUAL}
  palette={LIST_PALETTE_VISUAL}
/>

<KernelView value={build_list_view(kernel, LIST_VISUAL_REF)} />
