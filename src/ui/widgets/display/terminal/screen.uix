// TerminalScreen 的网格几何与色板由 UIX 唯一拥有；Rust 内核负责 PTY 会话投影与按键转发。
<Visual
  name="TERMINAL_SCREEN_GEOMETRY_VISUAL"
  type="TerminalScreenGeometryVisual"
  defaultWidth={640.0}
  defaultHeight={400.0}
  cellWidth={9.0}
  rowHeight={20.0}
  fontSize={13.0}
  paddingX={8.0}
  paddingY={6.0}
  statusHeight={18.0}
/>

// 真实终端屏幕与命令终端共享同一主题色板角色。
<Visual
  name="TERMINAL_SCREEN_PALETTE_VISUAL"
  type="TerminalPaletteVisual"
  background={terminal_background_color()}
  border={terminal_border_color()}
  text={terminal_text_color()}
  muted={terminal_muted_color()}
  prompt={terminal_prompt_color()}
  cursor={terminal_cursor_color()}
  primary={terminal_primary_color()}
  success={terminal_success_color()}
  warning={terminal_warning_color()}
  error={terminal_error_color()}
  info={terminal_info_color()}
/>

<Visual
  name="TERMINAL_SCREEN_VISUAL"
  type="TerminalScreenVisual"
  geometry={TERMINAL_SCREEN_GEOMETRY_VISUAL}
  palette={TERMINAL_SCREEN_PALETTE_VISUAL}
/>

<KernelView value={build_terminal_screen_view(kernel, TERMINAL_SCREEN_VISUAL_REF)} />
