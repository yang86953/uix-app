// NavigationShell 的外壳、标题、版本、折叠按钮、排版和主题由 UIX 唯一拥有。
<Visual name="NAVIGATION_SHELL_LAYOUT_VISUAL" type="NavigationShellLayoutVisual"
  expandedWidth={200.0} collapsedWidth={56.0} height={720.0}
  expandedHeaderHeight={52.0} collapsedHeaderHeight={40.0} versionHeight={24.0}
  toggleSize={32.0} titleStart={12.0} titleEndReserve={48.0}
  versionStart={12.0} versionEndReserve={24.0}
/>
<Visual name="NAVIGATION_SHELL_TYPOGRAPHY_VISUAL" type="NavigationShellTypographyVisual"
  title={18.0} version={11.0} toggleIcon={14.0}
/>
<Visual name="NAVIGATION_SHELL_CHROME_VISUAL" type="NavigationShellChromeVisual"
  focusWidth={1.5}
/>
<Visual name="NAVIGATION_SHELL_ICONS_VISUAL" type="NavigationShellIconsVisual"
  expand="chevron-right" collapse="chevron-left"
/>
<Visual name="NAVIGATION_SHELL_PALETTE_VISUAL" type="NavigationShellPaletteVisual"
  containerBackground={navigation_shell_container_background()}
  text={navigation_shell_text()} textSecondary={navigation_shell_text_secondary()}
  textQuaternary={navigation_shell_text_quaternary()} primary={navigation_shell_primary()}
/>
<Visual name="NAVIGATION_SHELL_VISUAL" type="NavigationShellVisual"
  layout={NAVIGATION_SHELL_LAYOUT_VISUAL}
  typography={NAVIGATION_SHELL_TYPOGRAPHY_VISUAL}
  chrome={NAVIGATION_SHELL_CHROME_VISUAL} icons={NAVIGATION_SHELL_ICONS_VISUAL}
  palette={NAVIGATION_SHELL_PALETTE_VISUAL}
/>
<KernelView value={build_navigation_shell_view(kernel, NAVIGATION_SHELL_VISUAL_REF)} />
