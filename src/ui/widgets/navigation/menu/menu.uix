// Menu 的行、层级、活动指示、紧凑态、图标、排版、焦点和主题由 UIX 唯一拥有。
<Visual name="MENU_LAYOUT_VISUAL" type="MenuLayoutVisual"
  defaultItemHeight={32.0} horizontalMinWidth={100.0}
  expandedWidth={200.0} compactWidth={56.0} glyphWidth={8.0}
  horizontalPadding={32.0} depthIndent={16.0} iconExtraWidth={20.0}
  activeInset={8.0} activeThickness={2.0} iconTextGap={4.0}
  iconSlotWidth={16.0} iconAdvance={20.0}
  plainLabelPadding={16.0} iconLabelPadding={36.0}
  verticalIconStart={12.0} labelEndPadding={8.0}
/>
<Visual name="MENU_TYPOGRAPHY_VISUAL" type="MenuTypographyVisual"
  label={menu_font_base()} compactFallback={menu_font_large()}
  icon={14.0} iconLabel={14.0} compactIcon={16.0}
/>
<Visual name="MENU_CHROME_VISUAL" type="MenuChromeVisual"
  focusWidth={1.5} radius={menu_radius_small()}
/>
<Visual name="MENU_PALETTE_VISUAL" type="MenuPaletteVisual"
  primary={menu_primary()} text={menu_text()}
  textSecondary={menu_text_secondary()} fillTertiary={menu_fill_tertiary()}
/>
<Visual name="MENU_VISUAL" type="MenuVisual"
  layout={MENU_LAYOUT_VISUAL} typography={MENU_TYPOGRAPHY_VISUAL}
  chrome={MENU_CHROME_VISUAL} palette={MENU_PALETTE_VISUAL}
/>
<KernelView value={build_menu_view(kernel, MENU_VISUAL_REF)} />
