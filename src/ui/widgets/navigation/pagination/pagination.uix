// Pagination 的控件、摘要、总数、跳转器、页容量入口、排版和主题由 UIX 唯一拥有。
<Visual name="PAGINATION_LAYOUT_VISUAL" type="PaginationLayoutVisual"
  defaultItemSize={28.0} gap={4.0} extraGap={12.0}
  totalWidth={100.0} sizeChangerWidth={80.0} hitVerticalExtra={8.0}
  simpleWidthFactor={2.5} jumperWidth={84.0} jumperLabelWidth={24.0}
  jumperInputWidth={44.0} jumperSuffixGap={4.0} jumperSuffixWidth={12.0}
  cursorHorizontalPadding={8.0} cursorVerticalInset={5.0} cursorWidth={1.0}
  changerTextStart={6.0}
/>
<Visual name="PAGINATION_TYPOGRAPHY_VISUAL" type="PaginationTypographyVisual"
  small={pagination_font_small()} page={13.0} icon={16.0}
/>
<Visual name="PAGINATION_CHROME_VISUAL" type="PaginationChromeVisual"
  borderWidth={1.0} focusWidth={1.5} radius={pagination_radius_small()}
/>
<Visual name="PAGINATION_DEFAULTS_VISUAL" type="PaginationDefaultsVisual"
  showSizeChanger={false} showTotal={true} simple={false} showJumper={false}
/>
<Visual name="PAGINATION_ICONS_VISUAL" type="PaginationIconsVisual"
  previous="chevron-left" next="chevron-right"
/>
<Visual name="PAGINATION_PALETTE_VISUAL" type="PaginationPaletteVisual"
  primary={pagination_primary()} border={pagination_border()} text={pagination_text()}
  textSecondary={pagination_text_secondary()} white={pagination_white()}
  containerBackground={pagination_container_background()}
/>
<Visual name="PAGINATION_VISUAL" type="PaginationVisual"
  layout={PAGINATION_LAYOUT_VISUAL} typography={PAGINATION_TYPOGRAPHY_VISUAL}
  chrome={PAGINATION_CHROME_VISUAL} defaults={PAGINATION_DEFAULTS_VISUAL}
  icons={PAGINATION_ICONS_VISUAL} palette={PAGINATION_PALETTE_VISUAL}
/>
<KernelView value={build_pagination_view(kernel, PAGINATION_VISUAL_REF)} />
