// Anchor 的行、墨线、标签、容器、描边、排版、圆角和主题由 UIX 唯一拥有。
<Visual name="ANCHOR_LAYOUT_VISUAL" type="AnchorLayoutVisual"
  rowHeight={36.0} indicatorWidth={3.0} labelX={16.0}
  labelCharWidth={14.0} labelHorizontalSpace={32.0} navigationMinWidth={120.0}
  containerWidth={320.0} containerMinHeight={240.0}
/>
<Visual name="ANCHOR_DEFAULTS_VISUAL" type="AnchorDefaultsVisual"
  showInk={true} bounds={10.0}
/>
<Visual name="ANCHOR_CHROME_VISUAL" type="AnchorChromeVisual"
  dividerWidth={1.0} borderWidth={1.0} focusWidth={1.5}
  radius={anchor_radius_small()}
/>
<Visual name="ANCHOR_PALETTE_VISUAL" type="AnchorPaletteVisual"
  primary={anchor_primary()} textSecondary={anchor_text_secondary()}
  borderSecondary={anchor_border_secondary()}
/>
<Visual name="ANCHOR_VISUAL" type="AnchorVisual"
  layout={ANCHOR_LAYOUT_VISUAL} defaults={ANCHOR_DEFAULTS_VISUAL}
  chrome={ANCHOR_CHROME_VISUAL} palette={ANCHOR_PALETTE_VISUAL}
/>
<KernelView value={build_anchor_view(kernel, ANCHOR_VISUAL_REF)} />
