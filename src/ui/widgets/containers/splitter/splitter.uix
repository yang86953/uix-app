// Splitter 的默认面板、尺寸、手柄几何、图标与主题角色由 UIX 唯一拥有。
<Visual
  name="SPLITTER_VISUAL"
  type="SplitterVisual"
  defaultVertical={false}
  defaultPanelCount={2}
  defaultRatio={0.5}
  defaultMinSize={50.0}
  handleSize={6.0}
  intrinsicWidth={300.0}
  intrinsicHeight={200.0}
  flexGrow={1.0}
  keyboardStep={8.0}
  gripExtent={16.0}
  gripIconExtent={14.0}
  gripIconScale={0.85}
  centerRatio={0.5}
  activeStrokeWidth={1.5}
  verticalGripIcon="grip-horizontal"
  horizontalGripIcon="grip-vertical"
  background={splitter_background()}
  handleColor={splitter_handle_color()}
  gripColor={splitter_grip_color()}
  activeColor={splitter_active_color()}
/>

<KernelView value={build_splitter_view(kernel, SPLITTER_VISUAL_REF)} />
